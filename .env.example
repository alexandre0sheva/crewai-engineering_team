# Secrets only. Everything else lives in engineering-team.toml or ENGINEERING_* variables;
# see docs/CONFIGURATION.md. Never commit your real .env.

# Credentials for the provider you use (OPENAI_API_KEY is the default provider).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=            # or GEMINI_API_KEY
# Ollama needs no key; Azure uses your deployment names (see docs/CONFIGURATION.md).

# Web search for the opt-in web tools (--allow-web); the first one set is used.
# SERPER_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Commonly changed settings (all optional; the config file works too):
# ENGINEERING_PROVIDER=openai          # openai | anthropic | google | ollama | azure
# ENGINEERING_RUN_PROFILE=standard     # standard | smoke | max-quality
# ENGINEERING_STRATEGY=pipeline        # pipeline | hierarchical | single
# ENGINEERING_BUDGET_MAX_COST_USD=2    # stop a run that would cost more than this
# ENGINEERING_EXECUTION_BACKEND=local  # local | docker (hardened containers)
# ENGINEERING_PROJECT_NAME=mvp-app
