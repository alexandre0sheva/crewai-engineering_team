# Required for the default OpenAI models.
OPENAI_API_KEY=

# Flagship manager: highest quality and stronger reasoning.
ENGINEERING_LEAD_MODEL=openai/gpt-5.6-sol
ENGINEERING_LEAD_REASONING_EFFORT=high

# Specialists: lower-cost balanced tier.
ENGINEERING_WORKER_MODEL=openai/gpt-5.6-terra
ENGINEERING_WORKER_REASONING_EFFORT=low

# Runtime behavior.
# Leave unset to let PROJECT_REQUEST.md select the bundled smoke profile.
# Set to "standard" for full-quality routing or "smoke" for cheaper test runs.
# ENGINEERING_RUN_PROFILE=standard
ENGINEERING_VERBOSE=true
ENGINEERING_TRACING=false
ENGINEERING_PROJECT_NAME=mvp-app
ENGINEERING_WORKSPACE_ROOT=workspace

# Optional comma-separated MCP documentation servers.
ENGINEERING_DOCS_MCP_URLS=

# Optional iteration caps. Defaults are lead/worker 35/30 for standard and
# 18/14 for smoke.
# ENGINEERING_LEAD_MAX_ITER=35
# ENGINEERING_WORKER_MAX_ITER=30

# Optional smoke-only overrides. Standard model variables above do not override
# smoke defaults, so keeping full-quality production settings is safe.
# ENGINEERING_SMOKE_LEAD_MODEL=openai/gpt-5.6-terra
# ENGINEERING_SMOKE_LEAD_REASONING_EFFORT=low
# ENGINEERING_SMOKE_LEAD_MAX_ITER=18
# ENGINEERING_SMOKE_WORKER_MODEL=openai/gpt-5.6-luna
# ENGINEERING_SMOKE_WORKER_REASONING_EFFORT=none
# ENGINEERING_SMOKE_WORKER_MAX_ITER=14

# Optional comma-separated additions. Keep these lists narrow.
ENGINEERING_COMMAND_ALLOWLIST=
ENGINEERING_SUBPROCESS_ENV_ALLOWLIST=
