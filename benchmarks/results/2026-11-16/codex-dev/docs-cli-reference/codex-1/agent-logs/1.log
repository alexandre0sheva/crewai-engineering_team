{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'ls -la; for p in /AGENTS.md /private/AGENTS.md /private/tmp/AGENTS.md; do if [ -f \"$p\" ]; then cat \"$p\"; fi; done; git status --short; cat tasktool/cli.py tasktool/store.py tasktool/__main__.py README.md tests/test_cli.py'","aggregated_output":"total 8\ndrwxr-xr-x@  6 alexander  wheel  192 Nov 16 22:31 .\ndrwxr-xr-x@  5 alexander  wheel  160 Nov 16 22:31 ..\ndrwxr-xr-x@ 12 alexander  wheel  384 Nov 16 22:31 .git\n-rw-r--r--@  1 alexander  wheel  216 Oct 28 23:30 README.md\ndrwxr-xr-x@  6 alexander  wheel  192 Nov 16 22:31 tasktool\ndrwxr-xr-x@  4 alexander  wheel  128 Nov 16 22:31 tests\n\"\"\"The command line: ``python -m tasktool [--file FILE] COMMAND ...``.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport sys\nfrom datetime import date\nfrom pathlib import Path\n\nfrom tasktool.store import Store\n\nPRIORITIES = (\"low\", \"normal\", \"high\")\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(prog=\"tasktool\", description=\"A to-do list in a JSON file.\")\n    parser.add_argument(\"--file\", default=\"tasks.json\", help=\"where the tasks are kept\")\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n\n    add = commands.add_parser(\"add\", help=\"add a task\")\n    add.add_argument(\"title\")\n    add.add_argument(\"--priority\", choices=PRIORITIES, default=\"normal\")\n    add.add_argument(\"--due\", type=date.fromisoformat, help=\"YYYY-MM-DD\")\n    add.add_argument(\"--tag\", action=\"append\", default=[], dest=\"tags\", help=\"repeatable\")\n\n    show = commands.add_parser(\"list\", help=\"list tasks\")\n    show.add_argument(\"--all\", action=\"store_true\", help=\"include finished tasks\")\n    show.add_argument(\"--tag\", help=\"only tasks with this tag\")\n    show.add_argument(\"--sort\", choices=(\"id\", \"due\", \"priority\"), default=\"id\")\n\n    done = commands.add_parser(\"done\", help=\"mark tasks finished\")\n    done.add_argument(\"ids\", nargs=\"+\", type=int)\n\n    export = commands.add_parser(\"export\", help=\"write the tasks as CSV\")\n    export.add_argument(\"--output\", default=\"-\", help=\"a file, or - for standard output\")\n    export.add_argument(\"--delimiter\", default=\",\")\n    return parser\n\n\ndef run(argv: list[str]) -> int:\n    args = build_parser().parse_args(argv)\n    store = Store(Path(args.file))\n    if args.command == \"add\":\n        task = store.add(args.title, args.priority, args.due, args.tags)\n        store.save()\n        print(f\"added {task.id}: {task.title}\")\n    elif args.command == \"list\":\n        rank = {\"high\": 0, \"normal\": 1, \"low\": 2}\n        keys = {\n            \"id\": lambda t: t.id,\n            \"due\": lambda t: (t.due is None, t.due or \"\", t.id),\n            \"priority\": lambda t: (rank[t.priority], t.id),\n        }\n        for task in sorted(store.tasks, key=keys[args.sort]):\n            if (task.done and not args.all) or (args.tag and args.tag not in task.tags):\n                continue\n            mark = \"x\" if task.done else \" \"\n            due = f\" (due {task.due})\" if task.due else \"\"\n            print(f\"[{mark}] {task.id} {task.title} [{task.priority}]{due}\")\n    elif args.command == \"done\":\n        try:\n            for task_id in args.ids:\n                store.get(task_id).done = True\n        except KeyError as exc:\n            print(f\"error: no task {exc.args[0]}\", file=sys.stderr)\n            return 2\n        store.save()\n    else:\n        out = sys.stdout if args.output == \"-\" else open(args.output, \"w\", newline=\"\")  # noqa: SIM115\n        writer = csv.writer(out, delimiter=args.delimiter, lineterminator=\"\\n\")\n        writer.writerow([\"id\", \"title\", \"priority\", \"due\", \"tags\", \"done\"])\n        for t in store.tasks:\n            writer.writerow([t.id, t.title, t.priority, t.due or \"\", \" \".join(t.tags), t.done])\n        if out is not sys.stdout:\n            out.close()\n    return 0\n\"\"\"Tasks kept in a JSON file.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import asdict, dataclass, field\nfrom datetime import date\nfrom pathlib import Path\n\n\n@dataclass\nclass Task:\n    id: int\n    title: str\n    priority: str = \"normal\"\n    due: str | None = None\n    tags: list[str] = field(default_factory=list)\n    done: bool = False\n\n\nclass Store:\n    def __init__(self, path: Path) -> None:\n        self.path = path\n        self.tasks: list[Task] = []\n        if path.is_file():\n            self.tasks = [Task(**item) for item in json.loads(path.read_text(encoding=\"utf-8\"))]\n\n    def save(self) -> None:\n        self.path.write_text(json.dumps([asdict(t) for t in self.tasks], indent=2), encoding=\"utf-8\")\n\n    def add(self, title: str, priority: str, due: date | None, tags: list[str]) -> Task:\n        task = Task(\n            max((t.id for t in self.tasks), default=0) + 1,\n            title,\n            priority,\n            due.isoformat() if due else None,\n            sorted(set(tags)),\n        )\n        self.tasks.append(task)\n        return task\n\n    def get(self, task_id: int) -> Task:\n        for task in self.tasks:\n            if task.id == task_id:\n                return task\n        raise KeyError(task_id)\nimport sys\n\nfrom tasktool.cli import run\n\nsys.exit(run(sys.argv[1:]))\n# tasktool\n\nA to-do list in a JSON file, for the terminal (Python 3.11+, standard library only).\n\n```bash\npython -m tasktool add \"Buy milk\" --tag home\npython -m tasktool list\npython -m unittest discover -s tests\n```\nimport contextlib\nimport io\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom tasktool.cli import run\n\n\nclass CliTest(unittest.TestCase):\n    def test_add_list_done(self):\n        with tempfile.TemporaryDirectory() as scratch:\n            file = str(Path(scratch, \"t.json\"))\n            run([\"--file\", file, \"add\", \"Buy milk\", \"--tag\", \"home\"])\n            run([\"--file\", file, \"done\", \"1\"])\n            out = io.StringIO()\n            with contextlib.redirect_stdout(out):\n                run([\"--file\", file, \"list\", \"--all\"])\n            self.assertEqual(out.getvalue(), \"[x] 1 Buy milk [normal]\\n\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
