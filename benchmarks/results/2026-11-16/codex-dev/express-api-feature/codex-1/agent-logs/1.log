d book ids\", async (t) => {\n+  const api = await serve(initialBooks);\n+  t.after(api.stop);\n+  for (const id of [\"9\", \"0\", \"-1\", \"1.5\", \"01\", \"abc\"]) {\n+    for (const action of [\"loan\", \"return\"]) {\n+      assert.deepEqual(await send(`${api.url}/books/${id}/${action}`, \"POST\", { member: \"ana\" }), {\n+        status: 404, body: { error: `no book ${id}` },\n+      });\n+    }\n+  }\n+  assert.deepEqual(await send(`${api.url}/books/3/return`, \"POST\"), {\n+    status: 409, body: { error: \"book 3 is not on loan\" },\n+  });\n+  await send(`${api.url}/books/3/loan`, \"POST\", { member: \"ana\" });\n+  assert.deepEqual(await send(`${api.url}/books/3/loan`, \"POST\", { member: \"ben\" }), {\n+    status: 409, body: { error: \"book 3 is already on loan\" },\n+  });\n+});\n+\n+test(\"availability filters books by loan state in id order\", async (t) => {\n+  const api = await serve(initialBooks);\n+  t.after(api.stop);\n+  const books = initialBooks.map((book, index) => ({ id: index + 1, ...book, onLoanTo: null }));\n+  const availableUrl = `${api.url}/books?available=true`;\n+  const loanedUrl = `${api.url}/books?available=false`;\n+  assert.deepEqual(await send(availableUrl, \"GET\"), { status: 200, body: books });\n+  assert.deepEqual(await send(loanedUrl, \"GET\"), { status: 200, body: [] });\n+  for (const id of [4, 2]) {\n+    await send(`${api.url}/books/${id}/loan`, \"POST\", { member: \"ana\" });\n+  }\n+  assert.deepEqual(await send(availableUrl, \"GET\"), { status: 200, body: [books[0], books[2]] });\n+  assert.deepEqual(await send(loanedUrl, \"GET\"), {\n+    status: 200, body: [books[1], books[3]].map((book) => ({ ...book, onLoanTo: \"ana\" })),\n+  });\n+  assert.deepEqual((await send(`${api.url}/books`, \"GET\")).body.map((book: { id: number }) => book.id),\n+    [1, 2, 3, 4]);\n+  await send(`${api.url}/books/2/return`, \"POST\");\n+  assert.deepEqual((await send(availableUrl, \"GET\")).body, [books[0], books[1], books[2]]);\n+  as