{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom datetime import date\nfrom decimal import Decimal, localcontext\nfrom itertools import product\nimport subprocess\nimport sys\nimport types\n\nfrom billing import invoice, quote, receipt\n\noriginals = {}\nfor name in ('quote', 'invoice', 'receipt'):\n    module = types.ModuleType('original_' + name)\n    sys.modules[module.__name__] = module\n    source = subprocess.check_output(['git', 'show', f'HEAD:billing/{name}.py'], text=True)\n    exec(compile(source, f'original/{name}.py', 'exec'), module.__dict__)\n    originals[name] = module\n\nitem_sets = [[], [('first', Decimal('34.995'), 2), ('second', Decimal('60.00'), 1)]]\nitem_sets += [[('item', Decimal(price), quantity)]\n              for price in ('0', '0.005', '-0.005', '1.235', '999999999999.995', 'NaN', 'Infinity')\n              for quantity in (-1, 0, 1, 3)]\nitem_sets += [[('first', Decimal('1.005'), 1), ('bad', Decimal('2'), 0)],\n              [('first', Decimal('1'), -1), ('second', Decimal('2'), 0)]]\n\ndef outcome(function, args, precision):\n    with localcontext() as context:\n        context.prec = precision\n        try:\n            return ('result', repr(function(*args)))\n        except Exception as error:\n            return ('error', type(error), str(error))\n\nchecked = 0\nfor items, discount, region, precision in product(\n    item_sets, (-1, 0, 1, 10, 25, 50, 51), ('DE', 'FR', 'NL', 'XX'), (6, 28)\n):\n    calls = [('quote', quote, (items, region, discount))]\n    calls += [('invoice', invoice, (number, date(2026, 2, 20), items, region, discount))\n              for number in ('INV-7', 'bad')]\n    calls += [('receipt', receipt, (items, region, paid, discount))\n              for paid in (Decimal('-1'), Decimal('0'), Decimal('200'), Decimal('10000000000000'))]\n    for name, current, args in calls:\n        before = outcome(getattr(originals[name], 'build_' + name), args, precision)\n        after = outcome(getattr(current, 'build_' + name), args, precision)\n        assert before == after, (name, args, precision, before, after)\n        checked += 1\nprint(f'{checked:,} comparisons against original implementations passed (amounts and exact errors).')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
