{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'ls -la; cat billing/quote.py billing/invoice.py billing/receipt.py tests/test_billing.py README.md billing/__init__.py billing/__main__.py'","aggregated_output":"total 8\ndrwxr-xr-x@  6 alexander  wheel  192 Nov 16 22:41 .\ndrwxr-xr-x@  5 alexander  wheel  160 Nov 16 22:41 ..\ndrwxr-xr-x@ 12 alexander  wheel  384 Nov 16 22:41 .git\n-rw-r--r--@  1 alexander  wheel  428 Oct 28 23:14 README.md\ndrwxr-xr-x@  7 alexander  wheel  224 Nov 16 22:41 billing\ndrwxr-xr-x@  4 alexander  wheel  128 Nov 16 22:41 tests\n\"\"\"A quote: what a job would cost, before the customer accepts it.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom decimal import ROUND_HALF_UP, Decimal\n\nCENT = Decimal(\"0.01\")\nTAX_RATES = {\"DE\": Decimal(\"0.19\"), \"FR\": Decimal(\"0.20\"), \"NL\": Decimal(\"0.21\")}\n\n\n@dataclass(frozen=True)\nclass Quote:\n    lines: list[tuple[str, Decimal]]\n    subtotal: Decimal\n    discount: Decimal\n    tax: Decimal\n    total: Decimal\n\n\ndef build_quote(\n    items: list[tuple[str, Decimal, int]], region: str, discount_percent: int = 0\n) -> Quote:\n    \"\"\"``items`` are ``(description, unit price, quantity)``.\"\"\"\n\n    lines = []\n    for description, unit_price, quantity in items:\n        if quantity <= 0:\n            raise ValueError(f\"quantity of {description!r} must be positive\")\n        amount = (unit_price * quantity).quantize(CENT, rounding=ROUND_HALF_UP)\n        lines.append((description, amount))\n    subtotal = sum((amount for _, amount in lines), Decimal(\"0.00\"))\n    if not 0 <= discount_percent <= 50:\n        raise ValueError(\"a discount is between 0 and 50 percent\")\n    discount = (subtotal * Decimal(discount_percent) / 100).quantize(CENT, rounding=ROUND_HALF_UP)\n    taxable = subtotal - discount\n    if region not in TAX_RATES:\n        raise ValueError(f\"no tax rate for region {region!r}\")\n    tax = (taxable * TAX_RATES[region]).quantize(CENT, rounding=ROUND_HALF_UP)\n    return Quote(lines, subtotal, discount, tax, taxable + tax)\n\"\"\"An invoice: what the customer owes for an accepted job, with a due date.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import date, timedelta\nfrom decimal import ROUND_HALF_UP, Decimal\n\nCENT = Decimal(\"0.01\")\nTAX_RATES = {\"DE\": Decimal(\"0.19\"), \"FR\": Decimal(\"0.20\"), \"NL\": Decimal(\"0.21\")}\nPAYMENT_DAYS = 14\n\n\n@dataclass(frozen=True)\nclass Invoice:\n    number: str\n    issued: date\n    due: date\n    lines: list[tuple[str, Decimal]]\n    subtotal: Decimal\n    discount: Decimal\n    tax: Decimal\n    total: Decimal\n\n\ndef build_invoice(\n    number: str,\n    issued: date,\n    items: list[tuple[str, Decimal, int]],\n    region: str,\n    discount_percent: int = 0,\n) -> Invoice:\n    \"\"\"``items`` are ``(description, unit price, quantity)``; the invoice is due in 14 days.\"\"\"\n\n    if not number.startswith(\"INV-\"):\n        raise ValueError(\"invoice numbers start with INV-\")\n    lines = []\n    for description, unit_price, quantity in items:\n        if quantity <= 0:\n            raise ValueError(f\"quantity of {description!r} must be positive\")\n        lines.append((description, (unit_price * quantity).quantize(CENT, rounding=ROUND_HALF_UP)))\n    subtotal = sum((amount for _, amount in lines), Decimal(\"0.00\"))\n    if discount_percent < 0 or discount_percent > 50:\n        raise ValueError(\"a discount is between 0 and 50 percent\")\n    discount = (subtotal * Decimal(discount_percent) / 100).quantize(CENT, rounding=ROUND_HALF_UP)\n    if region not in TAX_RATES:\n        raise ValueError(f\"no tax rate for region {region!r}\")\n    tax = ((subtotal - discount) * TAX_RATES[region]).quantize(CENT, rounding=ROUND_HALF_UP)\n    total = subtotal - discount + tax\n    return Invoice(\n        number, issued, issued + timedelta(days=PAYMENT_DAYS), lines, subtotal, discount, tax, total\n    )\n\"\"\"A receipt: a paid counter sale. Prices include tax, so the tax is worked out backwards.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom decimal import ROUND_HALF_UP, Decimal\n\nCENT = Decimal(\"0.01\")\nTAX_RATES = {\"DE\": Decimal(\"0.19\"), \"FR\": Decimal(\"0.20\"), \"NL\": Decimal(\"0.21\")}\n\n\n@dataclass(frozen=True)\nclass Receipt:\n    lines: list[tuple[str, Decimal]]\n    total: Decimal\n    discount: Decimal\n    tax_included: Decimal\n    paid: Decimal\n    change: Decimal\n\n\ndef build_receipt(\n    items: list[tuple[str, Decimal, int]],\n    region: str,\n    paid: Decimal,\n    discount_percent: int = 0,\n) -> Receipt:\n    \"\"\"``items`` are ``(description, gross unit price, quantity)``; ``paid`` is what was handed over.\"\"\"\n\n    lines = []\n    for description, unit_price, quantity in items:\n        if quantity <= 0:\n            raise ValueError(f\"quantity of {description!r} must be positive\")\n        lines.append((description, (unit_price * quantity).quantize(CENT, ROUND_HALF_UP)))\n    gross = sum((amount for _, amount in lines), Decimal(\"0.00\"))\n    if not (0 <= discount_percent <= 50):\n        raise ValueError(\"a discount is between 0 and 50 percent\")\n    discount = (gross * Decimal(discount_percent) / 100).quantize(CENT, ROUND_HALF_UP)\n    total = gross - discount\n    rate = TAX_RATES.get(region)\n    if rate is None:\n        raise ValueError(f\"no tax rate for region {region!r}\")\n    tax_included = (total - total / (1 + rate)).quantize(CENT, ROUND_HALF_UP)\n    if paid < total:\n        raise ValueError(f\"paid {paid} is less than the total {total}\")\n    return Receipt(lines, total, discount, tax_included, paid, paid - total)\nimport unittest\nfrom datetime import date\nfrom decimal import Decimal\n\nfrom billing.invoice import build_invoice\nfrom billing.quote import build_quote\nfrom billing.receipt import build_receipt\n\nITEMS = [(\"Brake pads\", Decimal(\"34.995\"), 2), (\"Labour\", Decimal(\"60.00\"), 1)]\n\n\nclass QuoteTest(unittest.TestCase):\n    def test_totals(self):\n        quote = build_quote(ITEMS, \"DE\", 10)\n        self.assertEqual(quote.subtotal, Decimal(\"129.99\"))\n        self.assertEqual(quote.discount, Decimal(\"13.00\"))\n        self.assertEqual(quote.tax, Decimal(\"22.23\"))\n        self.assertEqual(quote.total, Decimal(\"139.22\"))\n\n    def test_unknown_region(self):\n        with self.assertRaisesRegex(ValueError, \"no tax rate\"):\n            build_quote(ITEMS, \"XX\")\n\n\nclass InvoiceTest(unittest.TestCase):\n    def test_due_date_and_total(self):\n        invoice = build_invoice(\"INV-7\", date(2026, 2, 20), ITEMS, \"FR\")\n        self.assertEqual(invoice.due, date(2026, 3, 6))\n        self.assertEqual(invoice.total, Decimal(\"155.99\"))\n\n\nclass ReceiptTest(unittest.TestCase):\n    def test_tax_included_and_change(self):\n        receipt = build_receipt(ITEMS, \"NL\", Decimal(\"200\"))\n        self.assertEqual(receipt.total, Decimal(\"129.99\"))\n        self.assertEqual(receipt.tax_included, Decimal(\"22.56\"))\n        self.assertEqual(receipt.change, Decimal(\"70.01\"))\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n# billing\n\nQuotes, invoices and receipts for a small workshop (Python 3.11+, standard library only).\n\n```bash\npython -m billing quote DE --discount 10 \"Brake pads:34.995:2\" \"Labour:60:1\"\npython -m billing receipt NL --paid 200 \"Brake pads:34.995:2\" \"Labour:60:1\"\npython -m unittest discover -s tests\n```\n\nAmounts are rounded to the cent, half up. Tax rates: DE 19 %, FR 20 %, NL 21 %. Discounts are\nwhole percents from 0 to 50.\n\"\"\"Quotes, invoices and receipts for a small workshop. Amounts are ``Decimal`` in euros.\"\"\"\n\"\"\"``python -m billing quote|receipt REGION [--discount N] [--paid AMOUNT] ITEM...``\n\nAn item is ``description:unit_price:quantity``, e.g. ``\"Oil change:49.90:1\"``.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport sys\nfrom decimal import Decimal, InvalidOperation\n\nfrom billing.quote import build_quote\nfrom billing.receipt import build_receipt\n\n\ndef parse_item(text: str) -> tuple[str, Decimal, int]:\n    try:\n        description, price, quantity = text.rsplit(\":\", 2)\n        return description, Decimal(price), int(quantity)\n    except (ValueError, InvalidOperation):\n        raise argparse.ArgumentTypeError(f\"bad item {text!r}: use description:price:qty\") from None\n\n\ndef main(argv: list[str] | None = None) -> int:\n    parser = argparse.ArgumentParser(prog=\"billing\")\n    parser.add_argument(\"kind\", choices=[\"quote\", \"receipt\"])\n    parser.add_argument(\"region\")\n    parser.add_argument(\"items\", nargs=\"+\", type=parse_item)\n    parser.add_argument(\"--discount\", type=int, default=0)\n    parser.add_argument(\"--paid\", type=Decimal)\n    args = parser.parse_args(argv)\n    try:\n        if args.kind == \"quote\":\n            quote = build_quote(args.items, args.region, args.discount)\n            for description, amount in quote.lines:\n                print(f\"{description:<30}{amount:>10}\")\n            print(f\"{'Subtotal':<30}{quote.subtotal:>10}\")\n            print(f\"{'Discount':<30}{-quote.discount:>10}\")\n            print(f\"{'Tax':<30}{quote.tax:>10}\")\n            print(f\"{'Total':<30}{quote.total:>10}\")\n        else:\n            paid = args.paid if args.paid is not None else Decimal(\"0\")\n            receipt = build_receipt(args.items, args.region, paid, args.discount)\n            for description, amount in receipt.lines:\n                print(f\"{description:<30}{amount:>10}\")\n            print(f\"{'Total (incl. tax ' + str(receipt.tax_included) + ')':<30}{receipt.total:>10}\")\n            print(f\"{'Paid':<30}{receipt.paid:>10}\")\n            print(f\"{'Change':<30}{receipt.change:>10}\")\n    except ValueError as exc:\n        print(f\"error: {exc}\", file=sys.stderr)\n        return 2\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","exit_code":0,"status":"completed"}}
