{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'git status --short; for f in AGENTS.md ../AGENTS.md ../../AGENTS.md; do if [ -f \"$f\" ]; then cat \"$f\"; fi; done; cat package.json src/format.ts src/units.ts src/cli.ts src/stats.ts test/format.test.ts test/cli.test.ts test/parse.test.ts'","aggregated_output":"{\n  \"name\": \"durations\",\n  \"version\": \"1.2.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"description\": \"Add up and summarise time durations such as 1h30m.\",\n  \"bin\": { \"durations\": \"src/cli.ts\" },\n  \"scripts\": {\n    \"test\": \"node --test\"\n  },\n  \"engines\": { \"node\": \">=24\" }\n}\nimport { UNITS } from \"./units.ts\";\n\n/** `3725` -> `1h2m5s`: rounded to the nearest second, largest unit first, zero parts left out. */\nexport function formatDuration(seconds: number): string {\n  if (!Number.isFinite(seconds) || seconds < 0) {\n    throw new RangeError(`cannot format ${seconds} seconds`);\n  }\n  const parts: string[] = [];\n  let rest = seconds;\n  for (const [unit, size] of UNITS) {\n    const amount = size === 1 ? Math.round(rest) : Math.floor(rest / size);\n    if (amount > 0) {\n      parts.push(`${amount}${unit}`);\n    }\n    rest -= amount * size;\n  }\n  return parts.length > 0 ? parts.join(\"\") : \"0s\";\n}\n/** Seconds per unit, largest first (the order formatDuration prints them in). */\nexport const UNITS: ReadonlyArray<readonly [string, number]> = [\n  [\"d\", 86_400],\n  [\"h\", 3_600],\n  [\"m\", 60],\n  [\"s\", 1],\n];\n\nexport const SECONDS_PER_UNIT: ReadonlyMap<string, number> = new Map(UNITS);\n#!/usr/bin/env node\nimport { readFileSync } from \"node:fs\";\nimport { DurationError } from \"./errors.ts\";\nimport { formatDuration } from \"./format.ts\";\nimport { parseDuration } from \"./parse.ts\";\nimport { summarise } from \"./stats.ts\";\n\nconst USAGE = \"usage: durations total DURATION... | durations stats --file FILE\";\n\nfunction readList(path: string): string[] {\n  let text: string;\n  try {\n    text = readFileSync(path, \"utf8\");\n  } catch {\n    throw new DurationError(`cannot read ${path}`);\n  }\n  return text\n    .split(\"\\n\")\n    .map((line) => line.trim())\n    .filter((line) => line !== \"\" && !line.startsWith(\"#\"));\n}\n\nexport function main(args: readonly string[]): string[] {\n  const [command, ...rest] = args;\n  if (command === \"total\") {\n    if (rest.length === 0) {\n      throw new DurationError(USAGE);\n    }\n    const total = rest.map(parseDuration).reduce((sum, value) => sum + value, 0);\n    return [formatDuration(total)];\n  }\n  if (command === \"stats\") {\n    if (rest.length !== 2 || rest[0] !== \"--file\") {\n      throw new DurationError(USAGE);\n    }\n    const lines = readList(rest[1]);\n    if (lines.length === 0) {\n      throw new DurationError(`no durations in ${rest[1]}`);\n    }\n    const summary = summarise(lines.map(parseDuration));\n    return [\n      `count: ${summary.count}`,\n      `total: ${formatDuration(summary.total)}`,\n      `fastest: ${formatDuration(summary.fastest)}`,\n      `slowest: ${formatDuration(summary.slowest)}`,\n      `average: ${formatDuration(summary.average)}`,\n    ];\n  }\n  throw new DurationError(USAGE);\n}\n\nif (import.meta.main) {\n  try {\n    for (const line of main(process.argv.slice(2))) {\n      console.log(line);\n    }\n  } catch (error) {\n    if (error instanceof DurationError) {\n      console.error(`error: ${error.message}`);\n      process.exit(2);\n    }\n    throw error;\n  }\n}\nexport interface Summary {\n  count: number;\n  total: number;\n  fastest: number;\n  slowest: number;\n  average: number;\n}\n\n/** Count, total, fastest, slowest and average of some durations in seconds (at least one). */\nexport function summarise(durations: readonly number[]): Summary {\n  if (durations.length === 0) {\n    throw new RangeError(\"nothing to summarise\");\n  }\n  const total = durations.reduce((sum, value) => sum + value, 0);\n  return {\n    count: durations.length,\n    total,\n    fastest: Math.min(...durations),\n    slowest: Math.max(...durations),\n    average: total / durations.length,\n  };\n}\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { formatDuration } from \"../src/format.ts\";\n\ntest(\"prints the largest unit first and leaves out zero parts\", () => {\n  assert.equal(formatDuration(3_725), \"1h2m5s\");\n  assert.equal(formatDuration(90_000), \"1d1h\");\n  assert.equal(formatDuration(0), \"0s\");\n});\n\ntest(\"refuses negative and non-finite values\", () => {\n  assert.throws(() => formatDuration(-1), RangeError);\n  assert.throws(() => formatDuration(Number.NaN), RangeError);\n});\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { main } from \"../src/cli.ts\";\n\ntest(\"total adds durations\", () => {\n  assert.deepEqual(main([\"total\", \"1h30m\", \"45m\"]), [\"2h15m\"]);\n});\n\ntest(\"a usage error names both commands\", () => {\n  assert.throws(() => main([\"nope\"]), /durations total/);\n});\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { DurationError } from \"../src/errors.ts\";\nimport { parseDuration } from \"../src/parse.ts\";\n\ntest(\"parses every unit and combinations\", () => {\n  assert.equal(parseDuration(\"45s\"), 45);\n  assert.equal(parseDuration(\"1h30m\"), 5_400);\n  assert.equal(parseDuration(\"2d4h\"), 187_200);\n  assert.equal(parseDuration(\" 1.5H \"), 5_400);\n});\n\ntest(\"rejects what it cannot read\", () => {\n  assert.throws(() => parseDuration(\"\"), DurationError);\n  assert.throws(() => parseDuration(\"10x\"), /unknown unit \"x\"/);\n  assert.throws(() => parseDuration(\"1h 30m\"), /cannot read/);\n});\n","exit_code":0,"status":"completed"}}
