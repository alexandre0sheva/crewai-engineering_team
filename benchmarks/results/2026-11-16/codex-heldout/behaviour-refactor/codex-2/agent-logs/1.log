{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport ast\nimport importlib.util\nimport random\nimport struct\nfrom pathlib import Path\nfrom orders.summary import summarize\n\noriginal_path = '/var/folders/x0/hfd1bt5s0kg52khnx8h3qm2w0000gp/T/orders-summary-baseline-8074bjy1/summary.py'\nspec = importlib.util.spec_from_file_location('original_summary', original_path)\noriginal = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(original)\n\ndef freeze(value):\n    if isinstance(value, dict):\n        return ('dict', tuple((freeze(k), freeze(v)) for k, v in value.items()))\n    if isinstance(value, (list, tuple)):\n        return (type(value).__name__, tuple(map(freeze, value)))\n    if isinstance(value, float):\n        return ('float', struct.pack('\"'!d'\"', value))\n    return (type(value).__name__, value)\n\nclass TracedDict(dict):\n    def __init__(self, value, trace, path):\n        super().__init__(value)\n        self.trace = trace\n        self.path = path\n    def get(self, key, *default):\n        self.trace.append((self.path, key, freeze(default)))\n        return super().get(key, *default)\n\ndef traced(value, trace, path='orders'):\n    if isinstance(value, dict):\n        return TracedDict({k: traced(v, trace, path + '.' + str(k)) for k, v in value.items()}, trace, path)\n    if isinstance(value, list):\n        return [traced(v, trace, path + '[' + str(i) + ']') for i, v in enumerate(value)]\n    return value\n\ndef run(function, orders, generator):\n    trace = []\n    value = traced(orders, trace)\n    try:\n        result = ('result', freeze(function(iter(value) if generator else value)))\n    except Exception as error:\n        result = ('error', type(error).__name__, freeze(error.args))\n    return result, trace, freeze(value)\n\nrng = random.Random(77413)\ncases = [[], [{}], [None], [{'items': None}], [{'status': []}],\n         [{'customer': None, 'items': [{'sku': 'A', 'qty': 1, 'price': 100}]}, {'customer': 'b'}],\n         [{'strict': True, 'items': [{'qty': 0}, {'sku': 'counted', 'qty': 3, 'price': 2}]}]]\nprices = [-1, -0.0, 0, 0.005, 1.005, 2.675, 4.999, 49.99, 50, 99.99, 100, 100.01, 1e16]\nfor index in range(10000):\n    orders = []\n    for _ in range(rng.randrange(9)):\n        order = {}\n        for key, values in [('id', [None, 0, 1, 'x']), ('customer', [None, 'staff', 'ann', 'bob', 'unknown', 0]),\n                            ('country', [None, 'US', 'DE', 'FR', 'GB', '']),\n                            ('coupon', [None, 'TEN', 'FIVE', 'HALF', 'unknown']),\n                            ('status', [None, 'new', 'paid', 'cancelled']), ('strict', [False, True, None, 0, 1])]:\n            if rng.random() < .8:\n                order[key] = rng.choice(values)\n        if rng.random() < .9:\n            order['items'] = []\n            for _ in range(rng.randrange(6)):\n                item = {}\n                for key, values in [('sku', [None, 'A', 'B', 1, '1', 'a']),\n                                    ('qty', [-2, 0, 1, 2, 3, .5, True]), ('price', prices)]:\n                    if rng.random() < .9:\n                        item[key] = rng.choice(values)\n                order['items'].append(item)\n        orders.append(order)\n    if index >= 8000 and orders:\n        order = rng.choice(orders)\n        key = rng.choice(['items', 'country', 'customer', 'status', 'coupon'])\n        order[key] = rng.choice([None, [], {}, 1, 'bad', float('nan'), float('inf')])\n    cases.append(orders)\nfor value in [float('nan'), float('inf'), float('-inf'), -0.0, 1e308]:\n    for field in ['qty', 'price']:\n        cases.append([{'items': [{'sku': 'A', 'qty': 1, 'price': 1, field: value}]}])\nfor index, case in enumerate(cases):\n    before = run(original.summarize, case, index % 2)\n    after = run(summarize, case, index % 2)\n    assert before == after, (index, case, before, after)\nprint(f'{len(cases)} differential cases passed: values, float bits, dict order, errors, lookup order, input state.')\nsource = Path('orders/summary.py').read_text()\nfor node in ast.walk(ast.parse(source)):\n    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n        length = node.end_lineno - node.lineno + 1\n        assert length <= 30, (node.name, length)\n        print(f'{node.name}: {length} lines')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
