{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'ls -la; for f in /AGENTS.md /private/AGENTS.md /private/tmp/AGENTS.md; do if [ -f \"$f\" ]; then cat \"$f\"; fi; done; cat main.go internal/count/count.go internal/count/count_test.go go.mod README.md'","aggregated_output":"total 24\ndrwxr-xr-x@  7 alexander  wheel   224 Nov 16 22:14 .\ndrwxr-xr-x@  5 alexander  wheel   160 Nov 16 22:14 ..\ndrwxr-xr-x@ 12 alexander  wheel   384 Nov 16 22:14 .git\n-rw-r--r--@  1 alexander  wheel   545 Oct 28 23:06 README.md\n-rw-r--r--@  1 alexander  wheel    37 Oct 28 23:06 go.mod\ndrwxr-xr-x@  3 alexander  wheel    96 Nov 16 22:14 internal\n-rw-r--r--@  1 alexander  wheel  1171 Oct 28 23:06 main.go\n// Command wordstat prints the most frequent words in text files.\npackage main\n\nimport (\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\n\t\"example.com/wordstat/internal/count\"\n)\n\nfunc run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {\n\tflags := flag.NewFlagSet(\"wordstat\", flag.ContinueOnError)\n\tflags.SetOutput(stderr)\n\ttop := flags.Int(\"top\", 10, \"how many words to print (0: all)\")\n\tif err := flags.Parse(args); err != nil {\n\t\treturn 2\n\t}\n\tif *top < 0 {\n\t\tfmt.Fprintln(stderr, \"wordstat: -top must be 0 or more\")\n\t\treturn 2\n\t}\n\tcounter := count.New()\n\tif flags.NArg() == 0 {\n\t\tif err := counter.Add(stdin); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"wordstat: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t}\n\tfor _, name := range flags.Args() {\n\t\tfile, err := os.Open(name)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"wordstat: cannot read %s\\n\", name)\n\t\t\treturn 1\n\t\t}\n\t\terr = counter.Add(file)\n\t\tfile.Close()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"wordstat: %s: %v\\n\", name, err)\n\t\t\treturn 1\n\t\t}\n\t}\n\tfor _, entry := range counter.Top(*top) {\n\t\tfmt.Fprintf(stdout, \"%d\\t%s\\n\", entry.Count, entry.Word)\n\t}\n\treturn 0\n}\n\nfunc main() {\n\tos.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr))\n}\n// Package count counts words and ranks them.\npackage count\n\nimport (\n\t\"bufio\"\n\t\"io\"\n\t\"sort\"\n\t\"strings\"\n\t\"unicode\"\n)\n\n// Entry is one word and how often it occurs.\ntype Entry struct {\n\tWord  string\n\tCount int\n}\n\n// Counter accumulates word counts over several inputs.\ntype Counter struct {\n\tcounts map[string]int\n}\n\n// New returns an empty Counter.\nfunc New() *Counter {\n\treturn &Counter{counts: map[string]int{}}\n}\n\nfunc isWordRune(r rune) bool {\n\treturn unicode.IsLetter(r) || unicode.IsDigit(r) || r == '\\''\n}\n\n// Words splits text into lower-case words.\nfunc Words(text string) []string {\n\tfields := strings.FieldsFunc(text, func(r rune) bool { return !isWordRune(r) })\n\twords := fields[:0]\n\tfor _, field := range fields {\n\t\tword := strings.ToLower(strings.Trim(field, \"'\"))\n\t\tif word != \"\" {\n\t\t\twords = append(words, word)\n\t\t}\n\t}\n\treturn words\n}\n\n// Add counts the words read from r.\nfunc (c *Counter) Add(r io.Reader) error {\n\tscanner := bufio.NewScanner(r)\n\tscanner.Buffer(make([]byte, 64*1024), 1024*1024)\n\tfor scanner.Scan() {\n\t\tfor _, word := range Words(scanner.Text()) {\n\t\t\tc.counts[word]++\n\t\t}\n\t}\n\treturn scanner.Err()\n}\n\n// Top returns the n most frequent words (all of them if n <= 0), most frequent first and ties in\n// alphabetical order.\nfunc (c *Counter) Top(n int) []Entry {\n\tentries := make([]Entry, 0, len(c.counts))\n\tfor word, count := range c.counts {\n\t\tentries = append(entries, Entry{Word: word, Count: count})\n\t}\n\tsort.Slice(entries, func(i, j int) bool {\n\t\tif entries[i].Count != entries[j].Count {\n\t\t\treturn entries[i].Count > entries[j].Count\n\t\t}\n\t\treturn entries[i].Word < entries[j].Word\n\t})\n\tif n > 0 && n < len(entries) {\n\t\tentries = entries[:n]\n\t}\n\treturn entries\n}\npackage count\n\nimport (\n\t\"reflect\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestWords(t *testing.T) {\n\ttests := []struct {\n\t\tname string\n\t\ttext string\n\t\twant []string\n\t}{\n\t\t{\"simple\", \"The cat sat\", []string{\"the\", \"cat\", \"sat\"}},\n\t\t{\"punctuation\", \"Hello, world! hello.\", []string{\"hello\", \"world\", \"hello\"}},\n\t\t{\"apostrophes\", \"don't 'quote'\", []string{\"don't\", \"quote\"}},\n\t\t{\"empty\", \"  ... \", []string{}},\n\t}\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tif got := Words(tt.text); !reflect.DeepEqual(got, tt.want) {\n\t\t\t\tt.Errorf(\"Words(%q) = %q, want %q\", tt.text, got, tt.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestTopOrdersByCountThenWord(t *testing.T) {\n\tc := New()\n\tif err := c.Add(strings.NewReader(\"b a c b a b\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twant := []Entry{{\"b\", 3}, {\"a\", 2}}\n\tif got := c.Top(2); !reflect.DeepEqual(got, want) {\n\t\tt.Errorf(\"Top(2) = %v, want %v\", got, want)\n\t}\n}\nmodule example.com/wordstat\n\ngo 1.24\n# wordstat\n\nCounts the words in text files and prints the most frequent ones.\n\n```bash\ngo run . -top 5 notes.txt more.txt   # the five most frequent words over both files\ngo run . < notes.txt                 # read standard input; default -top 10\ngo test ./...\n```\n\nA word is a run of letters, digits and apostrophes, compared in lower case. Output is one\n`count<TAB>word` line per word, most frequent first, ties in alphabetical order. Errors go to\nstandard error as `wordstat: <message>` with exit status 2 (bad flags) or 1 (unreadable file).\n","exit_code":0,"status":"completed"}}
