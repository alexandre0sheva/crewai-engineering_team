],\n            cwd=PROJECT_ROOT,\n            capture_output=True,\n            text=True,\n        )\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ambiguous-export/opencode-1/ws/app/tests/test_contacts.py","text":"import csv\nimport subprocess\nimport sys\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\n\nPROJECT_ROOT = Path(__file__).resolve().parents[1]\n\n\nclass SortCommandTests(unittest.TestCase):\n    def run_sort(self, input_path: Path, output_path: Path):\n        return subprocess.run(\n            [sys.executable, \"-m\", \"contacts\", \"sort\", str(input_path), str(output_path)],\n            cwd=PROJECT_ROOT,\n            capture_output=True,\n            text=True,\n        )\n\n    def test_sorts_rows_by_name_and_keeps_header(self):\n        with tempfile.TemporaryDirectory() as directory:\n            input_path = Path(directory) / \"contacts.csv\"\n            output_path = Path(directory) / \"sorted.csv\"\n            input_path.write_text(\n                \"name,email,phone\\n\"\n                \"Grace Hopper,grace@example.org,555-0101\\n\"\n                \"Alan Turing,alan@example.org,555-0102\\n\",\n                encoding=\"utf-8\",\n            )\n\n            result = self.run_sort(input_path, output_path)\n\n            self.assertEqual(result.returncode, 0, result.stderr)\n            with output_path.open(newline=\"\", encoding=\"utf-8\") as output:\n                rows = list(csv.reader(output))\n            self.assertEqual(rows[0], [\"name\", \"email\", \"phone\"])\n            self.assertEqual([row[0] for row in rows[1:]], [\"Alan Turing\", \"Grace Hopper\"])\n\n    def test_missing_input_returns_status_two_and_writes_to_stderr(self):\n        with tempfile.TemporaryDirectory() as directory:\n            input_path = Path(directory) / \"missing.csv\"\n            output_path = Path(directory) / \"sorted.csv\"\n\n            result = self.run_sort(input_path, output_path)\n\n            self.assertEqual(result.returncode, 2)\n            self.assertTrue(result.stderr.strip())\n            self.assertFalse(output_path.exists())\n\n    def test_missing_name_column_returns_status_two_and_writes_to_stderr(self):\n        with tempfile.TemporaryDirectory() as directory:\n            input_path = Path(directory) / \"contacts.csv\"\n            output_path = Path(directory) / \"sorted.csv\"\n            input_path.write_text(\n                \"email,phone\\ngrace@example.org,555-0101\\n\", encoding=\"utf-8\"\n            )\n\n            result = self.run_sort(input_path, output_path)\n\n            self.assertEqual(result.returncode, 2)\n            self.assertTrue(result.stderr.strip())\n            self.assertFalse(output_path.exists())\n\n\nif __name__ == \"__main__\":\n    unittest.main()","lineStart":1,"lineEnd":67,"totalLines":67,"truncated":false}},"title":"private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ambiguous-export/opencode-1/ws/app/tests/test_contacts.py","time":{"start":1794860800465,"end":1794860801439}},"id":"prt_1e60a59150019Lkfcx3llJFIOf","sessionID":"ses_e19f61cb2ffeyrsDy2RbZxYTUJ","messageID":"msg_1e60a4b52001POg2aEfj7fLhQs"}}
