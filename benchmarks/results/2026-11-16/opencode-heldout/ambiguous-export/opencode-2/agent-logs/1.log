{"type":"tool_use","timestamp":1794860812849,"sessionID":"ses_e19f61cd3ffejcCABau2G12ZL0","part":{"type":"tool","tool":"write","callID":"call_f28a80d33c0e4c17ace406a6","state":{"status":"completed","input":{"filePath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ambiguous-export/opencode-2/ws/app/contacts/core.py","content":"\"\"\"Reading, sorting and writing the club's contact list.\n\nThe format is a plain CSV file with a header line.  The only column the tool\ninspects is ``name``; every other column is carried over untouched.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport os\nfrom typing import Iterable, List, Sequence, Tuple\n\nfrom .errors import InputError, OutputError\n\n__all__ = [\n    \"NAME_COLUMN\",\n    \"find_name_column\",\n    \"read_table\",\n    \"sort_key\",\n    \"sort_rows\",\n    \"write_table\",\n    \"sort_contacts\",\n]\n\n#: The header cell that holds the name a contact is sorted by.\nNAME_COLUMN = \"name\"\n\n#: Field separator used when reading and writing.\nDELIMITER = \",\"\n\n#: Line terminator used when writing.  Plain ``\\n`` keeps the output\n#: identical to the hand-edited files the club already has and is accepted by\n#: every RFC 4180 parser.\nLINETERMINATOR = \"\\n\"\n\n\ndef _is_blank(row: Sequence[str]) -> bool:\n    \"\"\"Return ``True`` when *row* carries no data at all.\"\"\"\n    return all(cell.strip() == \"\" for cell in row)\n\n\ndef _cell(row: Sequence[str], index: int) -> str:\n    \"\"\"Return cell *index* of *row*, or an empty string when it is missing.\"\"\"\n    if 0 <= index < len(row):\n        return row[index]\n    return \"\"\n\n\ndef read_table(path: \"os.PathLike[str] | str\") -> Tuple[List[str], List[List[str]]]:\n    \"\"\"Read the contact table stored at *path*.\n\n    Returns the header row and the data rows exactly as they appear in the\n    file.  Leading blank lines are ignored so that the header is found even\n    when the file starts with an empty line; every line after the header is\n    kept verbatim, including rows with an unusual number of fields.\n\n    Raises:\n        InputError: if the file is missing, unreadable, not valid CSV, or has\n            no ``name`` column.\n    \"\"\"\n    display = os.fspath(path)\n    try:\n        with open(path, \"r\", newline=\"\", encoding=\"utf-8-sig\") as handle:\n            records = list(csv.reader(handle, delimiter=DELIMITER))\n    except FileNotFoundError:\n        raise InputError(f\"input file not found: {display}\") from None\n    except IsADirectoryError:\n        raise InputError(f\"input path is a directory, not a file: {display}\") from None\n    except PermissionError:\n        raise InputError(f\"input file is not readable: {display}\") from None\n    except UnicodeDecodeError:\n        raise InputError(f\"input file is not valid UTF-8 text: {display}\") from None\n    except csv.Error as exc:\n        raise InputError(f\"input file is not valid CSV: {display} ({exc})\") from None\n    except OSError as exc:\n        raise InputError(f\"cannot read input file: {display} ({exc.strerror})\") from None\n\n    header: List[str] | None = None\n    rows: List[List[str]] = []\n    for record in records:\n        if header is None:\n            if _is_blank(record):\n                continue\n            header = record\n        else:\n            rows.append(record)\n\n    if header is None:\n        raise InputError(f\"input file is empty, expected a header row: {display}\")\n\n    return header, rows\n\n\ndef find_name_column(header: Sequence[str]) -> int:\n    \"\"\"Return the index of the ``name`` column in *header*.\n\n    The lookup ignores surrounding whitespace and letter case so that\n    ``Name`` or `` name `` are recognised as well.\n\n    Raises:\n        InputError: if *header* has no ``name`` column.\n    \"\"\"\n    for index, cell in enumerate(header):\n        if cell.strip().casefold() == NAME_COLUMN:\n            return index\n    raise InputError(\"input file has no 'name' column\")\n\n\ndef sort_key(row: Sequence[str], name_index: int) -> Tuple[bool, str]:\n    \"\"\"Return the sort key of *row* for the ``name`` column at *name_index*.\n\n    Names are compared without regard to letter case and ignoring leading and\n    trailing whitespace, which is how people expect a phone list to read.\n    Rows without a name sort last.\n    \"\"\"\n    name = _cell(row, name_index).strip()\n    return (name == \"\", name.casefold())\n\n\ndef sort_rows(rows: Iterable[Sequence[str]], name_index: int) -> List[List[str]]:\n    \"\"\"Return *rows* sorted by the name column, keeping equal names in order.\"\"\"\n    return sorted((list(row) for row in rows), key=lambda row: sort_key(row, name_index))\n\n\ndef write_table(\n    path: \"os.PathLike[str] | str\",\n    header: Sequence[str],\n    rows: Iterable[Sequence[str]],\n) -> None:\n    \"\"\"Write *header* and *rows* to *path* as CSV.\n\n    Raises:\n        OutputError: if the file cannot be written.\n    \"\"\"\n    display = os.fspath(path)\n    try:\n        with open(path, \"w\", newline=\"\", encoding=\"utf-8\") as handle:\n            writer = csv.writer(handle, delimiter=DELIMITER, lineterminator=LINETERMINATOR)\n            writer.writerow(header)\n            writer.writerows(rows)\n    except IsADirectoryError:\n        raise OutputError(f\"output path is a directory, not a file: {display}\") from None\n    except PermissionError:\n        raise OutputError(f\"output file is not writable: {display}\") from None\n    except OSError as exc:\n        raise OutputError(f\"cannot write output file: {display} ({exc.strerror})\") from None\n\n\ndef sort_contacts(input_path: \"os.PathLike[str] | str\", output_path: \"os.PathLike[str] | str\") -> None:\n    \"\"\"Copy the contacts in *input_path* to *output_path*, sorted by name.\n\n    The header and all columns are preserved.  The input is read in full\n    before the output is opened, so a bad input never leaves a half written\n    output file behind.\n\n    Raises:\n        InputError: if the input is missing or has no ``name`` column.\n        OutputError: if the output cannot be written.\n    \"\"\"\n    header, rows = read_table(input_path)\n    name_index = find_name_column(header)\n    sorted_rows = sort_rows(rows, name_index)\n    write_table(output_path, header, sorted_rows)\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ambiguous-export/opencode-2/ws/app/contacts/core.py","exists":false,"truncated":false},"title":"private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ambiguous-export/opencode-2/ws/app/contacts/core.py","time":{"start":1794860812792,"end":1794860812821}},"id":"prt_1e60a8830001SZTI9rd0pB22mk","sessionID":"ses_e19f61cd3ffejcCABau2G12ZL0","messageID":"msg_1e60a6c14001owp5OqAY00OYM8"}}
