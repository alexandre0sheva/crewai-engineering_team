n    ``MAX_PARCEL_KG``: 70 kg becomes three parcels of 23.334 kg (rounded up to the gram).\n    \"\"\"\n\n    if total_kg <= 0:\n        raise ValueError(\"an order weighs something\")\n    count = max(1, math.ceil(total_kg / MAX_PARCEL_KG))","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/answer-questions/opencode-1/repo/parcels/packing.py","text":"\"\"\"Splitting an order into parcels.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom decimal import Decimal\n\nfrom parcels.settings import MAX_PARCEL_KG\n\n\ndef parcel_weights(total_kg: Decimal) -> list[Decimal]:\n    \"\"\"The weights of the parcels an order of ``total_kg`` is packed into.\n\n    Heavy orders are split into as few parcels as possible, all of the same weight, each at most\n    ``MAX_PARCEL_KG``: 70 kg becomes three parcels of 23.334 kg (rounded up to the gram).\n    \"\"\"\n\n    if total_kg <= 0:\n        raise ValueError(\"an order weighs something\")\n    count = max(1, math.ceil(total_kg / MAX_PARCEL_KG))\n    each = (total_kg / count).quantize(Decimal(\"0.001\"), rounding=\"ROUND_CEILING\")\n    return [each] * count","lineStart":1,"lineEnd":22,"totalLines":22,"truncated":false}},"title":"parcels/packing.py","time":{"start":1794860888285,"end":1794860888356}},"id":"prt_1e60bb0c7001fQEyhP6BqEEYop","sessionID":"ses_e19f4fb81ffeOrjVO5vcAH6pd8","messageID":"msg_1e60ba7950018gp4uK4Ow4Wmqj"}}
