cimal, InvalidOperation\n\nfrom parcels.delivery import delivery_date\nfrom parcels.quote import CannotShip, shipping_cost\n\n\ndef main(argv: list[str]) -> int:\n    if len(argv) != 3:\n        print(\"usage: python -m parcels VALUE WEIGHT_KG COUNTRY\", file=sys.stderr)\n        return 2\n    try:\n        value, weight = Decimal(argv[0]), Decimal(argv[1])\n        cost = shipping_cost(value, weight, argv[2])\n    except (InvalidOperation, CannotShip, ValueError) as exc:","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/answer-questions/opencode-1/repo/parcels/__main__.py","text":"\"\"\"``python -m parcels VALUE WEIGHT_KG COUNTRY``: the shipping cost and the delivery date.\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom datetime import datetime\nfrom decimal import Decimal, InvalidOperation\n\nfrom parcels.delivery import delivery_date\nfrom parcels.quote import CannotShip, shipping_cost\n\n\ndef main(argv: list[str]) -> int:\n    if len(argv) != 3:\n        print(\"usage: python -m parcels VALUE WEIGHT_KG COUNTRY\", file=sys.stderr)\n        return 2\n    try:\n        value, weight = Decimal(argv[0]), Decimal(argv[1])\n        cost = shipping_cost(value, weight, argv[2])\n    except (InvalidOperation, CannotShip, ValueError) as exc:\n        print(f\"error: {exc}\", file=sys.stderr)\n        return 2\n    print(f\"shipping: {cost}\")\n    print(f\"arrives: {delivery_date(datetime.now(), argv[2]).isoformat()}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))","lineStart":1,"lineEnd":29,"totalLines":29,"truncated":false}},"title":"parcels/__main__.py","time":{"start":1794860888711,"end":1794860888743}},"id":"prt_1e60bb1f6001MrDhP7k9UC0hbp","sessionID":"ses_e19f4fb81ffeOrjVO5vcAH6pd8","messageID":"msg_1e60ba7950018gp4uK4Ow4Wmqj"}}
