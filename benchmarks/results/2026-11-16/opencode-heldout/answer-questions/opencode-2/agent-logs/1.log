mal(\"31.5\")\nHANDLING_DAYS = 1","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/answer-questions/opencode-2/repo/parcels/settings.py","text":"\"\"\"Settings read from the environment once, at import.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom decimal import Decimal\n\nCARRIERS = (\"dhl\", \"ups\", \"postnl\")\n\nCARRIER = os.environ.get(\"PARCELS_CARRIER\", \"postnl\").lower()\nif CARRIER not in CARRIERS:\n    raise RuntimeError(f\"PARCELS_CARRIER must be one of {', '.join(CARRIERS)}, not {CARRIER!r}\")\n\n# Orders at or above this value (in euros, after discounts) ship for free inside the EU.\nFREE_SHIPPING_FROM = Decimal(os.environ.get(\"PARCELS_FREE_FROM\", \"60.00\"))\n\nMAX_PARCEL_KG = Decimal(\"31.5\")\nHANDLING_DAYS = 1","lineStart":1,"lineEnd":18,"totalLines":18,"truncated":false}},"title":"parcels/settings.py","time":{"start":1794860959478,"end":1794860959489}},"id":"prt_1e60cc6e7001QJSm5J1hRO9UkH","sessionID":"ses_e19f347b3ffeJ3GudIdYaopciD","messageID":"msg_1e60cc2c3001RhnhZ3PA5r9aXg"}}
