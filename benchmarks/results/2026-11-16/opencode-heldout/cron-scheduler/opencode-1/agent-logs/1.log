5-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-1/ws/app/cronlite/__main__.py","text":"\"\"\"Command-line interface for :mod:`cronlite`.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport re\nimport sys\nfrom collections.abc import Sequence\nfrom datetime import datetime\n\nfrom .core import next_run\n\n_AFTER_PATTERN = re.compile(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}\")\n\n\ndef _parse_after(value: str) -> datetime:\n    if not _AFTER_PATTERN.fullmatch(value):\n        raise argparse.ArgumentTypeError(\"must use YYYY-MM-DDTHH:MM\")\n    try:\n        return datetime.fromisoformat(value)\n    except ValueError as error:\n        raise argparse.ArgumentTypeError(str(error)) from error\n\n\ndef _parse_count(value: str) -> int:\n    if not value.isascii() or not value.isdigit() or int(value) < 1:\n        raise argparse.ArgumentTypeError(\"must be a positive integer\")\n    return int(value)\n\n\ndef _parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(\n        prog=\"cronlite\",\n        description=\"Print the next fire times of a cron-like expression.\",\n    )\n    parser.add_argument(\"expression\", metavar=\"EXPRESSION\")\n    parser.add_argument(\n        \"--after\",\n        type=_parse_after,\n        metavar=\"YYYY-MM-DDTHH:MM\",\n        help=\"start searching after this local time (default: now)\",\n    )\n    parser.add_argument(\n        \"--count\",\n        type=_parse_count,\n        metavar=\"N\",\n        default=1,\n        help=\"number of fire times to print (default: 1)\",\n    )\n    return parser\n\n\ndef _format_time(value: datetime) -> str:\n    return (\n        f\"{value.year:04d}-{value.month:02d}-{value.day:02d}\"\n        f\"T{value.hour:02d}:{value.minute:02d}\"\n    )\n\n\ndef main(argv: Sequence[str] | None = None) -> int:\n    parser = _parser()\n    args = parser.parse_args(argv)\n    after = args.after if args.after is not None else datetime.now()\n\n    try:\n        current = after\n        for _ in range(args.count):\n            current = next_run(args.expression, current)\n            print(_format_time(current))\n    except ValueError as error:\n        print(f\"cronlite: {error}\", file=sys.stderr)\n        return 2\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())","lineStart":1,"lineEnd":78,"totalLines":78,"truncated":false}},"title":"private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-1/ws/app/cronlite/__main__.py","time":{"start":1794861429597,"end":1794861429618}},"id":"prt_1e613f26d001hVgvpXaklQk1yw","sessionID":"ses_e19f1b628ffeA9Rtjao9PhgrEh","messageID":"msg_1e613ec07001Qmwr5X0lz7mhGq"}}
