valid(f\"invalid {field} range {text!r}\")\n46: \n47:     start = _parse_number(parts[0], field)\n48:     end = _parse_number(parts[1], field)\n49:     if not minimum <= start <= maximum or not minimum <= end <= maximum:\n50:         raise _invalid(\n51:             f\"{field} value out of range in {text!r}; expected {minimum}-{maximum}\"\n52:         )\n53:     if start > end:\n54:         raise _invalid(f\"reversed {field} range {text!r}\")\n55:     return start, end\n56: \n57: \n58: def _parse_field(text: str, minimum: int, maximum: int, field: str) -> frozenset[int]:\n59:     values: set[int] = set()\n60:     for part in text.split(\",\"):\n61:         if not part:\n62:             raise _invalid(f\"empty {field} part\")\n63: \n64:         if part == \"*\":\n65:             values.update(range(minimum, maximum + 1))\n66:             continue\n67: \n68:         if \"/\" in part:\n69:             base, step_text = part.split(\"/\", 1)\n70:             step = _parse_number(step_text, f\"{field} step\")\n71:             if step == 0:\n72:                 raise _invalid(f\"{field} step must be greater than zero\")\n73: \n74:             if base == \"*\":\n75:                 start, end = minimum, maximum\n76:             elif \"-\" in base:\n77:                 start, end = _parse_range(base, minimum, maximum, field)\n78:             else:\n79:                 raise _invalid(f\"invalid {field} step expression {part!r}\")\n80: \n81:             values.update(range(start, end + 1, step))\n82:             continue\n83: \n84:         if \"-\" in part:\n85:             start, end = _parse_range(part, minimum, maximum, field)\n86:             values.update(range(start, end + 1))\n87:             continue\n88: \n89:         value = _parse_number(part, field)\n90:         if not minimum <= value <= maximum:\n91:             raise _invalid(\n92:                 f\"{field} value out of range in {part!r}; expected {minimum}-{maximum}\"\n93:             )\n94:         values.add(value)\n95: \n96:     return frozenset(values)\n97: \n98: \n99: def _parse_schedule(expression: str) -> _Schedule:\n100:     if not isinstance(expression, str):\n101:         raise _invalid(\"expected a string\")\n102: \n103:     fields = expression.split()\n104:     if len(fields) != 5:\n105:         raise _invalid(\"expected exactly five fields\")\n106: \n107:     parsed = tuple(\n108:         _parse_field(text, minimum, maximum, field)\n109:         for text, (field, minimum, maximum) in zip(fields, _FIELD_RANGES)\n110:     )\n111:     return _Schedule(\n112:         minutes=parsed[0],\n113:         hours=parsed[1],\n114:         days_of_month=parsed[2],\n115:         months=parsed[3],\n116:         days_of_week=parsed[4],\n117:         day_of_month_restricted=fields[2] != \"*\",\n118:         day_of_week_restricted=fields[4] != \"*\",\n119:     )\n120: \n121: \n122: def _add_years(value: datetime, years: int) -> datetime:\n123:     try:\n124:         return value.replace(year=value.year + years)\n125:     except ValueError:\n126:         try:\n127:             return value.replace(year=value.year + years, day=28)\n128:         except ValueError:\n129:             return datetime.max\n130: \n131: \n132: def _day_matches(schedule: _Schedule, day: date) -> bool:\n133:     if day.month not in schedule.months:\n134:         return False\n135: \n136:     day_of_month_matches = day.day in schedule.days_of_month\n137:     cron_day_of_week = (day.weekday() + 1) % 7\n138:     day_of_week_matches = cron_day_of_week in schedule.days_of_week\n139: \n140:     if schedule.day_of_month_restricted and schedule.day_of_week_restricted:\n141:         return day_of_month_matches or day_of_week_matches\n142:     if schedule.day_of_month_restricted:\n143:         return day_of_month_matches\n144:     if schedule.day_of_week_restricted:\n145:         return day_of_week_matches\n146:     return True\n147: \n148: \n149: def _candidate_on(\n150:     schedule: _Schedule,\n151:     day: date,\n152:     first_day: date,\n153:     start: datetime,\n154: ) -> datetime | None:\n155:     hours = sorted(schedule.hours)\n156:     minutes = sorted(schedule.minutes)\n157: \n158:     if day != first_day:\n159:         return datetime.combine(day, time(hours[0], minutes[0]))\n160: \n161:     for hour in hours:\n162:         for minute in minutes:\n163:             candidate = datetime.combine(day, time(hour, minute))\n164:             if candidate >= start:\n165:                 return candidate\n166:     return None\n167: \n168: \n169: def next_run(expression: str, after: datetime) -> datetime:\n170:     \"\"\"Return the first firing time strictly after ``after``.\n171: \n172:     ``after`` must be a timezone-naive datetime. Its seconds and microseconds\n173:     are ignored, and the returned datetime always has both fields set to zero.\n174:     \"\"\"\n175:     schedule = _parse_schedule(expression)\n176:     if not isinstance(after, datetime):\n177:         raise TypeError(\"after must be a datetime\")\n178:     if after.tzinfo is not None or after.utcoffset() is not None:\n179:         raise ValueError(\"after must be timezone-naive\")\n180: \n181:     truncated = after.replace(second=0, microsecond=0)\n182:     try:\n183:         start = truncated + timedelta(minutes=1)\n184:     except OverflowError as error:\n185:         raise ValueError(\"no run found within 8 years\") from error\n186: \n187:     deadline = _add_years(after, 8)\n188:     first_day = start.date()\n189:     last_day = deadline.date()\n190:     day_ordinal = first_day.toordinal()\n191:     last_ordinal = last_day.toordinal()\n192: \n193:     while day_ordinal <= last_ordinal:\n194:         day = date.fromordinal(day_ordinal)\n195:         if _day_matches(schedule, day):\n196:             candidate = _candidate_on(schedule, day, first_day, start)\n197:             if candidate is not None and candidate <= deadline:\n198:                 return candidate\n199:         day_ordinal += 1\n200: \n201:     raise ValueError(\"no run found within 8 years\")\n\n(End of file - total 201 lines)\n</content>","metadata":{"preview":"\"\"\"Expression parsing and next-run calculation for :mod:`cronlite`.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import date, datetime, time, timedelta\nimport re\n\n_FIELD_RANGES = (\n    (\"minute\", 0, 59),\n    (\"hour\", 0, 23),\n    (\"day of month\", 1, 31),\n    (\"month\", 1, 12),\n    (\"day of week\", 0, 6),\n)\n_DIGITS = re.compile(r\"[0-9]+\")\n\n\n@dataclass(frozen=True)\nclass _Schedule:","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-1/ws/app/cronlite/core.py","text":"\"\"\"Expression parsing and next-run calculation for :mod:`cronlite`.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import date, datetime, time, timedelta\nimport re\n\n_FIELD_RANGES = (\n    (\"minute\", 0, 59),\n    (\"hour\", 0, 23),\n    (\"day of month\", 1, 31),\n    (\"month\", 1, 12),\n    (\"day of week\", 0, 6),\n)\n_DIGITS = re.compile(r\"[0-9]+\")\n\n\n@dataclass(frozen=True)\nclass _Schedule:\n    minutes: frozenset[int]\n    hours: frozenset[int]\n    days_of_month: frozenset[int]\n    months: frozenset[int]\n    days_of_week: frozenset[int]\n    day_of_month_restricted: bool\n    day_of_week_restricted: bool\n\n\ndef _invalid(message: str) -> ValueError:\n    return ValueError(f\"invalid cron expression: {message}\")\n\n\ndef _parse_number(text: str, field: str) -> int:\n    if not _DIGITS.fullmatch(text):\n        raise _invalid(f\"invalid {field} value {text!r}\")\n    return int(text)\n\n\ndef _parse_range(\n    text: str, minimum: int, maximum: int, field: str\n) -> tuple[int, int]:\n    parts = text.split(\"-\")\n    if len(parts) != 2:\n        raise _invalid(f\"invalid {field} range {text!r}\")\n\n    start = _parse_number(parts[0], field)\n    end = _parse_number(parts[1], field)\n    if not minimum <= start <= maximum or not minimum <= end <= maximum:\n        raise _invalid(\n            f\"{field} value out of range in {text!r}; expected {minimum}-{maximum}\"\n        )\n    if start > end:\n        raise _invalid(f\"reversed {field} range {text!r}\")\n    return start, end\n\n\ndef _parse_field(text: str, minimum: int, maximum: int, field: str) -> frozenset[int]:\n    values: set[int] = set()\n    for part in text.split(\",\"):\n        if not part:\n            raise _invalid(f\"empty {field} part\")\n\n        if part == \"*\":\n            values.update(range(minimum, maximum + 1))\n            continue\n\n        if \"/\" in part:\n            base, step_text = part.split(\"/\", 1)\n            step = _parse_number(step_text, f\"{field} step\")\n            if step == 0:\n                raise _invalid(f\"{field} step must be greater than zero\")\n\n            if base == \"*\":\n                start, end = minimum, maximum\n            elif \"-\" in base:\n                start, end = _parse_range(base, minimum, maximum, field)\n            else:\n                raise _invalid(f\"invalid {field} step expression {part!r}\")\n\n            values.update(range(start, end + 1, step))\n            continue\n\n        if \"-\" in part:\n            start, end = _parse_range(part, minimum, maximum, field)\n            values.update(range(start, end + 1))\n            continue\n\n        value = _parse_number(part, field)\n        if not minimum <= value <= maximum:\n            raise _invalid(\n                f\"{field} value out of range in {part!r}; expected {minimum}-{maximum}\"\n            )\n        values.add(value)\n\n    return frozenset(values)\n\n\ndef _parse_schedule(expression: str) -> _Schedule:\n    if not isinstance(expression, str):\n        raise _invalid(\"expected a string\")\n\n    fields = expression.split()\n    if len(fields) != 5:\n        raise _invalid(\"expected exactly five fields\")\n\n    parsed = tuple(\n        _parse_field(text, minimum, maximum, field)\n        for text, (field, minimum, maximum) in zip(fields, _FIELD_RANGES)\n    )\n    return _Schedule(\n        minutes=parsed[0],\n        hours=parsed[1],\n        days_of_month=parsed[2],\n        months=parsed[3],\n        days_of_week=parsed[4],\n        day_of_month_restricted=fields[2] != \"*\",\n        day_of_week_restricted=fields[4] != \"*\",\n    )\n\n\ndef _add_years(value: datetime, years: int) -> datetime:\n    try:\n        return value.replace(year=value.year + years)\n    except ValueError:\n        try:\n            return value.replace(year=value.year + years, day=28)\n        except ValueError:\n            return datetime.max\n\n\ndef _day_matches(schedule: _Schedule, day: date) -> bool:\n    if day.month not in schedule.months:\n        return False\n\n    day_of_month_matches = day.day in schedule.days_of_month\n    cron_day_of_week = (day.weekday() + 1) % 7\n    day_of_week_matches = cron_day_of_week in schedule.days_of_week\n\n    if schedule.day_of_month_restricted and schedule.day_of_week_restricted:\n        return day_of_month_matches or day_of_week_matches\n    if schedule.day_of_month_restricted:\n        return day_of_month_matches\n    if schedule.day_of_week_restricted:\n        return day_of_week_matches\n    return True\n\n\ndef _candidate_on(\n    schedule: _Schedule,\n    day: date,\n    first_day: date,\n    start: datetime,\n) -> datetime | None:\n    hours = sorted(schedule.hours)\n    minutes = sorted(schedule.minutes)\n\n    if day != first_day:\n        return datetime.combine(day, time(hours[0], minutes[0]))\n\n    for hour in hours:\n        for minute in minutes:\n            candidate = datetime.combine(day, time(hour, minute))\n            if candidate >= start:\n                return candidate\n    return None\n\n\ndef next_run(expression: str, after: datetime) -> datetime:\n    \"\"\"Return the first firing time strictly after ``after``.\n\n    ``after`` must be a timezone-naive datetime. Its seconds and microseconds\n    are ignored, and the returned datetime always has both fields set to zero.\n    \"\"\"\n    schedule = _parse_schedule(expression)\n    if not isinstance(after, datetime):\n        raise TypeError(\"after must be a datetime\")\n    if after.tzinfo is not None or after.utcoffset() is not None:\n        raise ValueError(\"after must be timezone-naive\")\n\n    truncated = after.replace(second=0, microsecond=0)\n    try:\n        start = truncated + timedelta(minutes=1)\n    except OverflowError as error:\n        raise ValueError(\"no run found within 8 years\") from error\n\n    deadline = _add_years(after, 8)\n    first_day = start.date()\n    last_day = deadline.date()\n    day_ordinal = first_day.toordinal()\n    last_ordinal = last_day.toordinal()\n\n    while day_ordinal <= last_ordinal:\n        day = date.fromordinal(day_ordinal)\n        if _day_matches(schedule, day):\n            candidate = _candidate_on(schedule, day, first_day, start)\n            if candidate is not None and candidate <= deadline:\n                return candidate\n        day_ordinal += 1\n\n    raise ValueError(\"no run found within 8 years\")","lineStart":1,"lineEnd":201,"totalLines":201,"truncated":false}},"title":"private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-1/ws/app/cronlite/core.py","time":{"start":1794861129842,"end":1794861129846}},"id":"prt_1e60f5fb5001orJnQfaX2136ds","sessionID":"ses_e19f1b628ffeA9Rtjao9PhgrEh","messageID":"msg_1e60f54560010hRf2rm1nBB2iz"}}
