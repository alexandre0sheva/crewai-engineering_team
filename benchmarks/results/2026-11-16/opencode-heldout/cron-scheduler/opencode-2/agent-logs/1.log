{"type":"tool_use","timestamp":1794861208668,"sessionID":"ses_e19f1290fffeOm13DSw4yBRd3L","part":{"type":"tool","tool":"write","callID":"call_56194adbd9284a99b30ee604","state":{"status":"completed","input":{"content":"\"\"\"Tests for the cronlite library.\"\"\"\n\nfrom __future__ import annotations\n\nimport unittest\nfrom datetime import date, datetime, timedelta\n\nfrom cronlite import next_run, parse\nfrom cronlite.parser import CronError\n\n\ndef cron_weekday(day: date) -> int:\n    \"\"\"Cron day of week (0 == Sunday) of a :class:`datetime.date`.\"\"\"\n    return (day.weekday() + 1) % 7\n\n\nclass ParsingTests(unittest.TestCase):\n    def test_star_expands_to_the_whole_field(self):\n        expression = parse(\"* * * * *\")\n        self.assertEqual(set(expression.minute.values), set(range(60)))\n        self.assertEqual(set(expression.hour.values), set(range(24)))\n        self.assertEqual(set(expression.day_of_month.values), set(range(1, 32)))\n        self.assertEqual(set(expression.month.values), set(range(1, 13)))\n        self.assertEqual(set(expression.day_of_week.values), set(range(7)))\n\n    def test_single_values(self):\n        expression = parse(\"0 12 15 6 3\")\n        self.assertEqual(set(expression.minute.values), {0})\n        self.assertEqual(set(expression.hour.values), {12})\n        self.assertEqual(set(expression.day_of_month.values), {15})\n        self.assertEqual(set(expression.month.values), {6})\n        self.assertEqual(set(expression.day_of_week.values), {3})\n\n    def test_ranges_are_inclusive(self):\n        expression = parse(\"10-13 * * * *\")\n        self.assertEqual(set(expression.minute.values), {10, 11, 12, 13})\n\n    def test_lists_are_unioned(self):\n        expression = parse(\"0,15,30,45 * * * *\")\n        self.assertEqual(set(expression.minute.values), {0, 15, 30, 45})\n\n    def test_step_over_the_whole_field(self):\n        expression = parse(\"*/15 * * * *\")\n        self.assertEqual(set(expression.minute.values), {0, 15, 30, 45})\n        expression = parse(\"0 */6 * * *\")\n        self.assertEqual(set(expression.hour.values), {0, 6, 12, 18})\n\n    def test_step_over_a_range_starts_at_the_range_start(self):\n        expression = parse(\"5-20/5 * * * *\")\n        self.assertEqual(set(expression.minute.values), {5, 10, 15, 20})\n\n    def test_step_over_a_range_ignores_values_before_the_start(self):\n        expression = parse(\"7-13/3 * * * *\")\n        self.assertEqual(set(expression.minute.values), {7, 10, 13})\n\n    def test_step_larger_than_the_range_yields_the_first_value(self):\n        expression = parse(\"*/100 * * * *\")\n        self.assertEqual(set(expression.minute.values), {0})\n\n    def test_whitespace_between_fields_is_flexible(self):\n        expression = parse(\"  0\\t12  *  *   *  \")\n        self.assertEqual(set(expression.hour.values), {12})\n\n    def test_invalid_expressions_raise_value_error(self):\n        invalid = [\n            \"\",\n            \"   \",\n            \"*\",\n            \"* * * *\",\n            \"* * * * * *\",\n            \"60 * * * *\",\n            \"* 24 * * *\",\n            \"* * 0 * *\",\n            \"* * 32 * *\",\n            \"* * * 0 *\",\n            \"* * * 13 *\",\n            \"* * * * 7\",\n            \"* * * * -1\",\n            \"5-1 * * * *\",\n            \"*/0 * * * *\",\n            \"0-30/0 * * * *\",\n            \"abc * * * *\",\n            \"* * * * MON\",\n            \"1, * * * *\",\n            \"1,,2 * * * *\",\n            \"1- * * * *\",\n            \"-5 * * * *\",\n            \"1-2-3 * * * *\",\n            \"1/2 * * * *\",\n            \"* * * * */0\",\n            \"*/ * * * *\",\n            \"1/2/3 * * * *\",\n            \"+1 * * * *\",\n            \"1.5 * * * *\",\n            \"0 0 30 2 *\",\n            \"0 0 31 4 *\",\n            \"0 0 31 2 *\",\n        ]\n        for expression in invalid:\n            with self.subTest(expression=expression):\n                with self.assertRaises(ValueError):\n                    parse(expression)\n                with self.assertRaises(ValueError):\n                    next_run(expression, datetime(2026, 1, 1))\n\n    def test_cron_error_is_a_value_error(self):\n        self.assertTrue(issubclass(CronError, ValueError))\n\n    def test_expression_must_be_a_string(self):\n        with self.assertRaises(ValueError):\n            parse(42)  # type: ignore[arg-type]\n\n\nclass NextRunTests(unittest.TestCase):\n    def test_every_minute(self):\n        self.assertEqual(\n            next_run(\"* * * * *\", datetime(2026, 1, 1, 0, 0)),\n            datetime(2026, 1, 1, 0, 1),\n        )\n\n    def test_result_is_strictly_after_the_given_moment(self):\n        after = datetime(2026, 1, 1, 12, 0)\n        self.assertEqual(\n            next_run(\"0 12 * * *\", after),\n            datetime(2026, 1, 2, 12, 0),\n        )\n\n    def test_seconds_and_microseconds_are_ignored(self):\n        after = datetime(2026, 1, 1, 12, 0, 30, 500)\n        self.assertEqual(\n            next_run(\"* * * * *\", after),\n            datetime(2026, 1, 1, 12, 1),\n        )\n\n    def test_result_has_zero_seconds_and_microseconds(self):\n        result = next_run(\"* * * * *\", datetime(2026, 1, 1, 12, 0, 45, 123))\n        self.assertEqual(result.second, 0)\n        self.assertEqual(result.microsecond, 0)\n\n    def test_daily_at_a_fixed_time(self):\n        self.assertEqual(\n            next_run(\"30 2 * * *\", datetime(2026, 3, 4, 5, 0)),\n            datetime(2026, 3, 5, 2, 30),\n        )\n\n    def test_rolls_over_to_the_next_month(self):\n        self.assertEqual(\n            next_run(\"0 0 1 * *\", datetime(2026, 1, 15, 12, 0)),\n            datetime(2026, 2, 1, 0, 0),\n        )\n\n    def test_rolls_over_to_the_next_year(self):\n        self.assertEqual(\n            next_run(\"0 0 1 1 *\", datetime(2026, 6, 15, 12, 0)),\n            datetime(2027, 1, 1, 0, 0),\n        )\n\n    def test_step_values(self):\n        self.assertEqual(\n            next_run(\"*/15 * * * *\", datetime(2026, 1, 1, 10, 7)),\n            datetime(2026, 1, 1, 10, 15),\n        )\n        self.assertEqual(\n            next_run(\"*/15 * * * *\", datetime(2026, 1, 1, 10, 46)),\n            datetime(2026, 1, 1, 11, 0),\n        )\n\n    def test_weekdays_only(self):\n        # 2026-01-01 is a Thursday, 2026-01-03 is a Saturday.\n        self.assertEqual(\n            next_run(\"0 9 * * 1-5\", datetime(2026, 1, 2, 12, 0)),\n            datetime(2026, 1, 5, 9, 0),\n        )\n\n    def test_sunday_is_zero(self):\n        # 2026-01-04 is a Sunday.\n        self.assertEqual(\n            next_run(\"0 0 * * 0\", datetime(2026, 1, 1)),\n            datetime(2026, 1, 4, 0, 0),\n        )\n\n    def test_saturday_is_six(self):\n        # 2026-01-03 is a Saturday.\n        self.assertEqual(\n            next_run(\"0 0 * * 6\", datetime(2026, 1, 1)),\n            datetime(2026, 1, 3, 0, 0),\n        )\n\n    def test_leap_day(self):\n        self.assertEqual(\n            next_run(\"0 0 29 2 *\", datetime(2026, 11, 16, 22, 31)),\n            datetime(2028, 2, 29, 0, 0),\n        )\n\n    def test_february_30_never_fires(self):\n        with self.assertRaises(ValueError):\n            next_run(\"0 0 30 2 *\", datetime(2026, 1, 1))\n\n    def test_april_31_never_fires(self):\n        with self.assertRaises(ValueError):\n            next_run(\"0 0 31 4 *\", datetime(2026, 1, 1))\n\n    def test_aware_datetimes_are_rejected(self):\n        with self.assertRaises(ValueError):\n            next_run(\n                \"* * * * *\",\n                datetime(2026, 1, 1, tzinfo=datetime.now().astimezone().tzinfo),\n            )\n\n    def test_non_datetime_is_rejected(self):\n        with self.assertRaises(TypeError):\n            next_run(\"* * * * *\", \"2026-01-01\")  # type: ignore[arg-type]\n\n    def test_consecutive_runs_are_strictly_increasing(self):\n        moment = datetime(2026, 1, 1)\n        previous = moment\n        for _ in range(20):\n            previous = next_run(\"*/10 * * * *\", previous)\n            self.assertGreater(previous, moment)\n\n\nclass DayCombinationTests(unittest.TestCase):\n    \"\"\"Day of month and day of week combine the classic cron way.\"\"\"\n\n    def _firing_days(self, expression: str, start: date, count: int) -> list[date]:\n        days: list[date] = []\n        moment = datetime(start.year, start.month, start.day)\n        for _ in range(count):\n            moment = next_run(expression, moment)\n            days.append(moment.date())\n        return days\n\n    def test_unrestricted_day_of_month_uses_day_of_week(self):\n        days = self._firing_days(\"0 0 * * 1\", date(2026, 1, 1), 3)\n        self.assertEqual(\n            days,\n            [date(2026, 1, 5), date(2026, 1, 12), date(2026, 1, 19)],\n        )\n        for day in days:\n            self.assertEqual(cron_weekday(day), 1)\n\n    def test_unrestricted_day_of_week_uses_day_of_month(self):\n        days = self._firing_days(\"0 0 13 * *\", date(2026, 1, 1), 3)\n        self.assertEqual(\n            days,\n            [date(2026, 1, 13), date(2026, 2, 13), date(2026, 3, 13)],\n        )\n\n    def test_both_restricted_matches_either(self):\n        # The 13th of the month *or* any Friday.\n        days = self._firing_days(\"0 0 13 * 5\", date(2026, 1, 1), 4)\n        self.assertEqual(\n            days,\n            [date(2026, 1, 2), date(2026, 1, 9), date(2026, 1, 13), date(2026, 1, 16)],\n        )\n        for day in days:\n            self.assertTrue(day.day == 13 or cron_weekday(day) == 5)\n\n    def test_both_unrestricted_matches_every_day(self):\n        days = self._firing_days(\"0 0 * * *\", date(2026, 1, 1), 3)\n        self.assertEqual(\n            days,\n            [date(2026, 1, 2), date(2026, 1, 3), date(2026, 1, 4)],\n        )\n\n    def test_day_of_week_range(self):\n        days = self._firing_days(\"0 0 * * 1-5\", date(2026, 1, 3), 1)\n        self.assertEqual(days, [date(2026, 1, 5)])\n        self.assertEqual(cron_weekday(days[0]), 1)\n\n\nclass BruteForceTests(unittest.TestCase):\n    \"\"\"Compare the fast search against a naive minute by minute scan.\"\"\"\n\n    EXPRESSIONS = [\n        \"* * * * *\",\n        \"0 * * * *\",\n        \"*/15 * * * *\",\n        \"30 2 * * *\",\n        \"0 0 * * *\",\n        \"0 12 * * 1-5\",\n        \"15 10 * * 0\",\n        \"0 9 1 * *\",\n        \"0 0 29 2 *\",\n        \"*/5 8-18 * * 1-5\",\n        \"0 0 13 * 5\",\n        \"45 23 31 12 *\",\n        \"0,30 0,12 * * *\",\n        \"7 7 7 7 7\",\n    ]\n\n    def _matches(self, expression: str, moment: datetime) -> bool:\n        parsed = parse(expression)\n        if moment.minute not in parsed.minute.values:\n            return False\n        if moment.hour not in parsed.hour.values:\n            return False\n        if moment.month not in parsed.month.values:\n            return False\n        dom_ok = moment.day in parsed.day_of_month.values\n        dow_ok = cron_weekday(moment.date()) in parsed.day_of_week.values\n        dom_restricted = parsed.day_of_month_restricted\n        dow_restricted = parsed.day_of_week_restricted\n        if dom_restricted and dow_restricted:\n            return dom_ok or dow_ok\n        if dom_restricted:\n            return dom_ok\n        if dow_restricted:\n            return dow_ok\n        return True\n\n    def _brute_force(self, expression: str, after: datetime) -> datetime:\n        moment = after.replace(second=0, microsecond=0) + timedelta(minutes=1)\n        for _ in range(400 * 24 * 60):\n            if self._matches(expression, moment):\n                return moment\n            moment += timedelta(minutes=1)\n        raise AssertionError(f\"{expression!r} did not fire during the scan\")\n\n    def test_matches_the_brute_force_scan(self):\n        after = datetime(2026, 1, 1, 0, 0)\n        for expression in self.EXPRESSIONS:\n            with self.subTest(expression=expression):\n                self.assertEqual(\n                    next_run(expression, after),\n                    self._brute_force(expression, after),\n                )\n\n    def test_matches_the_brute_force_scan_from_other_moments(self):\n        for after in (\n            datetime(2026, 6, 15, 13, 37),\n            datetime(2027, 12, 31, 23, 59),\n            datetime(2028, 2, 28, 23, 59),\n        ):\n            for expression in self.EXPRESSIONS:\n                with self.subTest(expression=expression, after=after):\n                    self.assertEqual(\n                        next_run(expression, after),\n                        self._brute_force(expression, after),\n                    )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","filePath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/tests/test_cronlite.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/tests/test_cronlite.py","exists":false,"truncated":false},"title":"private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/tests/test_cronlite.py","time":{"start":1794861208594,"end":1794861208625}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1e61091b0001ZTIv6WNdQyiMDi","sessionID":"ses_e19f1290fffeOm13DSw4yBRd3L","messageID":"msg_1e61058da0014yVHYOjhHU5yc0"}}
