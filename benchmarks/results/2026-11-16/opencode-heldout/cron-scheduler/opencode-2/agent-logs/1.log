{"type":"tool_use","timestamp":1794861349447,"sessionID":"ses_e19f1290fffeOm13DSw4yBRd3L","part":{"type":"tool","tool":"read","callID":"call_d7360e8629f64431b9686db8","state":{"status":"completed","input":{"filePath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/cronlite/schedule.py"},"output":"<path>/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/cronlite/schedule.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Computation of the next firing time of a cron expression.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import calendar\n6: from datetime import date, datetime, timedelta\n7: \n8: from .parser import CronError, Expression, parse\n9: \n10: __all__ = [\"MAX_YEARS_AHEAD\", \"Schedule\"]\n11: \n12: #: How far ahead the search for the next firing time reaches.\n13: MAX_YEARS_AHEAD = 8\n14: \n15: \n16: def _add_years(moment: datetime, years: int) -> datetime:\n17:     \"\"\"Return *moment* shifted by *years* years, clamping Feb 29 to Feb 28.\"\"\"\n18:     year = moment.year + years\n19:     day = min(moment.day, calendar.monthrange(year, moment.month)[1])\n20:     return moment.replace(year=year, day=day)\n21: \n22: \n23: def _cron_weekday(day: date) -> int:\n24:     \"\"\"Return the cron day of week of *day* (0 == Sunday).\"\"\"\n25:     return (day.weekday() + 1) % 7\n26: \n27: \n28: def _start_of_next_day(moment: datetime) -> datetime:\n29:     return moment.replace(hour=0, minute=0) + timedelta(days=1)\n30: \n31: \n32: class Schedule:\n33:     \"\"\"A parsed cron expression that can compute its next firing times.\"\"\"\n34: \n35:     def __init__(self, expression: Expression) -> None:\n36:         self._expression = expression\n37:         self._minutes = tuple(sorted(expression.minute.values))\n38:         self._hours = tuple(sorted(expression.hour.values))\n39:         self._months = tuple(sorted(expression.month.values))\n40:         self._dom_restricted = expression.day_of_month_restricted\n41:         self._dow_restricted = expression.day_of_week_restricted\n42: \n43:     @classmethod\n44:     def parse(cls, expression: str) -> Schedule:\n45:         \"\"\"Parse *expression* into a :class:`Schedule`.\"\"\"\n46:         return cls(parse(expression))\n47: \n48:     # -- matching ---------------------------------------------------------\n49: \n50:     def _matches_day(self, day: date) -> bool:\n51:         \"\"\"Apply the classic cron day of month / day of week combination.\"\"\"\n52:         day_of_month_ok = day.day in self._expression.day_of_month.values\n53:         day_of_week_ok = _cron_weekday(day) in self._expression.day_of_week.values\n54: \n55:         if self._dom_restricted and self._dow_restricted:\n56:             # Both restricted: either one may select the day.\n57:             return day_of_month_ok or day_of_week_ok\n58:         if self._dom_restricted:\n59:             # The day of week field is \"*\", so only the day of month counts.\n60:             return day_of_month_ok\n61:         if self._dow_restricted:\n62:             # The day of month field is \"*\", so only the day of week counts.\n63:             return day_of_week_ok\n64:         return True\n65: \n66:     def _next_month_start(self, moment: datetime) -> datetime:\n67:         \"\"\"Return midnight of the first day of the next matching month.\"\"\"\n68:         for month in self._months:\n69:             if month > moment.month:\n70:                 return datetime(moment.year, month, 1)\n71:         first = self._months[0]\n72:         return datetime(moment.year + 1, first, 1)\n73: \n74:     @staticmethod\n75:     def _next_above(values: tuple[int, ...], current: int) -> int | None:\n76:         for value in values:\n77:             if value > current:\n78:                 return value\n79:         return None\n80: \n81:     # -- public API -------------------------------------------------------\n82: \n83:     def next_after(self, after: datetime) -> datetime:\n84:         \"\"\"Return the first firing time strictly after *after*.\"\"\"\n85:         if not isinstance(after, datetime):\n86:             raise TypeError(\n87:                 f\"'after' must be a datetime, got {type(after).__name__}\"\n88:             )\n89:         if after.tzinfo is not None:\n90:             raise ValueError(\"'after' must be a naive datetime without time zone\")\n91: \n92:         current = after.replace(second=0, microsecond=0) + timedelta(minutes=1)\n93:         limit = _add_years(current, MAX_YEARS_AHEAD)\n94: \n95:         while current <= limit:\n96:             if current.month not in self._expression.month.values:\n97:                 current = self._next_month_start(current)\n98:                 continue\n99: \n100:             if not self._matches_day(current.date()):\n101:                 current = _start_of_next_day(current)\n102:                 continue\n103: \n104:             if current.hour not in self._expression.hour.values:\n105:                 next_hour = self._next_above(self._hours, current.hour)\n106:                 if next_hour is not None:\n107:                     current = current.replace(hour=next_hour, minute=0)\n108:                     continue\n109:                 current = _start_of_next_day(current)\n110:                 continue\n111: \n112:             if current.minute not in self._expression.minute.values:\n113:                 next_minute = self._next_above(self._minutes, current.minute)\n114:                 if next_minute is not None:\n115:                     current = current.replace(minute=next_minute)\n116:                     continue\n117:                 next_hour = self._next_above(self._hours, current.hour)\n118:                 if next_hour is not None:\n119:                     curre