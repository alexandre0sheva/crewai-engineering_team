{"type":"tool_use","timestamp":1794861176030,"sessionID":"ses_e19f1290fffeOm13DSw4yBRd3L","part":{"type":"tool","tool":"write","callID":"call_3fc5a403caef4d6ab9bafdea","state":{"status":"completed","input":{"content":"\"\"\"Computation of the next firing time of a cron expression.\"\"\"\n\nfrom __future__ import annotations\n\nimport calendar\nfrom datetime import date, datetime, timedelta\nfrom typing import Optional\n\nfrom .parser import CronError, Expression, parse\n\n__all__ = [\"Schedule\", \"MAX_YEARS_AHEAD\"]\n\n#: How far ahead the search for the next firing time reaches.\nMAX_YEARS_AHEAD = 8\n\n\ndef _add_years(moment: datetime, years: int) -> datetime:\n    \"\"\"Return *moment* shifted by *years* years, clamping Feb 29 to Feb 28.\"\"\"\n    year = moment.year + years\n    day = min(moment.day, calendar.monthrange(year, moment.month)[1])\n    return moment.replace(year=year, day=day)\n\n\ndef _cron_weekday(day: date) -> int:\n    \"\"\"Return the cron day of week of *day* (0 == Sunday).\"\"\"\n    return (day.weekday() + 1) % 7\n\n\ndef _start_of_next_day(moment: datetime) -> datetime:\n    return moment.replace(hour=0, minute=0) + timedelta(days=1)\n\n\nclass Schedule:\n    \"\"\"A parsed cron expression that can compute its next firing times.\"\"\"\n\n    def __init__(self, expression: Expression) -> None:\n        self._expression = expression\n        self._minutes = tuple(sorted(expression.minute.values))\n        self._hours = tuple(sorted(expression.hour.values))\n        self._months = tuple(sorted(expression.month.values))\n        self._dom_restricted = expression.day_of_month_restricted\n        self._dow_restricted = expression.day_of_week_restricted\n\n    @classmethod\n    def parse(cls, expression: str) -> \"Schedule\":\n        \"\"\"Parse *expression* into a :class:`Schedule`.\"\"\"\n        return cls(parse(expression))\n\n    # -- matching ---------------------------------------------------------\n\n    def _matches_day(self, day: date) -> bool:\n        \"\"\"Apply the classic cron day of month / day of week combination.\"\"\"\n        day_of_month_ok = day.day in self._expression.day_of_month.values\n        day_of_week_ok = _cron_weekday(day) in self._expression.day_of_week.values\n\n        if self._dom_restricted and self._dow_restricted:\n            # Both restricted: either one may select the day.\n            return day_of_month_ok or day_of_week_ok\n        if self._dom_restricted:\n            return day_of_week_ok\n        if self._dow_restricted:\n            return day_of_month_ok\n        return True\n\n    def _next_month_start(self, moment: datetime) -> datetime:\n        \"\"\"Return midnight of the first day of the next matching month.\"\"\"\n        for month in self._months:\n            if month > moment.month:\n                return datetime(moment.year, month, 1)\n        first = self._months[0]\n        return datetime(moment.year + 1, first, 1)\n\n    @staticmethod\n    def _next_above(values: tuple[int, ...], current: int) -> Optional[int]:\n        for value in values:\n            if value > current:\n                return value\n        return None\n\n    # -- public API -------------------------------------------------------\n\n    def next_after(self, after: datetime) -> datetime:\n        \"\"\"Return the first firing time strictly after *after*.\"\"\"\n        if not isinstance(after, datetime):\n            raise TypeError(\n                f\"'after' must be a datetime, got {type(after).__name__}\"\n            )\n        if after.tzinfo is not None:\n            raise ValueError(\"'after' must be a naive datetime without time zone\")\n\n        current = after.replace(second=0, microsecond=0) + timedelta(minutes=1)\n        limit = _add_years(current, MAX_YEARS_AHEAD)\n\n        while current <= limit:\n            if current.month not in self._expression.month.values:\n                current = self._next_month_start(current)\n                continue\n\n            if not self._matches_day(current.date()):\n                current = _start_of_next_day(current)\n                continue\n\n            if current.hour not in self._expression.hour.values:\n                next_hour = self._next_above(self._hours, current.hour)\n                if next_hour is not None:\n                    current = current.replace(hour=next_hour, minute=0)\n                    continue\n                current = _start_of_next_day(current)\n                continue\n\n            if current.minute not in self._expression.minute.values:\n                next_minute = self._next_above(self._minutes, current.minute)\n                if next_minute is not None:\n                    current = current.replace(minute=next_minute)\n                    continue\n                next_hour = self._next_above(self._hours, current.hour)\n                if next_hour is not None:\n                    current = current.replace(hour=next_hour, minute=0)\n                    continue\n                current = _start_of_next_day(current)\n                continue\n\n            return current\n\n        raise CronError(\n            f\"expression does not fire within {MAX_YEARS_AHEAD} years \"\n            f\"after {after.isoformat(sep=' ')}\"\n        )\n","filePath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/cronlite/schedule.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/cronlite/schedule.py","exists":false,"truncated":false},"title":"private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/cronlite/schedule.py","time":{"start":1794861176008,"end":1794861176017}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now schedule.py with the next-fire computation.\n\nNote: the `Field.next_above` sorts each call — inefficient in a loop. Let me precompute sorted tuples in the Schedule class instead.\n\nLet me write schedule.py.","format":"unknown","index":0}]}},"id":"prt_1e61013ef001k4WlI8Y4j9e0AI","sessionID":"ses_e19f1290fffeOm13DSw4yBRd3L","messageID":"msg_1e60ff0da001hgTc187nKopxLx"}}
