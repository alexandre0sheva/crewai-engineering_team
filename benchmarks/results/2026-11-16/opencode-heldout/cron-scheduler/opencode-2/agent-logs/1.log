gparse.ArgumentParser:\n43:     parser = argparse.ArgumentParser(\n44:         prog=\"python -m cronlite\",\n45:         description=\"Print the next firing times of a cron expression.\",\n46:     )\n47:     parser.add_argument(\n48:         \"expression\",\n49:         metavar=\"EXPRESSION\",\n50:         help=\"five field cron expression, e.g. '*/15 9-17 * * 1-5'\",\n51:     )\n52:     parser.add_argument(\n53:         \"--after\",\n54:         type=_after_value,\n55:         default=None,\n56:         metavar=\"YYYY-MM-DDTHH:MM\",\n57:         help=\"compute the firing times after this moment (default: now)\",\n58:     )\n59:     parser.add_argument(\n60:         \"--count\",\n61:         type=_count_value,\n62:         default=1,\n63:         metavar=\"N\",\n64:         help=\"number of firing times to print (default: 1)\",\n65:     )\n66:     return parser\n67: \n68: \n69: def main(argv: Sequence[str] | None = None) -> int:\n70:     \"\"\"Run the command line interface, returning the process exit status.\"\"\"\n71:     parser = build_parser()\n72:     args = parser.parse_args(argv)\n73: \n74:     after = args.after if args.after is not None else datetime.now()\n75: \n76:     try:\n77:         schedule = Schedule.parse(args.expression)\n78:         for _ in range(args.count):\n79:             after = schedule.next_after(after)\n80:             print(after.strftime(_TIME_FORMAT))\n81:     except (CronError, ValueError) as exc:\n82:         print(f\"error: {exc}\", file=sys.stderr)\n83:         return 2\n84: \n85:     return 0\n86: \n87: \n88: if __name__ == \"__main__\":\n89:     sys.exit(main())\n\n(End of file - total 89 lines)\n</content>","metadata":{"preview":"\"\"\"Command line interface: ``python -m cronlite \"EXPRESSION\" [--after ...] [--count N]``.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport sys\nfrom collections.abc import Sequence\nfrom datetime import datetime\n\nfrom .parser import CronError\nfrom .schedule import Schedule\n\n__all__ = [\"main\"]\n\n_TIME_FORMAT = \"%Y-%m-%dT%H:%M\"\n_AFTER_FORMATS = (\"%Y-%m-%dT%H:%M\", \"%Y-%m-%d %H:%M\")\n\n\ndef _after_value(text: str) -> datetime:\n    \"\"\"argparse type for ``--after``.\"\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/cronlite/__main__.py","text":"\"\"\"Command line interface: ``python -m cronlite \"EXPRESSION\" [--after ...] [--count N]``.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport sys\nfrom collections.abc import Sequence\nfrom datetime import datetime\n\nfrom .parser import CronError\nfrom .schedule import Schedule\n\n__all__ = [\"main\"]\n\n_TIME_FORMAT = \"%Y-%m-%dT%H:%M\"\n_AFTER_FORMATS = (\"%Y-%m-%dT%H:%M\", \"%Y-%m-%d %H:%M\")\n\n\ndef _after_value(text: str) -> datetime:\n    \"\"\"argparse type for ``--after``.\"\"\"\n    for fmt in _AFTER_FORMATS:\n        try:\n            return datetime.strptime(text, fmt)\n        except ValueError:\n            continue\n    raise argparse.ArgumentTypeError(\n        f\"invalid --after value: {text!r} (expected YYYY-MM-DDTHH:MM)\"\n    )\n\n\ndef _count_value(text: str) -> int:\n    \"\"\"argparse type for ``--count``.\"\"\"\n    try:\n        count = int(text)\n    except ValueError:\n        raise argparse.ArgumentTypeError(f\"invalid --count value: {text!r}\") from None\n    if count < 0:\n        raise argparse.ArgumentTypeError(f\"invalid --count value: {text!r}\")\n    return count\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(\n        prog=\"python -m cronlite\",\n        description=\"Print the next firing times of a cron expression.\",\n    )\n    parser.add_argument(\n        \"expression\",\n        metavar=\"EXPRESSION\",\n        help=\"five field cron expression, e.g. '*/15 9-17 * * 1-5'\",\n    )\n    parser.add_argument(\n        \"--after\",\n        type=_after_value,\n        default=None,\n        metavar=\"YYYY-MM-DDTHH:MM\",\n        help=\"compute the firing times after this moment (default: now)\",\n    )\n    parser.add_argument(\n        \"--count\",\n        type=_count_value,\n        default=1,\n        metavar=\"N\",\n        help=\"number of firing times to print (default: 1)\",\n    )\n    return parser\n\n\ndef main(argv: Sequence[str] | None = None) -> int:\n    \"\"\"Run the command line interface, returning the process exit status.\"\"\"\n    parser = build_parser()\n    args = parser.parse_args(argv)\n\n    after = args.after if args.after is not None else datetime.now()\n\n    try:\n        schedule = Schedule.parse(args.expression)\n        for _ in range(args.count):\n            after = schedule.next_after(after)\n            print(after.strftime(_TIME_FORMAT))\n    except (CronError, ValueError) as exc:\n        print(f\"error: {exc}\", file=sys.stderr)\n        return 2\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())","lineStart":1,"lineEnd":89,"totalLines":89,"truncated":false}},"title":"private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/cron-scheduler/opencode-2/ws/app/cronlite/__main__.py","time":{"start":1794861358325,"end":1794861358354}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1e612dc1a001YlUOVQqzk5Ws1Y","sessionID":"ses_e19f1290fffeOm13DSw4yBRd3L","messageID":"msg_1e612d7da001WJ6696rQVMGUO7"}}
