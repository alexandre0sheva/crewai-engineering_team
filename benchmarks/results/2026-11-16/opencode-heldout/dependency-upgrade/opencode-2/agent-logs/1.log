):\n            parse_line(\"no amount\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/dependency-upgrade/opencode-2/repo/tests/test_totals.py","text":"import unittest\n\nfrom invoicer.totals import InvoiceError, parse_line, render\n\n\nclass TotalsTest(unittest.TestCase):\n    def test_render(self):\n        lines = [parse_line(\"Design=1,200.00\"), parse_line(\"Hosting=€49.99\")]\n        self.assertEqual(render(lines)[-1], \"Total                        €1,249.99\")\n\n    def test_bad_lines(self):\n        with self.assertRaisesRegex(InvoiceError, \"cannot read amount\"):\n            parse_line(\"Design=lots\")\n        with self.assertRaisesRegex(InvoiceError, \"DESCRIPTION=AMOUNT\"):\n            parse_line(\"no amount\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()","lineStart":1,"lineEnd":19,"totalLines":19,"truncated":false}},"title":"tests/test_totals.py","time":{"start":1794861513772,"end":1794861515175}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1e6153b0f001EsyHBb0cQ5QCDX","sessionID":"ses_e19eaf816ffeLK63YQCC74Krze","messageID":"msg_1e61536150011uXLFqOuQInCDU"}}
