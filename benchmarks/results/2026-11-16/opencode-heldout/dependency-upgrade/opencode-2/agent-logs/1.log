        print(f\"error: {exc}\", file=sys.stderr)\n        return 2\n    for row in render(lines):\n        print(row)","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/dependency-upgrade/opencode-2/repo/invoicer/__main__.py","text":"\"\"\"``python -m invoicer \"Design=1,200.00\" \"Hosting=49.99\" ...``: the invoice lines and total.\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\n\nfrom invoicer.totals import InvoiceError, parse_line, render\n\n\ndef main(argv: list[str]) -> int:\n    if not argv:\n        print('usage: python -m invoicer \"DESCRIPTION=AMOUNT\" ...', file=sys.stderr)\n        return 2\n    try:\n        lines = [parse_line(arg) for arg in argv]\n    except InvoiceError as exc:\n        print(f\"error: {exc}\", file=sys.stderr)\n        return 2\n    for row in render(lines):\n        print(row)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))","lineStart":1,"lineEnd":25,"totalLines":25,"truncated":false}},"title":"invoicer/__main__.py","time":{"start":1794861512052,"end":1794861512058}},"id":"prt_1e61534b60012ws2TloVjCVjrV","sessionID":"ses_e19eaf816ffeLK63YQCC74Krze","messageID":"msg_1e615300c001oZYilPipcLlMSg"}}
