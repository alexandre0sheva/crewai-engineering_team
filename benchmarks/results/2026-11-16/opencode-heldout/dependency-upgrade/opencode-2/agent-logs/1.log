{"type":"tool_use","timestamp":1794861510484,"sessionID":"ses_e19eaf816ffeLK63YQCC74Krze","part":{"type":"tool","tool":"read","callID":"call_11a05cf944864f79aa531c5e","state":{"status":"completed","input":{"filePath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/dependency-upgrade/opencode-2/repo/vendor-updates/moneyfmt-2.0.0/moneyfmt/__init__.py"},"output":"<path>/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/dependency-upgrade/opencode-2/repo/vendor-updates/moneyfmt-2.0.0/moneyfmt/__init__.py</path>\n<type>file</type>\n<content>\n1: \"\"\"moneyfmt 2.0.0: format and parse money amounts, as Decimal only.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: from decimal import ROUND_HALF_UP, Decimal, InvalidOperation\n6: \n7: __version__ = \"2.0.0\"\n8: __all__ = [\"CURRENCIES\", \"MoneyFormatError\", \"format_money\", \"parse_money\"]\n9: \n10: CURRENCIES = {\"EUR\": \"€\", \"USD\": \"$\", \"GBP\": \"£\", \"CHF\": \"CHF \"}\n11: \n12: \n13: class MoneyFormatError(ValueError):\n14:     \"\"\"An amount that cannot be read, or a currency that is not known.\"\"\"\n15: \n16: \n17: def format_money(amount: Decimal, *, currency: str, grouping: bool = True) -> str:\n18:     \"\"\"``format_money(Decimal(\"1234.5\"), currency=\"EUR\")`` -> ``\"€1,234.50\"``.\"\"\"\n19: \n20:     if not isinstance(amount, Decimal):\n21:         raise TypeError(f\"format_money takes a Decimal, not {type(amount).__name__}\")\n22:     if currency not in CURRENCIES:\n23:         raise MoneyFormatError(f\"unknown currency {currency!r}\")\n24:     value = amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n25:     sign = \"-\" if value < 0 else \"\"\n26:     number = f\"{abs(value):,.2f}\" if grouping else f\"{abs(value):.2f}\"\n27:     return f\"{sign}{CURRENCIES[currency]}{number}\"\n28: \n29: \n30: def parse_money(text: str) -> Decimal:\n31:     \"\"\"``parse_money(\"1,234.50\")`` -> ``Decimal(\"1234.50\")``; currency symbols are ignored.\"\"\"\n32: \n33:     cleaned = text.strip()\n34:     for symbol in CURRENCIES.values():\n35:         cleaned = cleaned.replace(symbol.strip(), \"\")\n36:     cleaned = cleaned.replace(\",\", \"\").strip()\n37:     try:\n38:         value = Decimal(cleaned)\n39:     except InvalidOperation:\n40:         raise MoneyFormatError(f\"cannot read amount {text!r}\") from None\n41:     if not value.is_finite():\n42:         raise MoneyFormatError(f\"cannot read amount {text!r}\")\n43:     return value\n\n(End of file - total 43 lines)\n</content>","metadata":{"preview":"\"\"\"moneyfmt 2.0.0: format and parse money amounts, as Decimal only.\"\"\"\n\nfrom __future__ import annotations\n\nfrom decimal import ROUND_HALF_UP, Decimal, InvalidOperation\n\n__version__ = \"2.0.0\"\n__all__ = [\"CURRENCIES\", \"MoneyFormatError\", \"format_money\", \"parse_money\"]\n\nCURRENCIES = {\"EUR\": \"€\", \"USD\": \"$\", \"GBP\": \"£\", \"CHF\": \"CHF \"}\n\n\nclass MoneyFormatError(ValueError):\n    \"\"\"An amount that cannot be read, or a currency that is not known.\"\"\"\n\n\ndef format_money(amount: Decimal, *, currency: str, grouping: bool = True) -> str:\n    \"\"\"``format_money(Decimal(\"1234.5\"), currency=\"EUR\")`` -> ``\"€1,234.50\"``.\"\"\"\n\n    if not isinstance(amount, Decimal):","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/dependency-upgrade/opencode-2/repo/vendor-updates/moneyfmt-2.0.0/moneyfmt/__init__.py","text":"\"\"\"moneyfmt 2.0.0: format and parse money amounts, as Decimal only.\"\"\"\n\nfrom __future__ import annotations\n\nfrom decimal import ROUND_HALF_UP, Decimal, InvalidOperation\n\n__version__ = \"2.0.0\"\n__all__ = [\"CURRENCIES\", \"MoneyFormatError\", \"format_money\", \"parse_money\"]\n\nCURRENCIES = {\"EUR\": \"€\", \"USD\": \"$\", \"GBP\": \"£\", \"CHF\": \"CHF \"}\n\n\nclass MoneyFormatError(ValueError):\n    \"\"\"An amount that cannot be read, or a currency that is not known.\"\"\"\n\n\ndef format_money(amount: Decimal, *, currency: str, grouping: bool = True) -> str:\n    \"\"\"``format_money(Decimal(\"1234.5\"), currency=\"EUR\")`` -> ``\"€1,234.50\"``.\"\"\"\n\n    if not isinstance(amount, Decimal):\n        raise TypeError(f\"format_money takes a Decimal, not {type(amount).__name__}\")\n    if currency not in CURRENCIES:\n        raise MoneyFormatError(f\"unknown currency {currency!r}\")\n    value = amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n    sign = \"-\" if value < 0 else \"\"\n    number = f\"{abs(value):,.2f}\" if grouping else f\"{abs(value):.2f}\"\n    return f\"{sign}{CURRENCIES[currency]}{number}\"\n\n\ndef parse_money(text: str) -> Decimal:\n    \"\"\"``parse_money(\"1,234.50\")`` -> ``Decimal(\"1234.50\")``; currency symbols are ignored.\"\"\"\n\n    cleaned = text.strip()\n    for symbol in CURRENCIES.values():\n        cleaned = cleaned.replace(symbol.strip(), \"\")\n    cleaned = cleaned.replace(\",\", \"\").strip()\n    try:\n        value = Decimal(cleaned)\n    except InvalidOperation:\n        raise MoneyFormatError(f\"cannot read amount {text!r}\") from None\n    if not value.is_finite():\n        raise MoneyFormatError(f\"cannot read amount {text!r}\")\n    return value","lineStart":1,"lineEnd":43,"totalLines":43,"truncated":false}},"title":"vendor-updates/moneyfmt-2.0.0/moneyfmt/__init__.py","time":{"start":1794861510465,"end":1794861510480}},"id":"prt_1e6152e9b001H24mZXPUUMl6vd","sessionID":"ses_e19eaf816ffeLK63YQCC74Krze","messageID":"msg_1e61529ab001XdQzZoVJHSPsd3"}}
