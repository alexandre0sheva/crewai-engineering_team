,665.65 EUR\")\n \n+    def test_unreadable_rabo_line_adds_nothing(self):\n+        book = journal()\n+        bad = MARCH_RABO.replace('\"+2.750,00\"', '\"lots\"')\n+        with self.assertRaisesRegex(ImportError_, \"statement.csv:5\"):\n+            import_statement(book, write(bad), \"rabo\", \"checking\", Categorizer([]))\n+        self.assertEqual(len(book), 0)\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()\n","filediff":{"file":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ledger-misleading-trace/opencode-2/repo/tests/test_import.py","patch":"Index: /private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ledger-misleading-trace/opencode-2/repo/tests/test_import.py\n===================================================================\n--- /private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ledger-misleading-trace/opencode-2/repo/tests/test_import.py\n+++ /private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ledger-misleading-trace/opencode-2/repo/tests/test_import.py\n@@ -90,7 +90,25 @@\n         again = import_statement(book, path, \"rabo\", \"checking\", Categorizer([]))\n         self.assertEqual((first.added, again.added, again.duplicates), (2, 0, 2))\n         self.assertEqual(sorted(t.category for t in book), [\"groceries\", \"rent\"])\n \n+    def test_march_rabo_import_reports_all_money(self):\n+        book = journal()\n+        result = import_statement(\n+            book, write(MARCH_RABO), \"rabo\", \"checking\", Categorizer([])\n+        )\n+        self.assertEqual((result.read, result.added), (3, 3))\n+        statement = income_statement(book, parse_period(\"2026-03\