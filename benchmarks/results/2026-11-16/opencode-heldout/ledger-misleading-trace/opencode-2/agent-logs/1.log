\"EUR\"\n39: \n40:     @property\n41:     def total_income(self) -> Money:\n42:         return total([line.amount for line in self.income], self.currency)\n43: \n44:     @property\n45:     def total_expenses(self) -> Money:\n46:         return total([line.amount for line in self.expenses], self.currency)\n47: \n48:     @property\n49:     def net(self) -> Money:\n50:         return self.total_income + self.total_expenses\n51: \n52:     @property\n53:     def savings_rate(self) -> Decimal | None:\n54:         income = self.total_income.amount\n55:         return None if income <= 0 else self.net.amount / income\n56: \n57: \n58: def category_totals(\n59:     journal: Journal, period: Period, rates: RateTable\n60: ) -> dict[str, tuple[Money, int]]:\n61:     \"\"\"Per category: the total in the home currency and the number of transactions.\"\"\"\n62: \n63:     totals: dict[str, tuple[Money, int]] = {}\n64:     for category, transactions in journal.by_category(period).items():\n65:         converted = convert_all(transactions, rates)\n66:         totals[category] = (total(converted, rates.home), len(transactions))\n67:     return totals\n68: \n69: \n70: def income_statement(\n71:     journal: Journal, period: Period, rates: RateTable, *, compare: bool = False\n72: ) -> IncomeStatement:\n73:     current = category_totals(journal, period, rates)\n74:     previous = category_totals(journal, period.previous(), rates) if compare else {}\n75:     statement = IncomeStatement(period, currency=rates.home)\n76:     for category, (amount, count) in sorted(current.items()):\n77:         account = journal.chart.get(category)\n78:         before = previous.get(category, (None, 0))[0] if compare else None\n79:         line = CategoryLine(category, account.name, amount, count, before)\n80:         if account.kind is Kind.INCOME:\n81:             statement.income.append(line)\n82:         else:\n83:             statement.expenses.append(line)\n84:     statement.income.sort(key=lambda line: -line.amount.amount)\n85:     statement.expenses.sort(key=lambda line: line.amount.amount)\n86:     return statement\n\n(End of file - total 86 lines)\n</content>","metadata":{"preview":"\"\"\"Income and expenses per category for a period, in the home currency.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom decimal import Decimal\n\nfrom ledgerly.core.accounts import Kind\nfrom ledgerly.core.journal import Journal\nfrom ledgerly.core.money import Money, total\nfrom ledgerly.core.periods import Period\nfrom ledgerly.fx.convert import convert_all\nfrom ledgerly.fx.rates import RateTable\n\n\n@dataclass\nclass CategoryLine:\n    category: str\n    name: str\n    amount: Money","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ledger-misleading-trace/opencode-2/repo/ledgerly/reports/income.py","text":"\"\"\"Income and expenses per category for a period, in the home currency.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom decimal import Decimal\n\nfrom ledgerly.core.accounts import Kind\nfrom ledgerly.core.journal import Journal\nfrom ledgerly.core.money import Money, total\nfrom ledgerly.core.periods import Period\nfrom ledgerly.fx.convert import convert_all\nfrom ledgerly.fx.rates import RateTable\n\n\n@dataclass\nclass CategoryLine:\n    category: str\n    name: str\n    amount: Money\n    count: int\n    previous: Money | None = None\n\n    @property\n    def change(self) -> Decimal | None:\n        \"\"\"Change against the previous period, as a fraction (``None`` when it had nothing).\"\"\"\n\n        if self.previous is None or self.previous.is_zero:\n            return None\n        return (self.amount.amount - self.previous.amount) / abs(self.previous.amount)\n\n\n@dataclass\nclass IncomeStatement:\n    period: Period\n    income: list[CategoryLine] = field(default_factory=list)\n    expenses: list[CategoryLine] = field(default_factory=list)\n    currency: str = \"EUR\"\n\n    @property\n    def total_income(self) -> Money:\n        return total([line.amount for line in self.income], self.currency)\n\n    @property\n    def total_expenses(self) -> Money:\n        return total([line.amount for line in self.expenses], self.currency)\n\n    @property\n    def net(self) -> Money:\n        return self.total_income + self.total_expenses\n\n    @property\n    def savings_rate(self) -> Decimal | None:\n        income = self.total_income.amount\n        return None if income <= 0 else self.net.amount / income\n\n\ndef category_totals(\n    journal: Journal, period: Period, rates: RateTable\n) -> dict[str, tuple[Money, int]]:\n    \"\"\"Per category: the total in the home currency and the number of transactions.\"\"\"\n\n    totals: dict[str, tuple[Money, int]] = {}\n    for category, transactions in journal.by_category(period).items():\n        converted = convert_all(transactions, rates)\n        totals[category] = (total(converted, rates.home), len(transactions))\n    return totals\n\n\ndef income_statement(\n    journal: Journal, period: Period, rates: RateTable, *, compare: bool = False\n) -> IncomeStatement:\n    current = category_totals(journal, period, rates)\n    previous = category_totals(journal, period.previous(), rates) if compare else {}\n    statement = IncomeStatement(period, currency=rates.home)\n    for category, (amount, count) in sorted(current.items()):\n        account = journal.chart.get(category)\n        before = previous.get(category, (None, 0))[0] if compare else None\n        line = CategoryLine(category, account.name, amount, count, before)\n        if account.kind is Kind.INCOME:\n            statement.income.append(line)\n        else:\n            statement.expenses.append(line)\n    statement.income.sort(key=lambda line: -line.amount.amount)\n    statement.expenses.sort(key=lambda line: line.amount.amount)\n    return statement","lineStart":1,"lineEnd":86,"totalLines":86,"truncated":false}},"title":"ledgerly/reports/income.py","time":{"start":1794862147030,"end":1794862147035}},"id":"prt_1e61ee5d2001mMaGzQjA2evK3G","sessionID":"ses_e19e37d77ffeBadt3udLmrManh","messageID":"msg_1e61ecf5d001VncAB3yO84Dz9l"}}
