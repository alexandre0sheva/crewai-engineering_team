    return Period(\n41:         date(day.year, day.month, 1), date(day.year, day.month, last_day), f\"{day:%Y-%m}\"\n42:     )\n43: \n44: \n45: def quarter(year: int, number: int) -> Period:\n46:     if number not in (1, 2, 3, 4):\n47:         raise LedgerError(\"a quarter is 1, 2, 3 or 4\")\n48:     first = date(year, 3 * number - 2, 1)\n49:     last = month(date(year, 3 * number, 1)).last\n50:     return Period(first, last, f\"{year}-Q{number}\")\n51: \n52: \n53: def year(value: int) -> Period:\n54:     return Period(date(value, 1, 1), date(value, 12, 31), str(value))\n55: \n56: \n57: def parse_period(text: str) -> Period:\n58:     \"\"\"``2026-03`` (a month), ``2026-Q1``, ``2026``, or ``2026-01-15..2026-02-14``.\"\"\"\n59: \n60:     text = text.strip()\n61:     if found := re.fullmatch(r\"(\\d{4})-(\\d{2})\", text):\n62:         number = int(found[2])\n63:         if not 1 <= number <= 12:\n64:             raise LedgerError(f\"no month {number} in {text!r}\")\n65:         return month(date(int(found[1]), number, 1))\n66:     if found := re.fullmatch(r\"(\\d{4})-[Qq]([1-4])\", text):\n67:         return quarter(int(found[1]), int(found[2]))\n68:     if re.fullmatch(r\"\\d{4}\", text):\n69:         return year(int(text))\n70:     if found := re.fullmatch(r\"(\\d{4}-\\d{2}-\\d{2})\\.\\.(\\d{4}-\\d{2}-\\d{2})\", text):\n71:         try:\n72:             return Period(date.fromisoformat(found[1]), date.fromisoformat(found[2]), text)\n73:         except ValueError as exc:\n74:             raise LedgerError(f\"bad date in {text!r}: {exc}\") from None\n75:     raise LedgerError(f\"cannot read the period {text!r}: use 2026-03, 2026-Q1, 2026 or A..B\")\n\n(End of file - total 75 lines)\n</content>","metadata":{"preview":"\"\"\"Reporting periods: a month, a quarter, a year, or any inclusive range of days.\"\"\"\n\nfrom __future__ import annotations\n\nimport calendar\nimport re\nfrom dataclasses import dataclass\nfrom datetime import date, timedelta\n\nfrom ledgerly.core.errors import LedgerError\n\n\n@dataclass(frozen=True)\nclass Period:\n    first: date\n    last: date\n    label: str\n\n    def __post_init__(self) -> None:\n        if self.last < self.first:","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out/opencode-heldout/ledger-misleading-trace/opencode-2/repo/ledgerly/core/periods.py","text":"\"\"\"Reporting periods: a month, a quarter, a year, or any inclusive range of days.\"\"\"\n\nfrom __future__ import annotations\n\nimport calendar\nimport re\nfrom dataclasses import dataclass\nfrom datetime import date, timedelta\n\nfrom ledgerly.core.errors import LedgerError\n\n\n@dataclass(frozen=True)\nclass Period:\n    first: date\n    last: date\n    label: str\n\n    def __post_init__(self) -> None:\n        if self.last < self.first:\n            raise LedgerError(f\"period {self.label} ends before it starts\")\n\n    def contains(self, day: date) -> bool:\n        return self.first <= day <= self.last\n\n    @property\n    def days(self) -> int:\n        return (self.last - self.first).days + 1\n\n    def previous(self) -> Period:\n        if re.fullmatch(r\"\\d{4}-\\d{2}\", self.label):\n            return month(self.first - timedelta(days=1))\n        length = self.days\n        last = self.first - timedelta(days=1)\n        return Period(last - timedelta(days=length - 1), last, f\"before {self.label}\")\n\n\ndef month(day: date) -> Period:\n    last_day = calendar.monthrange(day.year, day.month)[1]\n    return Period(\n        date(day.year, day.month, 1), date(day.year, day.month, last_day), f\"{day:%Y-%m}\"\n    )\n\n\ndef quarter(year: int, number: int) -> Period:\n    if number not in (1, 2, 3, 4):\n        raise LedgerError(\"a quarter is 1, 2, 3 or 4\")\n    first = date(year, 3 * number - 2, 1)\n    last = month(date(year, 3 * number, 1)).last\n    return Period(first, last, f\"{year}-Q{number}\")\n\n\ndef year(value: int) -> Period:\n    return Period(date(value, 1, 1), date(value, 12, 31), str(value))\n\n\ndef parse_period(text: str) -> Period:\n    \"\"\"``2026-03`` (a month), ``2026-Q1``, ``2026``, or ``2026-01-15..2026-02-14``.\"\"\"\n\n    text = text.strip()\n    if found := re.fullmatch(r\"(\\d{4})-(\\d{2})\", text):\n        number = int(found[2])\n        if not 1 <= number <= 12:\n            raise LedgerError(f\"no month {number} in {text!r}\")\n        return month(date(int(found[1]), number, 1))\n    if found := re.fullmatch(r\"(\\d{4})-[Qq]([1-4])\", text):\n        return quarter(int(found[1]), int(found[2]))\n    if re.fullmatch(r\"\\d{4}\", text):\n        return year(int(text))\n    if found := re.fullmatch(r\"(\\d{4}-\\d{2}-\\d{2})\\.\\.(\\d{4}-\\d{2}-\\d{2})\", text):\n        try:\n            return Period(date.fromisoformat(found[1]), date.fromisoformat(found[2]), text)\n        except ValueError as exc:\n            raise LedgerError(f\"bad date in {text!r}: {exc}\") from None\n    raise LedgerError(f\"cannot read the period {text!r}: use 2026-03, 2026-Q1, 2026 or A..B\")","lineStart":1,"lineEnd":75,"totalLines":75,"truncated":false}},"title":"ledgerly/core/periods.py","time":{"start":1794862147776,"end":1794862147781}},"id":"prt_1e61ee875001NpsDTqO1dUObE3","sessionID":"ses_e19e37d77ffeBadt3udLmrManh","messageID":"msg_1e61ecf5d001VncAB3yO84Dz9l"}}
