{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'nl -ba parcels/settings.py; nl -ba parcels/packing.py; nl -ba parcels/quote.py; nl -ba parcels/__main__.py; nl -ba parcels/__init__.py; ls -la'","aggregated_output":"     1\t\"\"\"Settings read from the environment once, at import.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport os\n     6\tfrom decimal import Decimal\n     7\t\n     8\tCARRIERS = (\"dhl\", \"ups\", \"postnl\")\n     9\t\n    10\tCARRIER = os.environ.get(\"PARCELS_CARRIER\", \"postnl\").lower()\n    11\tif CARRIER not in CARRIERS:\n    12\t    raise RuntimeError(f\"PARCELS_CARRIER must be one of {', '.join(CARRIERS)}, not {CARRIER!r}\")\n    13\t\n    14\t# Orders at or above this value (in euros, after discounts) ship for free inside the EU.\n    15\tFREE_SHIPPING_FROM = Decimal(os.environ.get(\"PARCELS_FREE_FROM\", \"60.00\"))\n    16\t\n    17\tMAX_PARCEL_KG = Decimal(\"31.5\")\n    18\tHANDLING_DAYS = 1\n     1\t\"\"\"Splitting an order into parcels.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport math\n     6\tfrom decimal import Decimal\n     7\t\n     8\tfrom parcels.settings import MAX_PARCEL_KG\n     9\t\n    10\t\n    11\tdef parcel_weights(total_kg: Decimal) -> list[Decimal]:\n    12\t    \"\"\"The weights of the parcels an order of ``total_kg`` is packed into.\n    13\t\n    14\t    Heavy orders are split into as few parcels as possible, all of the same weight, each at most\n    15\t    ``MAX_PARCEL_KG``: 70 kg becomes three parcels of 23.334 kg (rounded up to the gram).\n    16\t    \"\"\"\n    17\t\n    18\t    if total_kg <= 0:\n    19\t        raise ValueError(\"an order weighs something\")\n    20\t    count = max(1, math.ceil(total_kg / MAX_PARCEL_KG))\n    21\t    each = (total_kg / count).quantize(Decimal(\"0.001\"), rounding=\"ROUND_CEILING\")\n    22\t    return [each] * count\n     1\t\"\"\"What shipping costs for an order.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport math\n     6\tfrom decimal import Decimal\n     7\t\n     8\tfrom parcels.carriers import EU, TARIFFS\n     9\tfrom parcels.packing import parcel_weights\n    10\tfrom parcels.settings import CARRIER, FREE_SHIPPING_FROM\n    11\t\n    12\t\n    13\tclass CannotShip(ValueError):\n    14\t    \"\"\"The shop does not ship there.\"\"\"\n    15\t\n    16\t\n    17\tdef parcel_price(weight_kg: Decimal, country: str) -> Decimal:\n    18\t    tariff = TARIFFS[CARRIER]\n    19\t    price = tariff.base + tariff.per_kg * math.ceil(weight_kg)\n    20\t    if country != \"NL\":\n    21\t        price += tariff.eu_surcharge\n    22\t    return price\n    23\t\n    24\t\n    25\tdef shipping_cost(order_value: Decimal, weight_kg: Decimal, country: str) -> Decimal:\n    26\t    \"\"\"Shipping for an order worth ``order_value`` euros (after discounts) to ``country``.\"\"\"\n    27\t\n    28\t    country = country.upper()\n    29\t    if country not in EU:\n    30\t        raise CannotShip(f\"we do not ship to {country}\")\n    31\t    if order_value >= FREE_SHIPPING_FROM:\n    32\t        return Decimal(\"0.00\")\n    33\t    return sum((parcel_price(w, country) for w in parcel_weights(weight_kg)), Decimal(\"0.00\"))\n     1\t\"\"\"``python -m parcels VALUE WEIGHT_KG COUNTRY``: the shipping cost and the delivery date.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\timport sys\n     6\tfrom datetime import datetime\n     7\tfrom decimal import Decimal, InvalidOperation\n     8\t\n     9\tfrom parcels.delivery import delivery_date\n    10\tfrom parcels.quote import CannotShip, shipping_cost\n    11\t\n    12\t\n    13\tdef main(argv: list[str]) -> int:\n    14\t    if len(argv) != 3:\n    15\t        print(\"usage: python -m parcels VALUE WEIGHT_KG COUNTRY\", file=sys.stderr)\n    16\t        return 2\n    17\t    try:\n    18\t        value, weight = Decimal(argv[0]), Decimal(argv[1])\n    19\t        cost = shipping_cost(value, weight, argv[2])\n    20\t    except (InvalidOperation, CannotShip, ValueError) as exc:\n    21\t        print(f\"error: {exc}\", file=sys.stderr)\n    22\t        return 2\n    23\t    print(f\"shipping: {cost}\")\n    24\t    print(f\"arrives: {delivery_date(datetime.now(), argv[2]).isoformat()}\")\n    25\t    return 0\n    26\t\n    27\t\n    28\tif __name__ == \"__main__\":\n    29\t    sys.exit(main(sys.argv[1:]))\n     1\t\"\"\"Shipping quotes and delivery dates for the web shop.\"\"\"\ntotal 8\ndrwxr-xr-x@  6 alexander  wheel  192 Nov 17 13:16 .\ndrwxr-xr-x@  5 alexander  wheel  160 Nov 17 13:16 ..\ndrwxr-xr-x@ 12 alexander  wheel  384 Nov 17 13:16 .git\n-rw-r--r--@  1 alexander  wheel  183 Oct 28 23:21 README.md\ndrwxr-xr-x@  9 alexander  wheel  288 Nov 17 13:16 parcels\ndrwxr-xr-x@  4 alexander  wheel  128 Nov 17 13:16 tests\n","exit_code":0,"status":"completed"}}
