{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'cat requirements.txt README.md vendor-updates/moneyfmt-2.0.0/CHANGELOG.md invoicer/__main__.py invoicer/totals.py tests/test_totals.py vendor/moneyfmt/__init__.py vendor-updates/moneyfmt-2.0.0/moneyfmt/__init__.py'","aggregated_output":"# Vendored in vendor/ (the build machines have no network access); keep the pin in step.\nmoneyfmt==1.4.0\n# invoicer\n\nTotals for simple invoices (Python 3.11+). Its one dependency, `moneyfmt`, is vendored in\n`vendor/` because the build machines have no network access; `requirements.txt` records the\nversion. New releases are unpacked into `vendor-updates/` for review before they are adopted.\n\n```bash\npython -m invoicer \"Design=1,200.00\" \"Hosting=49.99\"\npython -m unittest discover -s tests\n```\n# moneyfmt changelog\n\n## 2.0.0\n\nBreaking changes:\n\n- `parse_money` returns a `Decimal` instead of a `float`.\n- `format_money` takes a `Decimal` only (a `float` or `int` raises `TypeError`), and `currency` is\n  keyword-only: `format_money(amount, currency=\"EUR\")`.\n- `MoneyError` is renamed `MoneyFormatError`. The old name is gone.\n\nAdded:\n\n- `format_money(..., grouping=False)` leaves out the thousands separators.\n- `CHF`.\n- `parse_money` rejects `NaN` and `Infinity`.\n\n## 1.4.0\n\n- `GBP`.\n\"\"\"``python -m invoicer \"Design=1,200.00\" \"Hosting=49.99\" ...``: the invoice lines and total.\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\n\nfrom invoicer.totals import InvoiceError, parse_line, render\n\n\ndef main(argv: list[str]) -> int:\n    if not argv:\n        print('usage: python -m invoicer \"DESCRIPTION=AMOUNT\" ...', file=sys.stderr)\n        return 2\n    try:\n        lines = [parse_line(arg) for arg in argv]\n    except InvoiceError as exc:\n        print(f\"error: {exc}\", file=sys.stderr)\n        return 2\n    for row in render(lines):\n        print(row)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n\"\"\"Invoice lines and their total.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\n\nfrom moneyfmt import MoneyError, format_money, parse_money\n\nCURRENCY = \"EUR\"\n\n\nclass InvoiceError(ValueError):\n    pass\n\n\n@dataclass(frozen=True)\nclass Line:\n    description: str\n    amount: float\n\n\ndef parse_line(text: str) -> Line:\n    \"\"\"``\"Design=1,200.00\"`` -> a line.\"\"\"\n\n    description, sep, amount = text.partition(\"=\")\n    if not sep or not description.strip():\n        raise InvoiceError(f\"a line is DESCRIPTION=AMOUNT, not {text!r}\")\n    try:\n        return Line(description.strip(), parse_money(amount))\n    except MoneyError as exc:\n        raise InvoiceError(str(exc)) from None\n\n\ndef total(lines: list[Line]) -> float:\n    return sum(line.amount for line in lines)\n\n\ndef render(lines: list[Line]) -> list[str]:\n    rows = [f\"{line.description:<24}{format_money(line.amount, CURRENCY):>14}\" for line in lines]\n    rows.append(f\"{'Total':<24}{format_money(total(lines), CURRENCY):>14}\")\n    return rows\nimport unittest\n\nfrom invoicer.totals import InvoiceError, parse_line, render\n\n\nclass TotalsTest(unittest.TestCase):\n    def test_render(self):\n        lines = [parse_line(\"Design=1,200.00\"), parse_line(\"Hosting=€49.99\")]\n        self.assertEqual(render(lines)[-1], \"Total                        €1,249.99\")\n\n    def test_bad_lines(self):\n        with self.assertRaisesRegex(InvoiceError, \"cannot read amount\"):\n            parse_line(\"Design=lots\")\n        with self.assertRaisesRegex(InvoiceError, \"DESCRIPTION=AMOUNT\"):\n            parse_line(\"no amount\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n\"\"\"moneyfmt 1.4.0: format and parse money amounts.\"\"\"\n\nfrom __future__ import annotations\n\nfrom decimal import ROUND_HALF_UP, Decimal, InvalidOperation\n\n__version__ = \"1.4.0\"\n__all__ = [\"CURRENCIES\", \"MoneyError\", \"format_money\", \"parse_money\"]\n\nCURRENCIES = {\"EUR\": \"€\", \"USD\": \"$\", \"GBP\": \"£\"}\n\n\nclass MoneyError(ValueError):\n    \"\"\"An amount that cannot be read, or a currency that is not known.\"\"\"\n\n\ndef format_money(amount, currency):\n    \"\"\"``format_money(1234.5, \"EUR\")`` -> ``\"€1,234.50\"`` (rounded half up to the cent).\"\"\"\n\n    if currency not in CURRENCIES:\n        raise MoneyError(f\"unknown currency {currency!r}\")\n    value = Decimal(str(amount)).quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n    sign = \"-\" if value < 0 else \"\"\n    return f\"{sign}{CURRENCIES[currency]}{abs(value):,.2f}\"\n\n\ndef parse_money(text):\n    \"\"\"``parse_money(\"1,234.50\")`` -> ``1234.5`` (a float); currency symbols are ignored.\"\"\"\n\n    cleaned = text.strip()\n    for symbol in CURRENCIES.values():\n        cleaned = cleaned.replace(symbol, \"\")\n    cleaned = cleaned.replace(\",\", \"\")\n    try:\n        return float(Decimal(cleaned))\n    except InvalidOperation:\n        raise MoneyError(f\"cannot read amount {text!r}\") from None\n\"\"\"moneyfmt 2.0.0: format and parse money amounts, as Decimal only.\"\"\"\n\nfrom __future__ import annotations\n\nfrom decimal import ROUND_HALF_UP, Decimal, InvalidOperation\n\n__version__ = \"2.0.0\"\n__all__ = [\"CURRENCIES\", \"MoneyFormatError\", \"format_money\", \"parse_money\"]\n\nCURRENCIES = {\"EUR\": \"€\", \"USD\": \"$\", \"GBP\": \"£\", \"CHF\": \"CHF \"}\n\n\nclass MoneyFormatError(ValueError):\n    \"\"\"An amount that cannot be read, or a currency that is not known.\"\"\"\n\n\ndef format_money(amount: Decimal, *, currency: str, grouping: bool = True) -> str:\n    \"\"\"``format_money(Decimal(\"1234.5\"), currency=\"EUR\")`` -> ``\"€1,234.50\"``.\"\"\"\n\n    if not isinstance(amount, Decimal):\n        raise TypeError(f\"format_money takes a Decimal, not {type(amount).__name__}\")\n    if currency not in CURRENCIES:\n        raise MoneyFormatError(f\"unknown currency {currency!r}\")\n    value = amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP)\n    sign = \"-\" if value < 0 else \"\"\n    number = f\"{abs(value):,.2f}\" if grouping else f\"{abs(value):.2f}\"\n    return f\"{sign}{CURRENCIES[currency]}{number}\"\n\n\ndef parse_money(text: str) -> Decimal:\n    \"\"\"``parse_money(\"1,234.50\")`` -> ``Decimal(\"1234.50\")``; currency symbols are ignored.\"\"\"\n\n    cleaned = text.strip()\n    for symbol in CURRENCIES.values():\n        cleaned = cleaned.replace(symbol.strip(), \"\")\n    cleaned = cleaned.replace(\",\", \"\").strip()\n    try:\n        value = Decimal(cleaned)\n    except InvalidOperation:\n        raise MoneyFormatError(f\"cannot read amount {text!r}\") from None\n    if not value.is_finite():\n        raise MoneyFormatError(f\"cannot read amount {text!r}\")\n    return value\n","exit_code":0,"status":"completed"}}
