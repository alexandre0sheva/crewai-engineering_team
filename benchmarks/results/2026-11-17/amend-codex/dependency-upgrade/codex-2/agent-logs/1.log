, CURRENCY):>14}\")\n+    rows = [f\"{line.description:<24}{format_money(line.amount, currency=CURRENCY):>14}\" for line in lines]\n+    rows.append(f\"{'Total':<24}{format_money(total(lines), currency=CURRENCY):>14}\")\n     return rows\ndiff --git a/requirements.txt b/requirements.txt\nindex 7cb3381..c485672 100644\n--- a/requirements.txt\n+++ b/requirements.txt\n@@ -1,2 +1,2 @@\n # Vendored in vendor/ (the build machines have no network access); keep the pin in step.\n-moneyfmt==1.4.0\n+moneyfmt==2.0.0\ndiff --git a/tests/test_totals.py b/tests/test_totals.py\nindex 80b1747..7e107ba 100644\n--- a/tests/test_totals.py\n+++ b/tests/test_totals.py\n@@ -1,6 +1,10 @@\n+from decimal import Decimal\n+from pathlib import Path\n+import subprocess\n+import sys\n import unittest\n \n-from invoicer.totals import InvoiceError, parse_line, render\n+from invoicer.totals import InvoiceError, parse_line, render, total\n \n \n class TotalsTest(unittest.TestCase):\n@@ -14,6 +18,57 @@ class TotalsTest(unittest.TestCase):\n         with self.assertRaisesRegex(InvoiceError, \"DESCRIPTION=AMOUNT\"):\n             parse_line(\"no amount\")\n \n+    def test_empty_total_is_decimal_and_can_be_rendered(self):\n+        # sum() without a Decimal start returns an int for an empty invoice,\n+        # which moneyfmt 2.0's formatter rejects.\n+        self.assertIsInstance(total([]), Decimal)\n+        self.assertEqual(total([]), Decimal(\"0\"))\n+        self.assertEqual(render([]), [\"Total                            €0.00\"])\n+\n+    def test_amounts_and_totals_are_exact_decimals(self):\n+        lines = [parse_line(\"A=0.1\"), parse_line(\"B=0.2\")]\n+        self.assertIsInstance(lines[0].amount, Decimal)\n+        self.assertIsInstance(total(lines), Decimal)\n+        self.assertEqual(total(lines), Decimal(\"0.3\"))\n+\n+    def test_total_rounds_from_exact_decimal(self):\n+        lines = [parse_line(\"A=0.1\"), parse_line(\"B=-1.005\")]\n+        self.assertEqual(total(lines), Decimal