{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc 'cat tests/test_import.py tests/test_cli.py tests/helpers.py'","aggregated_output":"import unittest\nfrom datetime import date\nfrom decimal import Decimal\n\nfrom ledgerly.core.errors import ImportError_\nfrom ledgerly.io.bank_formats import parse_amount\nfrom ledgerly.io.csv_import import import_statement, read_statement\nfrom ledgerly.rules.categorize import Categorizer\n\nfrom tests.helpers import journal, write\n\nGENERIC = \"\"\"date,amount,currency,description,counterparty,iban\n2026-03-01,-42.10,EUR,Weekly shop,Albert Heijn 1234,\n2026-03-02,+2500.00,EUR,Salary March,Acme BV,NL91ABNA0417164300\n\"\"\"\n\nING = \"\"\"Datum;Naam / Omschrijving;Tegenrekening;Af Bij;Bedrag (EUR);Mededelingen\n20260303;Spotify AB;;Af;9,99;Ref: 7781\n20260304;Gemeente Utrecht;NL91ABNA0417164300;Bij;1.234,56;Teruggave\n\"\"\"\n\nRABO = \"\"\"Datum,Bedrag,Munt,Naam tegenpartij,Tegenrekening IBAN/BBAN,Omschrijving-1\n2026-03-01,,EUR,,,Saldo begin\n2026-03-05,\"-12,50\",EUR,Jumbo Utrecht,,Boodschappen\n2026-03-06,\"-1.020,00\",EUR,Woonstichting,NL91ABNA0417164300,Huur maart\n\"\"\"\n\n\nclass AmountTest(unittest.TestCase):\n    def test_decimal_comma(self):\n        self.assertEqual(parse_amount(\"1.234,56\", decimal_comma=True), Decimal(\"1234.56\"))\n        self.assertEqual(parse_amount(\"-12,50\", decimal_comma=True), Decimal(\"-12.50\"))\n        self.assertIsNone(parse_amount(\"  \", decimal_comma=True))\n\n    def test_decimal_point(self):\n        self.assertEqual(parse_amount(\"+1,250.00\", decimal_comma=False), Decimal(\"1250.00\"))\n        self.assertIsNone(parse_amount(\"abc\", decimal_comma=False))\n\n\nclass FormatTest(unittest.TestCase):\n    def test_generic(self):\n        rows = read_statement(write(GENERIC), \"generic\", \"checking\")\n        self.assertEqual([r.amount for r in rows], [Decimal(\"-42.10\"), Decimal(\"2500.00\")])\n        self.assertEqual(rows[1].source, \"statement.csv:3\")\n\n    def test_ing_signs_from_af_bij(self):\n        rows = read_statement(write(ING), \"ing\", \"checking\")\n        self.assertEqual([r.amount for r in rows], [Decimal(\"-9.99\"), Decimal(\"1234.56\")])\n        self.assertEqual(rows[0].description, \"Spotify AB\")\n        self.assertEqual(rows[1].booked, date(2026, 3, 4))\n\n    def test_rabo_skips_balance_lines(self):\n        rows = read_statement(write(RABO), \"rabo\", \"checking\")\n        self.assertEqual([r.amount for r in rows], [Decimal(\"-12.50\"), Decimal(\"-1020.00\")])\n\n    def test_errors_name_the_line(self):\n        bad = GENERIC.replace(\"-42.10\", \"lots\")\n        with self.assertRaisesRegex(ImportError_, \"statement.csv:2\"):\n            read_statement(write(bad), \"generic\", \"checking\")\n        with self.assertRaisesRegex(ImportError_, \"unknown format\"):\n            read_statement(write(GENERIC), \"abn\", \"checking\")\n\n\nclass ImportTest(unittest.TestCase):\n    def test_import_categorises_and_deduplicates(self):\n        book = journal()\n        path = write(RABO)\n        first = import_statement(book, path, \"rabo\", \"checking\", Categorizer([]))\n        again = import_statement(book, path, \"rabo\", \"checking\", Categorizer([]))\n        self.assertEqual((first.added, again.added, again.duplicates), (2, 0, 2))\n        self.assertEqual(sorted(t.category for t in book), [\"groceries\", \"rent\"])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nimport contextlib\nimport io\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom ledgerly.__main__ import run\n\nfrom tests.test_import import ING\n\n\nclass CliTest(unittest.TestCase):\n    def setUp(self):\n        self.dir = Path(tempfile.mkdtemp(prefix=\"ledgerly-cli-\"))\n        self.ledger = str(self.dir / \"ledger.json\")\n\n    def ledgerly(self, *args: str) -> str:\n        out = io.StringIO()\n        with contextlib.redirect_stdout(out):\n            self.assertEqual(run([\"--ledger\", self.ledger, \"--rates\", str(self.dir / \"r.csv\"), *args]), 0)\n        return out.getvalue()\n\n    def test_import_and_report(self):\n        (self.dir / \"ing.csv\").write_text(ING)\n        self.ledgerly(\"account\", \"add\", \"checking\", \"Checking\")\n        self.assertIn(\"2 added\", self.ledgerly(\"import\", str(self.dir / \"ing.csv\"), \"--format\", \"ing\", \"--account\", \"checking\"))\n        report = self.ledgerly(\"report\", \"income\", \"2026-03\")\n        self.assertIn(\"Subscriptions\", report)\n        self.assertIn(\"Net                         1,224.57 EUR\", report)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n\"\"\"Shared test data.\"\"\"\n\nfrom __future__ import annotations\n\nimport tempfile\nfrom datetime import date\nfrom decimal import Decimal\nfrom pathlib import Path\n\nfrom ledgerly.core.accounts import Account, Chart, Kind\nfrom ledgerly.core.journal import Journal\nfrom ledgerly.core.transactions import Transaction\n\n\ndef journal() -> Journal:\n    chart = Chart()\n    chart.add(Account(\"checking\", \"Checking\", Kind.ASSET, iban=\"NL91ABNA0417164300\"))\n    chart.add(Account(\"card\", \"Credit card\", Kind.LIABILITY))\n    return Journal(chart)\n\n\ndef txn(amount: str, day: date = date(2026, 3, 2), **fields: object) -> Transaction:\n    values: dict[str, object] = {\n        \"account\": \"checking\",\n        \"booked\": day,\n        \"amount\": Decimal(amount),\n        \"currency\": \"EUR\",\n        \"description\": \"test\",\n    }\n    values.update(fields)\n    return Transaction(**values)  # type: ignore[arg-type]\n\n\ndef write(text: str, name: str = \"statement.csv\") -> Path:\n    directory = Path(tempfile.mkdtemp(prefix=\"ledgerly-test-\"))\n    path = directory / name\n    path.write_text(text, encoding=\"utf-8\")\n    return path\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"cat ledgerly/__main__.py ledgerly/reports/income.py ledgerly/fx/convert.py ledgerly/fx/rates.py ledgerly/core/errors.py ledgerly/io/json_store.py; rg -n 'parse_amount|rabo|None|atomic' tests; rg --files -g 'AGENTS.md' -g '*.csv' -g '*.toml' -g '*.json' -g '*.yaml' -g '*.yml'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"cat ledgerly/__main__.py ledgerly/reports/income.py ledgerly/fx/convert.py ledgerly/fx/rates.py ledgerly/core/errors.py ledgerly/io/json_store.py; rg -n 'parse_amount|rabo|None|atomic' tests; rg --files -g 'AGENTS.md' -g '*.csv' -g '*.toml' -g '*.json' -g '*.yaml' -g '*.yml'\"","aggregated_output":"\"\"\"The ``ledgerly`` command line (``python -m ledgerly``).\n\n    ledgerly [--ledger FILE] [--rates FILE] COMMAND ...\n\n    account add ID NAME [--kind asset|liability] [--currency EUR] [--iban IBAN]\n    accounts\n    import FILE --format generic|ing|rabo --account ID\n    report income PERIOD [--compare]\n    report balance [--on YYYY-MM-DD]\n    report budget PERIOD --budgets FILE\n    export [PERIOD]                CSV on standard output\n    rule add CATEGORY MATCHER... [--income-only|--expense-only] [--name NAME]\n    explain SOURCE                 which rule categorised the transaction from FILE:LINE\n\nErrors print ``error: <message>`` and exit with status 2.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport sys\nfrom datetime import date\nfrom pathlib import Path\n\nfrom ledgerly.core.accounts import Account, Kind\nfrom ledgerly.core.errors import LedgerError\nfrom ledgerly.core.periods import parse_period\nfrom ledgerly.fx.rates import load_rates\nfrom ledgerly.io import json_store\nfrom ledgerly.io.csv_import import import_statement\nfrom ledgerly.io.export import export_csv\nfrom ledgerly.reports.balance import balances\nfrom ledgerly.reports.budget import compare, load_budgets, render_budget\nfrom ledgerly.reports.income import income_statement\nfrom ledgerly.reports.render import render_balances, render_income\nfrom ledgerly.rules.categorize import Categorizer, Rule\nfrom ledgerly.rules.matchers import parse_matcher\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(prog=\"ledgerly\", description=\"A small personal ledger.\")\n    parser.add_argument(\"--ledger\", default=\"ledger.json\", type=Path)\n    parser.add_argument(\"--rates\", default=\"rates.csv\", type=Path)\n    commands = parser.add_subparsers(dest=\"command\", required=True)\n\n    account = commands.add_parser(\"account\").add_subparsers(dest=\"action\", required=True)\n    add = account.add_parser(\"add\")\n    add.add_argument(\"id\")\n    add.add_argument(\"name\")\n    add.add_argument(\"--kind\", choices=(\"asset\", \"liability\"), default=\"asset\")\n    add.add_argument(\"--currency\", default=\"EUR\")\n    add.add_argument(\"--iban\")\n\n    commands.add_parser(\"accounts\")\n\n    load = commands.add_parser(\"import\")\n    load.add_argument(\"file\", type=Path)\n    load.add_argument(\"--format\", required=True, choices=(\"generic\", \"ing\", \"rabo\"))\n    load.add_argument(\"--account\", required=True)\n\n    report = commands.add_parser(\"report\").add_subparsers(dest=\"report\", required=True)\n    income = report.add_parser(\"income\")\n    income.add_argument(\"period\")\n    income.add_argument(\"--compare\", action=\"store_true\")\n    balance = report.add_parser(\"balance\")\n    balance.add_argument(\"--on\", type=date.fromisoformat, default=None)\n    budget = report.add_parser(\"budget\")\n    budget.add_argument(\"period\")\n    budget.add_argument(\"--budgets\", required=True, type=Path)\n\n    export = commands.add_parser(\"export\")\n    export.add_argument(\"period\", nargs=\"?\")\n\n    rule = commands.add_parser(\"rule\").add_subparsers(dest=\"action\", required=True)\n    rule_add = rule.add_parser(\"add\")\n    rule_add.add_argument(\"category\")\n    rule_add.add_argument(\"matchers\", nargs=\"+\")\n    only = rule_add.add_mutually_exclusive_group()\n    only.add_argument(\"--income-only\", action=\"store_true\")\n    only.add_argument(\"--expense-only\", action=\"store_true\")\n    rule_add.add_argument(\"--name\", default=\"\")\n\n    explain = commands.add_parser(\"explain\")\n    explain.add_argument(\"source\")\n    return parser\n\n\ndef run(argv: list[str]) -> int:\n    args = build_parser().parse_args(argv)\n    journal, rules = json_store.load(args.ledger)\n    changed = False\n    if args.command == \"account\":\n        journal.chart.add(\n            Account(args.id, args.name, Kind(args.kind), args.currency.upper(), args.iban)\n        )\n        changed = True\n        print(f\"added account {args.id}\")\n    elif args.command == \"accounts\":\n        for account in journal.chart.all():\n            iban = f\"  {account.iban}\" if account.iban else \"\"\n            print(f\"{account.kind.value:<10} {account.id:<16} {account.name}{iban}\")\n    elif args.command == \"import\":\n        result = import_statement(\n            journal, args.file, args.format, args.account, Categorizer(rules)\n        )\n        changed = result.added > 0\n        print(result.summary())\n        for warning in result.warnings:\n            print(f\"warning: {warning}\", file=sys.stderr)\n    elif args.command == \"report\":\n        rates = load_rates(args.rates)\n        if args.report == \"income\":\n            statement = income_statement(\n                journal, parse_period(args.period), rates, compare=args.compare\n            )\n            sys.stdout.write(render_income(statement, compare=args.compare))\n        elif args.report == \"budget\":\n            period = parse_period(args.period)\n            lines = compare(journal, period, rates, load_budgets(args.budgets, journal))\n            sys.stdout.write(render_budget(lines, period))\n        else:\n            day = args.on or (journal.first_and_last() or (date.today(), date.today()))[1]\n            sys.stdout.write(render_balances(balances(journal, rates, day), rates.home))\n    elif args.command == \"rule\":\n        if args.category not in journal.chart:\n            raise LedgerError(f\"no category {args.category!r}\")\n        rules.append(\n            Rule(\n                args.category,\n                [parse_matcher(text) for text in args.matchers],\n                name=args.name,\n                income_only=args.income_only,\n                expense_only=args.expense_only,\n            )\n        )\n        changed = True\n        print(f\"rule added for {args.category}\")\n    elif args.command == \"export\":\n        period = parse_period(args.period) if args.period else None\n        sys.stdout.write(export_csv(journal, period))\n    elif args.command == \"explain\":\n        categorizer = Categorizer(rules)\n        matches = [t for t in journal if t.source == args.source]\n        if not matches:\n            raise LedgerError(f\"no transaction was imported from {args.source}\")\n        for transaction in matches:\n            print(categorizer.explain(transaction))\n    if changed:\n        json_store.save(args.ledger, journal, rules)\n    return 0\n\n\ndef main() -> int:\n    try:\n        return run(sys.argv[1:])\n    except LedgerError as exc:\n        print(f\"error: {exc}\", file=sys.stderr)\n        return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\"\"\"Income and expenses per category for a period, in the home currency.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom decimal import Decimal\n\nfrom ledgerly.core.accounts import Kind\nfrom ledgerly.core.journal import Journal\nfrom ledgerly.core.money import Money, total\nfrom ledgerly.core.periods import Period\nfrom ledgerly.fx.convert import convert_all\nfrom ledgerly.fx.rates import RateTable\n\n\n@dataclass\nclass CategoryLine:\n    category: str\n    name: str\n    amount: Money\n    count: int\n    previous: Money | None = None\n\n    @property\n    def change(self) -> Decimal | None:\n        \"\"\"Change against the previous period, as a fraction (``None`` when it had nothing).\"\"\"\n\n        if self.previous is None or self.previous.is_zero:\n            return None\n        return (self.amount.amount - self.previous.amount) / abs(self.previous.amount)\n\n\n@dataclass\nclass IncomeStatement:\n    period: Period\n    income: list[CategoryLine] = field(default_factory=list)\n    expenses: list[CategoryLine] = field(default_factory=list)\n    currency: str = \"EUR\"\n\n    @property\n    def total_income(self) -> Money:\n        return total([line.amount for line in self.income], self.currency)\n\n    @property\n    def total_expenses(self) -> Money:\n        return total([line.amount for line in self.expenses], self.currency)\n\n    @property\n    def net(self) -> Money:\n        return self.total_income + self.total_expenses\n\n    @property\n    def savings_rate(self) -> Decimal | None:\n        income = self.total_income.amount\n        return None if income <= 0 else self.net.amount / income\n\n\ndef category_totals(\n    journal: Journal, period: Period, rates: RateTable\n) -> dict[str, tuple[Money, int]]:\n    \"\"\"Per category: the total in the home currency and the number of transactions.\"\"\"\n\n    totals: dict[str, tuple[Money, int]] = {}\n    for category, transactions in journal.by_category(period).items():\n        converted = convert_all(transactions, rates)\n        totals[category] = (total(converted, rates.home), len(transactions))\n    return totals\n\n\ndef income_statement(\n    journal: Journal, period: Period, rates: RateTable, *, compare: bool = False\n) -> IncomeStatement:\n    current = category_totals(journal, period, rates)\n    previous = category_totals(journal, period.previous(), rates) if compare else {}\n    statement = IncomeStatement(period, currency=rates.home)\n    for category, (amount, count) in sorted(current.items()):\n        account = journal.chart.get(category)\n        before = previous.get(category, (None, 0))[0] if compare else None\n        line = CategoryLine(category, account.name, amount, count, before)\n        if account.kind is Kind.INCOME:\n            statement.income.append(line)\n        else:\n            statement.expenses.append(line)\n    statement.income.sort(key=lambda line: -line.amount.amount)\n    statement.expenses.sort(key=lambda line: line.amount.amount)\n    return statement\n\"\"\"Converting transaction amounts to the home currency for reports.\"\"\"\n\nfrom __future__ import annotations\n\nfrom decimal import Decimal\n\nfrom ledgerly.core.money import Money, round_cents\nfrom ledgerly.core.transactions import Transaction\nfrom ledgerly.fx.rates import RateTable\n\n\ndef to_home(amount: Decimal, currency: str, table: RateTable, day) -> Decimal:  # noqa: ANN001\n    \"\"\"``amount`` of ``currency`` in the home currency on ``day``, rounded to the cent.\"\"\"\n\n    rate = table.rate(currency, day)\n    return round_cents(amount * rate)\n\n\ndef transaction_in_home(transaction: Transaction, table: RateTable) -> Money:\n    value = to_home(transaction.amount, transaction.currency, table, transaction.booked)\n    return Money(value, table.home)\n\n\ndef convert_all(transactions: list[Transaction], table: RateTable) -> list[Money]:\n    return [transaction_in_home(t, table) for t in transactions]\n\"\"\"Exchange rates: units of the home currency per unit of a foreign one, per day.\n\nRates come from a CSV file (``date,currency,rate``), typically the ECB's reference rates. A rate\nfor a day without one (a weekend, a holiday) is the most recent earlier rate, at most\n``MAX_STALE_DAYS`` old.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport bisect\nimport csv\nfrom collections import defaultdict\nfrom datetime import date, timedelta\nfrom decimal import Decimal, InvalidOperation\nfrom pathlib import Path\n\nfrom ledgerly.core.errors import RateError\nfrom ledgerly.core.money import HOME_CURRENCY, check_currency\n\nMAX_STALE_DAYS = 7\n\n\nclass RateTable:\n    def __init__(self, home: str = HOME_CURRENCY) -> None:\n        self.home = check_currency(home)\n        self._days: dict[str, list[date]] = defaultdict(list)\n        self._rates: dict[str, list[Decimal]] = defaultdict(list)\n\n    def add(self, currency: str, day: date, rate: Decimal) -> None:\n        currency = check_currency(currency)\n        if currency == self.home:\n            raise RateError(f\"{currency} is the home currency; it has no rate\")\n        if rate <= 0:\n            raise RateError(f\"a rate must be positive, not {rate}\")\n        days, rates = self._days[currency], self._rates[currency]\n        at = bisect.bisect_left(days, day)\n        if at < len(days) and days[at] == day:\n            rates[at] = rate\n        else:\n            days.insert(at, day)\n            rates.insert(at, rate)\n\n    def rate(self, currency: str, day: date) -> Decimal:\n        \"\"\"Home-currency units per unit of ``currency`` on ``day``.\"\"\"\n\n        currency = check_currency(currency)\n        if currency == self.home:\n            return Decimal(1)\n        days = self._days.get(currency)\n        if not days:\n            raise RateError(f\"no exchange rates for {currency}\")\n        at = bisect.bisect_right(days, day) - 1\n        if at < 0:\n            raise RateError(f\"no {currency} rate on or before {day}\")\n        if day - days[at] > timedelta(days=MAX_STALE_DAYS):\n            raise RateError(f\"the latest {currency} rate before {day} is from {days[at]}\")\n        return self._rates[currency][at]\n\n    def currencies(self) -> list[str]:\n        return sorted(self._days)\n\n    def __len__(self) -> int:\n        return sum(len(days) for days in self._days.values())\n\n\ndef load_rates(path: Path, home: str = HOME_CURRENCY) -> RateTable:\n    table = RateTable(home)\n    if not path.exists():\n        return table\n    with path.open(newline=\"\", encoding=\"utf-8\") as handle:\n        for line, row in enumerate(csv.DictReader(handle), start=2):\n            try:\n                table.add(\n                    row[\"currency\"], date.fromisoformat(row[\"date\"]), Decimal(row[\"rate\"].strip())\n                )\n            except (KeyError, ValueError, InvalidOperation) as exc:\n                raise RateError(f\"{path.name}:{line}: {exc}\") from None\n    return table\n\"\"\"Errors the command line reports as ``error: <message>`` with exit status 2.\"\"\"\n\nfrom __future__ import annotations\n\n\nclass LedgerError(Exception):\n    \"\"\"Something the user can fix: a bad file, an unknown account, a missing rate.\"\"\"\n\n\nclass ImportError_(LedgerError):  # noqa: N801 - not the builtin\n    \"\"\"A statement that cannot be read. ``line`` is the 1-based line in the file, if known.\"\"\"\n\n    def __init__(self, message: str, *, source: str = \"\", line: int | None = None) -> None:\n        where = f\"{source}:{line}: \" if source and line else (f\"{source}: \" if source else \"\")\n        super().__init__(f\"{where}{message}\")\n        self.source = source\n        self.line = line\n\n\nclass RateError(LedgerError):\n    \"\"\"No exchange rate for a currency on a date.\"\"\"\n\n\nclass RuleError(LedgerError):\n    \"\"\"A categorisation rule file that cannot be used.\"\"\"\n\"\"\"The ledger file: accounts, rules and transactions in one JSON document.\n\nWrites go to a temporary file that replaces the old one, so a crash never leaves half a ledger.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\nfrom ledgerly.core.accounts import Account, Chart\nfrom ledgerly.core.errors import LedgerError\nfrom ledgerly.core.journal import Journal\nfrom ledgerly.core.transactions import Transaction\nfrom ledgerly.rules.categorize import Rule\n\nFORMAT_VERSION = 2\n\n\ndef load(path: Path) -> tuple[Journal, list[Rule]]:\n    \"\"\"The journal and rules in ``path``; an empty ledger (default categories) if it is missing.\"\"\"\n\n    if not path.exists():\n        return Journal(Chart()), []\n    try:\n        data: dict[str, Any] = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError) as exc:\n        raise LedgerError(f\"cannot read the ledger {path}: {exc}\") from None\n    version = data.get(\"version\")\n    if version == 1:\n        data = upgrade_v1(data)\n    elif version != FORMAT_VERSION:\n        raise LedgerError(f\"{path} is ledger format {version!r}; this ledgerly reads 1 and 2\")\n    chart = Chart([Account.from_dict(item) for item in data.get(\"accounts\", [])])\n    journal = Journal(chart)\n    journal.extend(Transaction.from_dict(item) for item in data.get(\"transactions\", []))\n    rules = [Rule.from_dict(item) for item in data.get(\"rules\", [])]\n    return journal, rules\n\n\ndef save(path: Path, journal: Journal, rules: list[Rule]) -> None:\n    document = {\n        \"version\": FORMAT_VERSION,\n        \"accounts\": [a.to_dict() for a in journal.chart.all()],\n        \"rules\": [r.to_dict() for r in rules],\n        \"transactions\": [t.to_dict() for t in journal],\n    }\n    path.parent.mkdir(parents=True, exist_ok=True)\n    handle, temporary = tempfile.mkstemp(prefix=\".ledger-\", dir=path.parent)\n    try:\n        with os.fdopen(handle, \"w\", encoding=\"utf-8\") as out:\n            json.dump(document, out, indent=1, ensure_ascii=False)\n            out.write(\"\\n\")\n        os.replace(temporary, path)\n    except BaseException:\n        Path(temporary).unlink(missing_ok=True)\n        raise\n\n\ndef upgrade_v1(data: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Format 1 kept categories as plain strings and had no rules.\"\"\"\n\n    accounts = list(data.get(\"accounts\", []))\n    known = {item[\"id\"] for item in accounts}\n    for name in data.get(\"categories\", []):\n        if name not in known:\n            accounts.append({\"id\": name, \"name\": name.replace(\"-\", \" \").title(), \"kind\": \"expense\"})\n    return {\n        \"version\": FORMAT_VERSION,\n        \"accounts\": accounts,\n        \"rules\": [],\n        \"transactions\": data.get(\"transactions\", []),\n    }\ntests/test_import.py:6:from ledgerly.io.bank_formats import parse_amount\ntests/test_import.py:31:        self.assertEqual(parse_amount(\"1.234,56\", decimal_comma=True), Decimal(\"1234.56\"))\ntests/test_import.py:32:        self.assertEqual(parse_amount(\"-12,50\", decimal_comma=True), Decimal(\"-12.50\"))\ntests/test_import.py:33:        self.assertIsNone(parse_amount(\"  \", decimal_comma=True))\ntests/test_import.py:36:        self.assertEqual(parse_amount(\"+1,250.00\", decimal_comma=False), Decimal(\"1250.00\"))\ntests/test_import.py:37:        self.assertIsNone(parse_amount(\"abc\", decimal_comma=False))\ntests/test_import.py:52:    def test_rabo_skips_balance_lines(self):\ntests/test_import.py:53:        rows = read_statement(write(RABO), \"rabo\", \"checking\")\ntests/test_import.py:68:        first = import_statement(book, path, \"rabo\", \"checking\", Categorizer([]))\ntests/test_import.py:69:        again = import_statement(book, path, \"rabo\", \"checking\", Categorizer([]))\n","exit_code":1,"status":"failed"}}
