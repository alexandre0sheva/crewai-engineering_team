{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\nfor parent in reversed((Path.cwd(), *Path.cwd().parents)):\n    path = parent / 'AGENTS.md'\n    if path.exists():\n        print(f'{path}:\\\\n{path.read_text()}')\nPY\ncat ledgerly/rules/categorize.py ledgerly/reports/render.py tests/test_rules_fx_reports.py\"","aggregated_output":"\"\"\"Rules that put transactions in categories. The first rule that matches wins; income and\nexpenses with no matching rule fall back to ``other-income`` and ``uncategorised``.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\n\nfrom ledgerly.core.errors import RuleError\nfrom ledgerly.core.transactions import Transaction\nfrom ledgerly.rules.matchers import Matcher, parse_matcher\n\nBUILT_IN = (\n    (\"salary\", [\"description regex \\\\b(salaris|salary|loon)\\\\b\"]),\n    (\"interest\", [\"description contains rente\"]),\n    (\"groceries\", [\"counterparty regex (albert heijn|jumbo|lidl|aldi|plus)\"]),\n    (\"rent\", [\"description contains huur\"]),\n    (\"utilities\", [\"counterparty regex (vattenfall|eneco|essent|waternet|ziggo|kpn)\"]),\n    (\"transport\", [\"counterparty regex (\\\\bns\\\\b|ov-chipkaart|gvb|ret|shell|bp)\"]),\n    (\"eating-out\", [\"description regex (restaurant|cafe|café|thuisbezorgd)\"]),\n    (\"subscriptions\", [\"counterparty regex (spotify|netflix|disney|icloud)\"]),\n)\n\n\n@dataclass\nclass Rule:\n    category: str\n    matchers: list[Matcher]\n    name: str = \"\"\n    income_only: bool = False\n    expense_only: bool = False\n    hits: int = field(default=0, compare=False)\n\n    def __post_init__(self) -> None:\n        if not self.matchers:\n            raise RuleError(f\"rule {self.name or self.category!r} has no matchers\")\n        if self.income_only and self.expense_only:\n            raise RuleError(\"a rule cannot be for income only and expenses only\")\n\n    def matches(self, transaction: Transaction) -> bool:\n        if self.income_only and not (transaction.amount or 0) > 0:\n            return False\n        if self.expense_only and not (transaction.amount or 0) < 0:\n            return False\n        return all(m.matches(transaction) for m in self.matchers)\n\n    def to_dict(self) -> dict[str, object]:\n        return {\n            \"category\": self.category,\n            \"name\": self.name,\n            \"matchers\": [m.to_dict() for m in self.matchers],\n            \"income_only\": self.income_only,\n            \"expense_only\": self.expense_only,\n        }\n\n    @classmethod\n    def from_dict(cls, data: dict[str, object]) -> Rule:\n        raw = data.get(\"matchers\") or []\n        return cls(\n            category=str(data[\"category\"]),\n            matchers=[Matcher(**item) for item in raw],  # type: ignore[union-attr, arg-type]\n            name=str(data.get(\"name\", \"\")),\n            income_only=bool(data.get(\"income_only\", False)),\n            expense_only=bool(data.get(\"expense_only\", False)),\n        )\n\n\ndef built_in_rules() -> list[Rule]:\n    return [\n        Rule(category, [parse_matcher(text) for text in texts], name=f\"built-in {category}\")\n        for category, texts in BUILT_IN\n    ]\n\n\nclass Categorizer:\n    \"\"\"The ledger's own rules first, then the built-in ones.\"\"\"\n\n    def __init__(self, rules: list[Rule], *, use_built_in: bool = True) -> None:\n        self.rules = list(rules) + (built_in_rules() if use_built_in else [])\n\n    def category_for(self, transaction: Transaction) -> str:\n        for rule in self.rules:\n            if rule.matches(transaction):\n                rule.hits += 1\n                return rule.category\n        return \"other-income\" if (transaction.amount or 0) > 0 else \"uncategorised\"\n\n    def explain(self, transaction: Transaction) -> str:\n        for rule in self.rules:\n            if rule.matches(transaction):\n                return f\"{rule.category} (rule {rule.name or rule.category})\"\n        return f\"{self.category_for(transaction)} (no rule matched)\"\n\"\"\"Plain-text rendering of reports, for the terminal.\"\"\"\n\nfrom __future__ import annotations\n\nfrom decimal import Decimal\n\nfrom ledgerly.core.money import Money\nfrom ledgerly.reports.balance import Balance, net_worth\nfrom ledgerly.reports.income import CategoryLine, IncomeStatement\nfrom ledgerly.util.text import shorten\n\nNAME_WIDTH = 24\nAMOUNT_WIDTH = 16\n\n\ndef amount_cell(value: Money) -> str:\n    return str(value).rjust(AMOUNT_WIDTH)\n\n\ndef percent(value: Decimal | None) -> str:\n    if value is None:\n        return \"     –\"\n    return f\"{value * 100:+5.0f}%\"\n\n\ndef _line(line: CategoryLine, compare: bool) -> str:\n    text = f\"  {shorten(line.name, NAME_WIDTH):<{NAME_WIDTH}}{amount_cell(line.amount)}\"\n    text += f\"  ({line.count})\"\n    if compare:\n        text += f\"  {percent(line.change)}\"\n    return text\n\n\ndef render_income(statement: IncomeStatement, *, compare: bool = False) -> str:\n    out = [f\"Income and expenses, {statement.period.label}\", \"\"]\n    out.append(\"Income\")\n    out += [_line(line, compare) for line in statement.income] or [\"  (none)\"]\n    out.append(f\"  {'Total income':<{NAME_WIDTH}}{amount_cell(statement.total_income)}\")\n    out += [\"\", \"Expenses\"]\n    out += [_line(line, compare) for line in statement.expenses] or [\"  (none)\"]\n    out.append(f\"  {'Total expenses':<{NAME_WIDTH}}{amount_cell(statement.total_expenses)}\")\n    out += [\"\", f\"  {'Net':<{NAME_WIDTH}}{amount_cell(statement.net)}\"]\n    if statement.savings_rate is not None:\n        out.append(f\"  {'Savings rate':<{NAME_WIDTH}}{statement.savings_rate * 100:>14.1f} %\")\n    return \"\\n\".join(out) + \"\\n\"\n\n\ndef render_balances(rows: list[Balance], currency: str) -> str:\n    out = []\n    for row in rows:\n        own = \"\" if row.own.currency == currency else f\"  ({row.own})\"\n        out.append(f\"{shorten(row.name, NAME_WIDTH):<{NAME_WIDTH}}{amount_cell(row.home)}{own}\")\n    out.append(f\"{'Net worth':<{NAME_WIDTH}}{amount_cell(net_worth(rows, currency))}\")\n    return \"\\n\".join(out) + \"\\n\"\nimport unittest\nfrom datetime import date\nfrom decimal import Decimal\n\nfrom ledgerly.core.errors import RateError, RuleError\nfrom ledgerly.core.periods import parse_period\nfrom ledgerly.fx.convert import to_home\nfrom ledgerly.fx.rates import RateTable\nfrom ledgerly.reports.balance import balances\nfrom ledgerly.reports.income import income_statement\nfrom ledgerly.reports.render import render_income\nfrom ledgerly.rules.categorize import Categorizer, Rule\nfrom ledgerly.rules.matchers import Matcher, parse_matcher\n\nfrom tests.helpers import journal, txn\n\n\nclass RulesTest(unittest.TestCase):\n    def test_built_in_rules(self):\n        categorizer = Categorizer([])\n        self.assertEqual(categorizer.category_for(txn(\"-30\", counterparty=\"Lidl\")), \"groceries\")\n        self.assertEqual(categorizer.category_for(txn(\"10\")), \"other-income\")\n        self.assertEqual(categorizer.category_for(txn(\"-10\")), \"uncategorised\")\n\n    def test_own_rules_come_first(self):\n        rule = Rule(\"eating-out\", [parse_matcher(\"counterparty contains lidl\")], expense_only=True)\n        categorizer = Categorizer([rule])\n        self.assertEqual(categorizer.category_for(txn(\"-3\", counterparty=\"LIDL\")), \"eating-out\")\n\n    def test_amount_matchers(self):\n        self.assertTrue(Matcher(\"amount\", \"between\", \"10..20\").matches(txn(\"-15\")))\n        self.assertFalse(Matcher(\"amount\", \"above\", \"100\").matches(txn(\"-15\")))\n        with self.assertRaises(RuleError):\n            Matcher(\"amount\", \"contains\", \"1\")\n\n\nclass RatesTest(unittest.TestCase):\n    def test_latest_rate_up_to_a_week_old(self):\n        table = RateTable()\n        table.add(\"USD\", date(2026, 3, 2), Decimal(\"0.92\"))\n        self.assertEqual(table.rate(\"USD\", date(2026, 3, 7)), Decimal(\"0.92\"))\n        self.assertEqual(to_home(Decimal(\"10\"), \"USD\", table, date(2026, 3, 3)), Decimal(\"9.20\"))\n        self.assertEqual(table.rate(\"EUR\", date(2026, 3, 7)), Decimal(1))\n        with self.assertRaises(RateError):\n            table.rate(\"USD\", date(2026, 3, 20))\n\n\nclass ReportsTest(unittest.TestCase):\n    def setUp(self):\n        self.book = journal()\n        self.book.extend([\n            txn(\"2500.00\", description=\"Salaris maart\", category=\"salary\"),\n            txn(\"-80.25\", day=date(2026, 3, 9), category=\"groceries\"),\n            txn(\"-1020.00\", day=date(2026, 3, 1), category=\"rent\"),\n            txn(\"-40.00\", day=date(2026, 2, 9), category=\"groceries\"),\n        ])  # fmt: skip\n\n    def test_income_statement(self):\n        statement = income_statement(self.book, parse_period(\"2026-03\"), RateTable())\n        self.assertEqual(str(statement.total_income), \"2,500.00 EUR\")\n        self.assertEqual(str(statement.total_expenses), \"-1,100.25 EUR\")\n        self.assertEqual([line.category for line in statement.expenses], [\"rent\", \"groceries\"])\n        text = render_income(statement)\n        self.assertIn(\"Net                         1,399.75 EUR\", text)\n\n    def test_balances(self):\n        rows = balances(self.book, RateTable(), date(2026, 3, 31))\n        self.assertEqual([row.account for row in rows], [\"checking\", \"card\"])\n        self.assertEqual(str(rows[0].own), \"1,359.75 EUR\")\n        self.assertEqual(str(rows[1].own), \"0.00 EUR\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","exit_code":0,"status":"completed"}}
