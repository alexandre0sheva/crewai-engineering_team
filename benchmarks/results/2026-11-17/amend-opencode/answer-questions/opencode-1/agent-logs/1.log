ING_DAYS\n\nTRANSIT_DAYS = {\"NL\": 1, \"BE\": 2, \"DE\": 2, \"LU\": 2}\nDEFAULT_TRANSIT_DAYS = 4\nCUTOFF_HOUR = 15  # orders placed at or after 15:00 are handled from the next day\n\n\ndef add_working_days(start: date, days: int) -> date:\n    \"\"\"``start`` plus ``days`` working days: Saturdays and Sundays are skipped (holidays are not).\"\"\"\n\n    current = start\n    while days > 0:\n        current += timedelta(days=1)\n        if current.weekday() < 5:","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out2/amend-opencode/answer-questions/opencode-1/repo/parcels/delivery.py","text":"\"\"\"When an order arrives.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date, datetime, timedelta\n\nfrom parcels.settings import HANDLING_DAYS\n\nTRANSIT_DAYS = {\"NL\": 1, \"BE\": 2, \"DE\": 2, \"LU\": 2}\nDEFAULT_TRANSIT_DAYS = 4\nCUTOFF_HOUR = 15  # orders placed at or after 15:00 are handled from the next day\n\n\ndef add_working_days(start: date, days: int) -> date:\n    \"\"\"``start`` plus ``days`` working days: Saturdays and Sundays are skipped (holidays are not).\"\"\"\n\n    current = start\n    while days > 0:\n        current += timedelta(days=1)\n        if current.weekday() < 5:\n            days -= 1\n    return current\n\n\ndef delivery_date(ordered: datetime, country: str) -> date:\n    start = ordered.date()\n    if ordered.hour >= CUTOFF_HOUR:\n        start += timedelta(days=1)\n    transit = TRANSIT_DAYS.get(country.upper(), DEFAULT_TRANSIT_DAYS)\n    return add_working_days(start, HANDLING_DAYS + transit)","lineStart":1,"lineEnd":30,"totalLines":30,"truncated":false}},"title":"parcels/delivery.py","time":{"start":1794914525831,"end":1794914525835}},"id":"prt_1e93e223d001EuVcaT4dLo2CnT","sessionID":"ses_e16c29ae3ffeLmKp3aWafWpYBG","messageID":"msg_1e93e1347001z6OzdHeSiu0J1r"}}
