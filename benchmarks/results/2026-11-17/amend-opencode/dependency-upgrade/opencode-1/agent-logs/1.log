")\n44:     return rows\n\n(End of file - total 44 lines)\n</content>","metadata":{"preview":"\"\"\"Invoice lines and their total.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom decimal import Decimal\n\nfrom moneyfmt import MoneyFormatError, format_money, parse_money\n\nCURRENCY = \"EUR\"\n\n\nclass InvoiceError(ValueError):\n    pass\n\n\n@dataclass(frozen=True)\nclass Line:\n    description: str\n    amount: Decimal","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out2/amend-opencode/dependency-upgrade/opencode-1/repo/invoicer/totals.py","text":"\"\"\"Invoice lines and their total.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom decimal import Decimal\n\nfrom moneyfmt import MoneyFormatError, format_money, parse_money\n\nCURRENCY = \"EUR\"\n\n\nclass InvoiceError(ValueError):\n    pass\n\n\n@dataclass(frozen=True)\nclass Line:\n    description: str\n    amount: Decimal\n\n\ndef parse_line(text: str) -> Line:\n    \"\"\"``\"Design=1,200.00\"`` -> a line.\"\"\"\n\n    description, sep, amount = text.partition(\"=\")\n    if not sep or not description.strip():\n        raise InvoiceError(f\"a line is DESCRIPTION=AMOUNT, not {text!r}\")\n    try:\n        return Line(description.strip(), parse_money(amount))\n    except MoneyFormatError as exc:\n        raise InvoiceError(str(exc)) from None\n\n\ndef total(lines: list[Line]) -> Decimal:\n    return sum((line.amount for line in lines), Decimal(\"0\"))\n\n\ndef render(lines: list[Line]) -> list[str]:\n    rows = [\n        f\"{line.description:<24}{format_money(line.amount, currency=CURRENCY):>14}\" for line in lines\n    ]\n    rows.append(f\"{'Total':<24}{format_money(total(lines), currency=CURRENCY):>14}\")\n    return rows","lineStart":1,"lineEnd":44,"totalLines":44,"truncated":false}},"title":"invoicer/totals.py","time":{"start":1794914629840,"end":1794914629845}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1e93fb8c8001Tzmwa0XsFcdxKC","sessionID":"ses_e16c18aa5ffeKftaTwAhrZX9BX","messageID":"msg_1e93fb534001kXslFwMEyTKmkd"}}
