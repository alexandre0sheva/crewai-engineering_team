s(value):,.2f}\"\n\n\ndef parse_money(text):\n    \"\"\"``parse_money(\"1,234.50\")`` -> ``1234.5`` (a float); currency symbols are ignored.\"\"\"\n\n    cleaned = text.strip()\n    for symbol in CURRENCIES.values():\n        cleaned = cleaned.replace(symbol, \"\")\n    cleaned = cleaned.replace(\",\", \"\")\n    try:\n        return float(Decimal(cleaned))\n    except InvalidOperation:\n        raise MoneyError(f\"cannot read amount {text!r}\") from None","lineStart":1,"lineEnd":37,"totalLines":37,"truncated":false}},"title":"vendor/moneyfmt/__init__.py","time":{"start":1794914551784,"end":1794914551804}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the vendored moneyfmt versions.","format":"unknown","index":0}]}},"id":"prt_1e93e87d7001AxC0g9k9N9N3kY","sessionID":"ses_e16c18aa5ffeKftaTwAhrZX9BX","messageID":"msg_1e93e8455001OT1PACKd2gDZoj"}}
