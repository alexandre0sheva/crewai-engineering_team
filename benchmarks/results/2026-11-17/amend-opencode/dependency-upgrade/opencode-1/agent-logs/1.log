{"type":"tool_use","timestamp":1794914668137,"sessionID":"ses_e16c18aa5ffeKftaTwAhrZX9BX","part":{"type":"tool","tool":"write","callID":"call_cd36c45a3c974858976e8fb2","state":{"status":"completed","input":{"content":"\"\"\"Guards for the moneyfmt 2.0.0 API.\n\nmoneyfmt 2.0.0 changed three things the invoicer depends on: ``parse_money`` returns a\n``Decimal`` instead of a ``float``, ``format_money`` takes a ``Decimal`` only and a\nkeyword-only ``currency``, and ``MoneyError`` was renamed ``MoneyFormatError``.\n\"\"\"\n\nimport ast\nimport subprocess\nimport sys\nimport unittest\nfrom decimal import Decimal\nfrom pathlib import Path\n\nimport invoicer  # noqa: F401  -- puts the vendored moneyfmt on sys.path\nimport moneyfmt\n\nfrom invoicer import totals\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nRELEASED_COPY = REPO_ROOT / \"vendor-updates\" / \"moneyfmt-2.0.0\" / \"moneyfmt\" / \"__init__.py\"\n\n# Names moneyfmt 2.0.0 removed; the invoicer must not use them any more.\nREMOVED_NAMES = {\"MoneyError\"}\n\n\nclass VendoredMoneyfmtTest(unittest.TestCase):\n    def test_vendored_copy_is_the_released_2_0_0(self):\n        self.assertEqual(moneyfmt.__version__, \"2.0.0\")\n\n    def test_vendored_files_are_unmodified(self):\n        if not RELEASED_COPY.exists():  # the release was unpacked and cleaned up\n            self.skipTest(f\"{RELEASED_COPY} is not available\")\n        self.assertEqual(\n            Path(moneyfmt.__file__).read_bytes(),\n            RELEASED_COPY.read_bytes(),\n        )\n\n    def test_money_error_was_renamed(self):\n        self.assertFalse(hasattr(moneyfmt, \"MoneyError\"))\n        self.assertTrue(issubclass(moneyfmt.MoneyFormatError, ValueError))\n\n\nclass MoneyfmtApiTest(unittest.TestCase):\n    \"\"\"The 2.0.0 API itself: these are what the invoicer is written against.\"\"\"\n\n    def test_parse_money_returns_a_decimal(self):\n        self.assertIsInstance(moneyfmt.parse_money(\"1,200.00\"), Decimal)\n\n    def test_format_money_rejects_a_float(self):\n        with self.assertRaises(TypeError):\n            moneyfmt.format_money(1200.00, currency=\"EUR\")\n\n    def test_format_money_takes_a_keyword_only_currency(self):\n        with self.assertRaises(TypeError):\n            moneyfmt.format_money(Decimal(\"1200.00\"), \"EUR\")\n\n\nclass InvoicerUsesTheCurrentApiTest(unittest.TestCase):\n    \"\"\"The invoicer code must not touch anything 2.0.0 removed or changed.\"\"\"\n\n    @staticmethod\n    def _totals_tree():\n        return ast.parse(Path(totals.__file__).read_text(encoding=\"utf-8\"))\n\n    def test_no_removed_moneyfmt_names_are_used(self):\n        names = {node.id for node in ast.walk(self._totals_tree()) if isinstance(node, ast.Name)}\n        self.assertEqual(names & REMOVED_NAMES, set())\n\n    def test_format_money_is_called_with_a_keyword_currency(self):\n        calls = [\n            node\n            for node in ast.walk(self._totals_tree())\n            if isinstance(node, ast.Call)\n            and isinstance(node.func, ast.Name)\n            and node.func.id == \"format_money\"\n        ]\n        self.assertTrue(calls, \"no format_money() call found in invoicer/totals.py\")\n        for call in calls:\n            self.assertTrue(\n                any(keyword.arg == \"currency\" for keyword in call.keywords),\n                \"format_money() takes a keyword-only currency since moneyfmt 2.0.0\",\n            )\n\n\nclass AmountsTest(unittest.TestCase):\n    def test_amounts_are_decimals(self):\n        line = totals.parse_line(\"Design=1,200.00\")\n        self.assertIsInstance(line.amount, Decimal)\n        self.assertIsInstance(totals.total([line]), Decimal)\n\n    def test_total_is_an_exact_decimal(self):\n        # 0.005 + 0.03 is exactly 0.035, which rounds half up to 0.04; as floats the\n        # sum lands just below 0.035 and used to be billed as 0.03.\n        lines = [totals.parse_line(\"A=0.005\"), totals.parse_line(\"B=0.03\")]\n        self.assertEqual(totals.total(lines), Decimal(\"0.035\"))\n        self.assertEqual(totals.render(lines)[-1], \"Total                            €0.04\")\n\n\nclass CliTest(unittest.TestCase):\n    def run_cli(self, *args):\n        return subprocess.run(\n            [sys.executable, \"-m\", \"invoicer\", *args],\n            cwd=REPO_ROOT,\n            capture_output=True,\n            text=True,\n        )\n\n    def test_prints_the_invoice(self):\n        proc = self.run_cli(\"Design=1,200.00\", \"Hosting=49.99\")\n        self.assertEqual(proc.returncode, 0)\n        self.assertEqual(proc.stderr, \"\")\n        self.assertEqual(\n            proc.stdout,\n            \"Design                       €1,200.00\\n\"\n            \"Hosting                         €49.99\\n\"\n            \"Total                        €1,249.99\\n\",\n        )\n\n    def test_unreadable_amount_is_an_error(self):\n        proc = self.run_cli(\"Design=lots\")\n        self.assertEqual(proc.returncode, 2)\n        self.assertEqual(proc.stdout, \"\")\n        self.assertEqual(proc.stderr, \"error: cannot read amount 'lots'\\n\")\n\n    def test_missing_amount_is_an_error(self):\n        proc = self.run_cli(\"no amount\")\n        self.assertEqual(proc.returncode, 2)\n        self.assertEqual(proc.stdout, \"\")\n        self.assertEqual(proc.stderr, \"error: a line is DESCRIPTION=AMOUNT, not 'no amount'\\n\")\n\n    def test_without_arguments_it_prints_usage(self):\n        proc = self.run_cli()\n        self.assertEqual(proc.returncode, 2)\n        self.assertEqual(proc.stdout, \"\")\n        self.assertEqual(proc.stderr, 'usage: python -m invoicer \"DESCRIPTION=AMOUNT\" ...\\n')\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","filePath":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out2/amend-opencode/dependency-upgrade/opencode-1/repo/tests/test_moneyfmt_api.py"},"output":"Wrote file successfully.","metadata":{