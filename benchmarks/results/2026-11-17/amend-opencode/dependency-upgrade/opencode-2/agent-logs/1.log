\\"A=abc\\\"]\": {\n    \"returncode\": 2,\n    \"stderr\": \"error: cannot read amount 'abc'\\n\",\n    \"stdout\": \"\"\n  },\n  \"[\\\"Design=  12.50  \\\"]\": {\n    \"returncode\": 0,\n    \"stderr\": \"\",\n    \"stdout\": \"Design                          \\u20ac12.50\\nTotal                           \\u20ac12.50\\n\"\n  },\n  \"[\\\"Design=\\\"]\": {\n    \"returncode\": 2,\n    \"stderr\": \"error: cannot read amount ''\\n\",\n    \"stdout\": \"\"\n  },\n  \"[\\\"Design=0.10\\\", \\\"Hosting=0.20\\\"]\": {\n    \"returncode\": 0,\n    \"stderr\": \"\",\n    \"stdout\": \"Design                           \\u20ac0.10\\nHosting                          \\u20ac0.20\\nTotal                            \\u20ac0.30\\n\"\n  },\n  \"[\\\"Design=1,200.00\\\", \\\"Hosting=49.99\\\"]\": {\n    \"returncode\": 0,\n    \"stderr\": \"\",\n    \"stdout\": \"Design                       \\u20ac1,200.00\\nHosting                         \\u20ac49.99\\nTotal                        \\u20ac1,249.99\\n\"\n  },\n  \"[\\\"Design=lots\\\"]\": {\n    \"returncode\": 2,\n    \"stderr\": \"error: cannot read amount 'lots'\\n\",\n    \"stdout\": \"\"\n  },\n  \"[\\\"Hosting=\\\\u20ac49.99\\\"]\": {\n    \"returncode\": 0,\n    \"stderr\": \"\",\n    \"stdout\": \"Hosting                         \\u20ac49.99\\nTotal                           \\u20ac49.99\\n\"\n  },\n  \"[\\\"no amount\\\"]\": {\n    \"returncode\": 2,\n    \"stderr\": \"error: a line is DESCRIPTION=AMOUNT, not 'no amount'\\n\",\n    \"stdout\": \"\"\n  },\n  \"[]\": {\n    \"returncode\": 2,\n    \"stderr\": \"usage: python -m invoicer \\\"DESCRIPTION=AMOUNT\\\" ...\\n\",\n    \"stdout\": \"\"\n  }\n}\n","exit":0,"truncated":false},"title":"python3 /var/folders/x0/hfd1bt5s0kg52khnx8h3qm2w0000gp/T/opencode/baseline.py > /var/folders/x0/hfd1bt5s0kg52khnx8h3qm2w0000gp/T/opencode/baseline.json; cat /var/folders/x0/hfd1bt5s0kg52khnx8h3qm2w0000gp/T/opencode/baseline.json","time":{"start":1794914603413,"end":1794914604674}},"m