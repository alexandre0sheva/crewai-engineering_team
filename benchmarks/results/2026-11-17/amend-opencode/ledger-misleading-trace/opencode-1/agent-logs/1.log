    str(self.amount),\n37:                 self.currency,\n38:                 self.description.strip().lower(),\n39:                 (self.counter_iban or \"\").upper(),\n40:             ]\n41:         )\n42:         return hashlib.sha256(key.encode()).hexdigest()[:16]\n43: \n44:     @property\n45:     def is_income(self) -> bool:\n46:         return self.amount > 0\n47: \n48:     def categorised(self, category: str) -> Transaction:\n49:         return replace(self, category=category)\n50: \n51:     def tagged(self, *tags: str) -> Transaction:\n52:         return replace(self, tags=self.tags | frozenset(tags))\n53: \n54:     def to_dict(self) -> dict[str, object]:\n55:         return {\n56:             \"account\": self.account,\n57:             \"booked\": self.booked.isoformat(),\n58:             \"amount\": None if self.amount is None else str(self.amount),\n59:             \"currency\": self.currency,\n60:             \"description\": self.description,\n61:             \"counterparty\": self.counterparty,\n62:             \"counter_iban\": self.counter_iban,\n63:             \"category\": self.category,\n64:             \"source\": self.source,\n65:             \"tags\": sorted(self.tags),\n66:         }\n67: \n68:     @classmethod\n69:     def from_dict(cls, data: dict[str, object]) -> Transaction:\n70:         raw = data.get(\"amount\")\n71:         return cls(\n72:             account=str(data[\"account\"]),\n73:             booked=date.fromisoformat(str(data[\"booked\"])),\n74:             amount=None if raw is None else Decimal(str(raw)),  # type: ignore[arg-type]\n75:             currency=str(data[\"currency\"]),\n76:             description=str(data.get(\"description\", \"\")),\n77:             counterparty=str(data.get(\"counterparty\", \"\")),\n78:             counter_iban=data.get(\"counter_iban\") or None,  # type: ignore[arg-type]\n79:             category=data.get(\"category\") or None,  # type: ignore[arg-type]\n80:             source=str(data.get(\"source\", \"\")),\n81:             tags=frozenset(data.get(\"tags\") or []),  # type: ignore[arg-type]\n82:         )\n\n(End of file - total 82 lines)\n</content>","metadata":{"preview":"\"\"\"A transaction: one line of a bank statement, after import.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nfrom dataclasses import dataclass, field, replace\nfrom datetime import date\nfrom decimal import Decimal\n\n\n@dataclass(frozen=True)\nclass Transaction:\n    \"\"\"Money moving into (positive ``amount``) or out of (negative) an asset or liability\n    ``account``, in that account's statement currency. ``category`` is the income or expense\n    account it belongs to (``None`` until categorised).\"\"\"\n\n    account: str\n    booked: date\n    amount: Decimal\n    currency: str","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out2/amend-opencode/ledger-misleading-trace/opencode-1/repo/ledgerly/core/transactions.py","text":"\"\"\"A transaction: one line of a bank statement, after import.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nfrom dataclasses import dataclass, field, replace\nfrom datetime import date\nfrom decimal import Decimal\n\n\n@dataclass(frozen=True)\nclass Transaction:\n    \"\"\"Money moving into (positive ``amount``) or out of (negative) an asset or liability\n    ``account``, in that account's statement currency. ``category`` is the income or expense\n    account it belongs to (``None`` until categorised).\"\"\"\n\n    account: str\n    booked: date\n    amount: Decimal\n    currency: str\n    description: str\n    counterparty: str = \"\"\n    counter_iban: str | None = None\n    category: str | None = None\n    source: str = \"\"  # \"<file>:<line>\" it was imported from\n    tags: frozenset[str] = field(default_factory=frozenset)\n\n    @property\n    def fingerprint(self) -> str:\n        \"\"\"Stable identity for de-duplication: the same statement line imported twice.\"\"\"\n\n        key = \"|\".join(\n            [\n                self.account,\n                self.booked.isoformat(),\n                str(self.amount),\n                self.currency,\n                self.description.strip().lower(),\n                (self.counter_iban or \"\").upper(),\n            ]\n        )\n        return hashlib.sha256(key.encode()).hexdigest()[:16]\n\n    @property\n    def is_income(self) -> bool:\n        return self.amount > 0\n\n    def categorised(self, category: str) -> Transaction:\n        return replace(self, category=category)\n\n    def tagged(self, *tags: str) -> Transaction:\n        return replace(self, tags=self.tags | frozenset(tags))\n\n    def to_dict(self) -> dict[str, object]:\n        return {\n            \"account\": self.account,\n            \"booked\": self.booked.isoformat(),\n            \"amount\": None if self.amount is None else str(self.amount),\n            \"currency\": self.currency,\n            \"description\": self.description,\n            \"counterparty\": self.counterparty,\n            \"counter_iban\": self.counter_iban,\n            \"category\": self.category,\n            \"source\": self.source,\n            \"tags\": sorted(self.tags),\n        }\n\n    @classmethod\n    def from_dict(cls, data: dict[str, object]) -> Transaction:\n        raw = data.get(\"amount\")\n        return cls(\n            account=str(data[\"account\"]),\n            booked=date.fromisoformat(str(data[\"booked\"])),\n            amount=None if raw is None else Decimal(str(raw)),  # type: ignore[arg-type]\n            currency=str(data[\"currency\"]),\n            description=str(data.get(\"description\", \"\")),\n            counterparty=str(data.get(\"counterparty\", \"\")),\n            counter_iban=data.get(\"counter_iban\") or None,  # type: ignore[arg-type]\n            category=data.get(\"category\") or None,  # type: ignore[arg-type]\n            source=str(data.get(\"source\", \"\")),\n            tags=frozenset(data.get(\"tags\") or []),  # type: ignore[arg-type]\n        )","lineStart":1,"lineEnd":82,"totalLines":82,"truncated":false}},"title":"ledgerly/core/transactions.py","time":{"start":1794914850025,"end":1794914850084}},"id":"prt_1e94314e6001RILTyC5kc7SBD9","sessionID":"ses_e16bf3244ffe3dp0Kl8aoaMvCb","messageID":"msg_1e9430c12001SO9dgkL3FjW8wG"}}
