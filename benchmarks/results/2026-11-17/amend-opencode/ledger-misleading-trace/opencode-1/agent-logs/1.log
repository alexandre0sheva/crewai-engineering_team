 bad file, an unknown account, a missing rate.\"\"\"\n\n\nclass ImportError_(LedgerError):  # noqa: N801 - not the builtin\n    \"\"\"A statement that cannot be read. ``line`` is the 1-based line in the file, if known.\"\"\"\n\n    def __init__(self, message: str, *, source: str = \"\", line: int | None = None) -> None:\n        where = f\"{source}:{line}: \" if source and line else (f\"{source}: \" if source else \"\")\n        super().__init__(f\"{where}{message}\")\n        self.source = source\n        self.line = line\n\n\nclass RateError(LedgerError):","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out2/amend-opencode/ledger-misleading-trace/opencode-1/repo/ledgerly/core/errors.py","text":"\"\"\"Errors the command line reports as ``error: <message>`` with exit status 2.\"\"\"\n\nfrom __future__ import annotations\n\n\nclass LedgerError(Exception):\n    \"\"\"Something the user can fix: a bad file, an unknown account, a missing rate.\"\"\"\n\n\nclass ImportError_(LedgerError):  # noqa: N801 - not the builtin\n    \"\"\"A statement that cannot be read. ``line`` is the 1-based line in the file, if known.\"\"\"\n\n    def __init__(self, message: str, *, source: str = \"\", line: int | None = None) -> None:\n        where = f\"{source}:{line}: \" if source and line else (f\"{source}: \" if source else \"\")\n        super().__init__(f\"{where}{message}\")\n        self.source = source\n        self.line = line\n\n\nclass RateError(LedgerError):\n    \"\"\"No exchange rate for a currency on a date.\"\"\"\n\n\nclass RuleError(LedgerError):\n    \"\"\"A categorisation rule file that cannot be used.\"\"\"","lineStart":1,"lineEnd":25,"totalLines":25,"truncated":false}},"title":"ledgerly/core/errors.py","time":{"start":1794914847487,"end":1794914847508}},"id":"prt_1e9430afc001PORJHBkfmaqqRB","sessionID":"ses_e16bf3244ffe3dp0Kl8aoaMvC