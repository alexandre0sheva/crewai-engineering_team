me(transaction.amount, transaction.currency, rates, transaction.booked)\n36:                 amount += home if account.currency == rates.home else Decimal(\"0\")\n37:         own = Money(amount, account.currency)\n38:         home_value = to_home(amount, account.currency, rates, on)\n39:         found.append(Balance(account.id, account.name, own, Money(home_value, rates.home)))\n40:     return found\n41: \n42: \n43: def net_worth(rows: list[Balance], currency: str) -> Money:\n44:     result = Money(Decimal(\"0\"), currency)\n45:     for row in rows:\n46:         result = result + row.home\n47:     return result\n\n(End of file - total 47 lines)\n</content>","metadata":{"preview":"\"\"\"Account balances: the sum of each money account's transactions up to a day.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import date\nfrom decimal import Decimal\n\nfrom ledgerly.core.journal import Journal\nfrom ledgerly.core.money import Money\nfrom ledgerly.fx.convert import to_home\nfrom ledgerly.fx.rates import RateTable\n\n\n@dataclass\nclass Balance:\n    account: str\n    name: str\n    own: Money  # in the account's own currency\n    home: Money  # converted on the day","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-502/-Users-alexander--claude-spares-spare-IwZtqC/50e3bfb1-34ed-4585-ad26-c678e31a5e93/scratchpad/agents-out2/amend-opencode/ledger-misleading-trace/opencode-2/repo/ledgerly/reports/balance.py","text":"\"\"\"Account balances: the sum of each money account's transactions up to a day.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import date\nfrom decimal import Decimal\n\nfrom ledgerly.core.journal import Journal\nfrom ledgerly.core.money import Money\nfrom ledgerly.fx.convert import to_home\nfrom ledgerly.fx.rates import RateTable\n\n\n@dataclass\nclass Balance:\n    account: str\n    name: str\n    own: Money  # in the account's own currency\n    home: Money  # converted on the day\n\n\ndef balances(journal: Journal, rates: RateTable, on: date) -> list[Balance]:\n    found = []\n    for account_id in journal.money_accounts():\n        account = journal.chart.get(account_id)\n        amount = Decimal(\"0\")\n        for transaction in journal.for_account(account_id):\n            if transaction.booked > on:\n                continue\n            if transaction.currency == account.currency:\n                amount += transaction.amount\n            else:\n                # A foreign-currency line on the statement: count it at that day's rate.\n                home = to_home(transaction.amount, transaction.currency, rates, transaction.booked)\n                amount += home if account.currency == rates.home else Decimal(\"0\")\n        own = Money(amount, account.currency)\n        home_value = to_home(amount, account.currency, rates, on)\n        found.append(Balance(account.id, account.name, own, Money(home_value, rates.home)))\n    return found\n\n\ndef net_worth(rows: list[Balance], currency: str) -> Money:\n    result = Money(Decimal(\"0\"), currency)\n    for row in rows:\n        result = result + row.home\n    return result","lineStart":1,"lineEnd":47,"totalLines":47,"truncated":false}},"title":"ledgerly/reports/balance.py","time":{"start":1794915308685,"end":1794915308690}},"id":"prt_1e94a148a0013siy0sQ0JVkQGt","sessionID":"ses_e16be6397ffeTX69h5hAKoGVW8","messageID":"msg_1e949f55b0017UkKNbacfPXRxH"}}
