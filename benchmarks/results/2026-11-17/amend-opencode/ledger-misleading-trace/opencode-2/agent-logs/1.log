rce, line, (\"%Y-%m-%d\",)),\n-            amount=amount,  # type: ignore[arg-type]\n+            amount=amount,\n             currency=(row.get(\"Munt\") or \"EUR\").strip().upper(),\n             description=strip_reference(row.get(\"Omschrijving-1\", \"\")),\n             counterparty=squash(row.get(\"Naam tegenpartij\", \"\")),\ndiff --git a/tests/test_import.py b/tests/test_import.py\nindex 87ea747..73c7084 100644\n--- a/tests/test_import.py\n+++ b/tests/test_import.py\n@@ -3,8 +3,11 @@ from datetime import date\n from decimal import Decimal\n \n from ledgerly.core.errors import ImportError_\n+from ledgerly.core.periods import parse_period\n+from ledgerly.fx.rates import RateTable\n from ledgerly.io.bank_formats import parse_amount\n from ledgerly.io.csv_import import import_statement, read_statement\n+from ledgerly.reports.income import income_statement\n from ledgerly.rules.categorize import Categorizer\n \n from tests.helpers import journal, write\n@@ -25,11 +28,19 @@ RABO = \"\"\"Datum,Bedrag,Munt,Naam tegenpartij,Tegenrekening IBAN/BBAN,Omschrijvin\n 2026-03-06,\"-1.020,00\",EUR,Woonstichting,NL91ABNA0417164300,Huur maart\n \"\"\"\n \n+MARCH = \"\"\"Datum,Bedrag,Munt,Naam tegenpartij,Tegenrekening IBAN/BBAN,Omschrijving-1\n+2026-03-01,,EUR,,,Saldo begin\n+2026-03-02,\"-1.020,00\",EUR,Woonstichting,,Huur maart\n+2026-03-03,\"-64,35\",EUR,Albert Heijn 1403,,Boodschappen\n+2026-03-25,\"+2.750,00\",EUR,Acme BV,,Salaris maart\n+\"\"\"\n+\n \n class AmountTest(unittest.TestCase):\n     def test_decimal_comma(self):\n         self.assertEqual(parse_amount(\"1.234,56\", decimal_comma=True), Decimal(\"1234.56\"))\n         self.assertEqual(parse_amount(\"-12,50\", decimal_comma=True), Decimal(\"-12.50\"))\n+        self.assertEqual(parse_amount(\"+1.234,56\", decimal_comma=True), Decimal(\"1234.56\"))\n         self.assertIsNone(parse_amount(\"  \", decimal_comma=True))\n \n     def test_decimal_point(self):\n@@ -53,6 +64,13 @@ class FormatTest(unittest.TestCase):\n         rows = read_statement(write(RABO), \"rabo\", \"checking\")\n         self.assertEqual([r.amount for r in rows], [Decimal(\"-12.50\"), Decimal(\"-1020.00\")])\n \n+    def test_rabo_reads_a_credit_with_a_plus_sign(self):\n+        rows = read_statement(write(MARCH), \"rabo\", \"checking\")\n+        self.assertEqual(\n+            [r.amount for r in rows],\n+            [Decimal(\"-1020.00\"), Decimal(\"-64.35\"), Decimal(\"2750.00\")],\n+        )\n+\n     def test_errors_name_the_line(self):\n         bad = GENERIC.replace(\"-42.10\", \"lots\")\n         with self.assertRaisesRegex(ImportError_, \"statement.csv:2\"):\n@@ -70,6 +88,22 @@ class ImportTest(unittest.TestCase):\n         self.assertEqual((first.added, again.added, again.duplicates), (2, 0, 2))\n         self.assertEqual(sorted(t.category for t in book), [\"groceries\", \"rent\"])\n \n+    def test_march_import_includes_salary_in_income_report(self):\n+        book = journal()\n+        result = import_statement(book, write(MARCH), \"rabo\", \"checking\", Categorizer([]))\n+        statement = income_statement(book, parse_period(\"2026-03\"), RateTable())\n+        self.assertEqual((result.read, result.added), (3, 3))\n+        self.assertEqual(str(statement.total_income), \"2,750.00 EUR\")\n+        self.assertEqual(str(statement.total_expenses), \"-1,084.35 EUR\")\n+        self.assertEqual(str(statement.net), \"1,665.65 EUR\")\n+\n+    def test_unreadable_rabo_amount_stops_import_without_adding_anything(self):\n+        bad = MARCH.replace('\"+2.750,00\"', '\"2.750\"')\n+        book = journal()\n+        with self.assertRaisesRegex(ImportError_, r\"statement\\.csv:5: cannot read the amount\"):\n+            import_statement(book, write(bad), \"rabo\", \"checking\", Categorizer([]))\n+        self.assertEqual(len(book), 0)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()\n","metadata":{"output":"diff --git a/ledgerly/io/bank_formats.py b/ledgerly/io/bank_formats.py\nindex bc86f7f..