             str(self.amount),\n37:                 self.currency,\n38:                 self.description.strip().lower(),\n39:                 (self.counter_iban or \"\").upper(),\n40:             ]\n41:         )\n42:         return hashlib.sha256(key.encode()).hexdigest()[:16]\n43: \n44:     @property\n45:     def is_income(self) -> bool:\n46:         return self.amount > 0\n47: \n48:     def categorised(self, category: str) -> Transaction:\n49:         return replace(self, category=category)\n50: \n51:     def tagged(self, *tags: str) -> Transaction:\n52:         return replace(self, tags=self.tags | frozenset(tags))\n53: \n54:     def to_dict(self) -> dict[str, object]:\n55:         return {\n56:             \"account\": self.account,\n57:             \"booked\": self.booked.isoformat(),\n58:             \"amount\": None if self.amount is None else str(self.amount),\n59:             \"currency\": self.currency,\n60:             \"description\": self.description,\n61:             \"counterparty\": self.counterparty,\n62:             \"counter_iban\": self.counter_iban,\n63:             \"category\": self.category,\n64:             \"source\": self.source,\n65:             \"tags\": sorted(self.tags),\n66:         }\n67: \n68:     @classmethod\n69:     def from_dict(cls, data: dict[str, object]) -> Transaction:\n70:         raw = data.get(\"amount\")\n71:         return cls(\n72:             account=str(data[\"account\"]),\n73:             booked=date.fromisoformat(str(data[\"booked\"])),\n74:             amount=None if raw is None else Decimal(str(raw)),  # type: ignore[arg-type]\n75:             currency=str(data[\"currency\"]),\n76:             description=str(data.get(\"description\", \"\")),\n77:             counterparty=str(data.get(\"counterparty\", \"\")),\n78:             counter_iban=data.get(\"counter_iban\") or None,  # type: ignore[arg-type]\n79:             category=data.get(\"category\") or None,  # type: ignore[arg-type]\n80:             source=str